+/// Both views use the same validated entries. This function has no source path.
+pub(crate) fn snapshot_from_entries(
+    entries: &[LoadedEntry],
+    shared: &crate::cli::SharedArgs,
+) -> Result<Value> {
+    let mut days = summarize_entries(entries, AgentReportKind::Daily)?;
+    let mut sessions = summarize_entries(entries, AgentReportKind::Session)?;
+    for rows in [&mut days, &mut sessions] {
+        crate::sort_summaries(rows, &shared.order, crate::summary_period);
+    }
+    let mut daily = report_from_rows(&days, AgentReportKind::Daily);
+    for row in daily["daily"].as_array_mut().expect("daily report array") {
+        let object = row.as_object_mut().expect("daily report row");
+        let date = object.remove("date").expect("daily report date");
+        object.insert("agent".into(), json!("pi"));
+        let agent = Value::Object(object.clone());
+        object.insert("agent".into(), json!("all"));
+        object.insert("period".into(), date);
+        object.insert("metadata".into(), json!({"agents":["pi"]}));
+        object.insert("agents".into(), json!([agent]));
+    }
+    Ok(json!({
+        "schemaVersion": 1,
+        "tool": "pi",
+        "daily": daily,
+        "session": report_from_rows(&sessions, AgentReportKind::Session),
+    }))
+}
