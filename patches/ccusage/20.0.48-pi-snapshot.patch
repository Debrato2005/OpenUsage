diff --git a/rust/adapters/pi/src/snapshot_tests.rs b/rust/adapters/pi/src/snapshot_tests.rs
new file mode 100644
index 0000000..e88750f
--- /dev/null
+++ b/rust/adapters/pi/src/snapshot_tests.rs
@@ -0,0 +1,99 @@
+use crate::identity_tests::{event, header, load, write};
+use crate::{cli::SharedArgs, report::snapshot_from_entries};
+use ccusage_test_support::Fixture;
+use serde_json::json;
+
+#[test]
+fn snapshot_keeps_captured_entries_after_append_rewrite_replace_or_delete() {
+    for change in ["append", "rewrite", "replace", "delete"] {
+        let fixture = Fixture::new();
+        let source = write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120)],
+        );
+        let entries = load(&[fixture.path("sessions")]).unwrap();
+        match change {
+            "append" => {
+                write(
+                    &fixture,
+                    "sessions/root.jsonl",
+                    header("root", None),
+                    &[
+                        event("aaaaaaaa", None, 120),
+                        event("bbbbbbbb", Some("aaaaaaaa"), 17),
+                    ],
+                );
+            }
+            "rewrite" => {
+                write(
+                    &fixture,
+                    "sessions/root.jsonl",
+                    header("root", None),
+                    &[event("aaaaaaaa", None, 40)],
+                );
+            }
+            "replace" => {
+                let replacement = write(
+                    &fixture,
+                    "sessions/new.jsonl",
+                    header("new", None),
+                    &[event("cccccccc", None, 120)],
+                );
+                std::fs::rename(replacement, &source).unwrap();
+            }
+            "delete" => std::fs::remove_file(&source).unwrap(),
+            _ => unreachable!(),
+        }
+        let report = snapshot_from_entries(&entries, &SharedArgs::with_defaults()).unwrap();
+        assert_eq!(report["schemaVersion"], 1);
+        assert_eq!(report["tool"], "pi");
+        assert_eq!(report["daily"]["totals"]["totalTokens"], 120);
+        assert_eq!(report["session"]["totals"]["totalTokens"], 120);
+        assert_eq!(report["session"]["sessions"][0]["sessionId"], "root");
+        let next = load(&[fixture.path("sessions")]).unwrap();
+        let next = snapshot_from_entries(&next, &SharedArgs::with_defaults()).unwrap();
+        let expected = match change {
+            "append" => 137,
+            "rewrite" => 40,
+            "replace" => 120,
+            "delete" => 0,
+            _ => unreachable!(),
+        };
+        assert_eq!(next["daily"]["totals"]["totalTokens"], expected);
+        assert_eq!(next["session"]["totals"]["totalTokens"], expected);
+    }
+}
+
+#[test]
+fn snapshot_keeps_missing_categories_out_of_the_independent_total() {
+    let fixture = Fixture::new();
+    let mut row = event("aaaaaaaa", None, 120);
+    row["message"]["usage"] = json!({"totalTokens": 162});
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[row],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    let report = snapshot_from_entries(&entries, &SharedArgs::with_defaults()).unwrap();
+    for kind in ["daily", "session"] {
+        assert_eq!(report[kind]["totals"]["totalTokens"], 162);
+        assert_eq!(report[kind]["totals"]["outputTokens"], 0);
+    }
+    assert_eq!(
+        report["daily"]["daily"][0]["metadata"],
+        json!({"agents":["pi"]})
+    );
+}
+
+#[test]
+fn snapshot_empty_source_has_two_empty_reports() {
+    let report = snapshot_from_entries(&[], &SharedArgs::with_defaults()).unwrap();
+    assert_eq!(report["daily"]["daily"], json!([]));
+    assert_eq!(report["session"]["sessions"], json!([]));
+    assert_eq!(report["daily"]["totals"]["totalTokens"], 0);
+    assert_eq!(report["session"]["totals"]["totalTokens"], 0);
+}
