+#[test]
+fn pi_snapshot_parses_as_one_full_json_report() {
+    let cli = parse(&["ccusage", "pi", "snapshot", "--json", "--offline"]);
+    let Some(Command::Pi(args)) = cli.command else {
+        panic!("Pi snapshot command");
+    };
+    assert_eq!(
+        args.sections,
+        Some(vec![AgentReportKind::Daily, AgentReportKind::Session])
+    );
+    assert!(args.shared.json && args.shared.offline);
+}
+
+#[test]
+fn pi_snapshot_rejects_partial_or_modified_output() {
+    for flags in [
+        vec![],
+        vec!["--json"],
+        vec!["--offline"],
+        vec!["--json", "--offline", "--since", "2026-05-28"],
+        vec!["--json", "--offline", "--until", "2026-05-28"],
+        vec!["--json", "--offline", "--last", "2"],
+        vec!["--json", "--offline", "--jq", ".totals"],
+        vec!["--json", "--offline", "--no-cost"],
+        vec!["--json", "--offline", "--no-offline"],
+    ] {
+        let mut args = vec!["ccusage", "pi", "snapshot"];
+        args.extend(flags);
+        assert!(!parse_error(&args).is_empty());
+    }
+    assert!(
+        parse_error(&["ccusage", "amp", "snapshot", "--json", "--offline"])
+            .contains("not available")
+    );
+    assert!(
+        help_text_for_args(&["pi".into(), "snapshot".into(), "--help".into()])
+            .contains("one captured record set")
+    );
