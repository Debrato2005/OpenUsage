+#[test]
+fn excludes_real_uncommitted_wal_spill() {
+    let (fixture, db) = wal_source(4096);
+    let before = fs::metadata(fixture.path("opencode.db-wal")).unwrap().len();
+    db.execute("BEGIN; UPDATE message SET data='invalid uncommitted JSON'")
+        .unwrap();
+    let mut insert = db
+        .prepare("INSERT INTO message VALUES (?1,'session',?2)")
+        .unwrap();
+    let malformed = "x".repeat(32 << 10);
+    for index in 0..48 {
+        insert
+            .bind((1, format!("pending-{index}").as_str()))
+            .unwrap();
+        insert.bind((2, malformed.as_str())).unwrap();
+        insert.next().unwrap();
+        insert.reset().unwrap();
+    }
+    drop(insert);
+    // SAFETY: this live test connection owns the transaction. The call flushes dirty pages to its private WAL.
+    assert_eq!(
+        unsafe { sqlite3_sys::sqlite3_db_cacheflush(db.as_raw()) },
+        sqlite3_sys::SQLITE_OK
