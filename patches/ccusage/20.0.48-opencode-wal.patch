+    assert!(fs::metadata(fixture.path("opencode.db-wal")).unwrap().len() > before);
+    let entries = load(&[fixture.root().to_owned()]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(
+        crate::total_usage_tokens(entries[0].0.data.message.usage),
+        15
+    );
+    db.execute("ROLLBACK").unwrap();
+}
