+//! Reconstruct committed SQLite pages from immutable captured bytes.
+//!
+//! Format and checksum rules: https://sqlite.org/fileformat.html#walformat
+//! The transient SHM index supplies no database content: https://sqlite.org/walformat.html#recovery
+use crate::{Result, unavailable};
+use std::borrow::Cow;
+
+const MAX_IMAGE_BYTES: usize = 64 << 20;
+const HEADER: usize = 32;
+const FRAME_HEADER: usize = 24;
+
+fn be32(bytes: &[u8]) -> u32 {
+    u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])
+}
+
+fn page_size(main: &[u8]) -> Result<usize> {
+    if main.len() < 100
+        || &main[..16] != b"SQLite format 3\0"
+        || !matches!(&main[18..20], [1, 1] | [2, 2])
+    {
+        return Err(unavailable());
+    }
+    let encoded = u16::from_be_bytes([main[16], main[17]]);
+    let size = if encoded == 1 {
+        65536
+    } else {
+        usize::from(encoded)
+    };
+    if !(512..=65536).contains(&size) || !size.is_power_of_two() {
+        return Err(unavailable());
+    }
+    Ok(size)
+}
+
+fn checksum(bytes: &[u8], big_endian: bool, state: &mut [u32; 2]) {
+    for pair in bytes.as_chunks::<8>().0 {
+        let word = |bytes: &[u8]| {
+            let word = [bytes[0], bytes[1], bytes[2], bytes[3]];
+            if big_endian {
+                u32::from_be_bytes(word)
+            } else {
+                u32::from_le_bytes(word)
+            }
+        };
+        state[0] = state[0].wrapping_add(word(pair)).wrapping_add(state[1]);
+        state[1] = state[1]
+            .wrapping_add(word(&pair[4..]))
+            .wrapping_add(state[0]);
+    }
+}
+
+fn checksum_matches(bytes: &[u8], state: [u32; 2]) -> bool {
+    be32(bytes) == state[0] && be32(&bytes[4..]) == state[1]
+}
+
+fn image_length(pages: u32, size: usize, limit: usize) -> Result<usize> {
+    let length = usize::try_from(pages)
+        .ok()
+        .and_then(|pages| pages.checked_mul(size))
+        .filter(|length| *length <= limit && *length != 0)
+        .ok_or_else(unavailable)?;
+    Ok(length)
+}
+
+pub(crate) fn snapshot<'a>(
+    main: &'a [u8],
+    wal: Option<&[u8]>,
+    limit: u64,
+) -> Result<Cow<'a, [u8]>> {
+    let limit = usize::try_from(limit)
+        .unwrap_or(usize::MAX)
+        .min(MAX_IMAGE_BYTES);
+    let size = page_size(main)?;
+    if main.len() > limit || !main.len().is_multiple_of(size) {
+        return Err(unavailable());
+    }
+    if main[18] == 1 {
+        return if wal.is_some() {
+            Err(unavailable())
+        } else {
+            Ok(Cow::Borrowed(main))
+        };
+    }
+    let wal = wal.unwrap_or_default();
+    let frame_size = size + FRAME_HEADER;
+    let mut committed = 0;
+    let mut length = main.len();
+    if !wal.is_empty() {
+        if wal.len() > limit
+            || wal.len() < HEADER
+            || !(wal.len() - HEADER).is_multiple_of(frame_size)
+            || !matches!(be32(wal), 0x377f0682 | 0x377f0683)
+            || be32(&wal[4..]) != 3_007_000
+            || usize::try_from(be32(&wal[8..])).ok() != Some(size)
+        {
+            return Err(unavailable());
+        }
+        let big_endian = be32(wal) == 0x377f0683;
+        let mut state = [0, 0];
+        checksum(&wal[..24], big_endian, &mut state);
+        if !checksum_matches(&wal[24..32], state) {
+            return Err(unavailable());
+        }
+        // Reject every invalid tail, including old generations. Never guess a torn commit boundary.
+        for (index, frame) in wal[HEADER..].chunks_exact(frame_size).enumerate() {
+            if frame[8..16] != wal[16..24] {
+                return Err(unavailable());
+            }
+            image_length(be32(frame), size, limit)?;
+            checksum(&frame[..8], big_endian, &mut state);
+            checksum(&frame[FRAME_HEADER..], big_endian, &mut state);
+            if !checksum_matches(&frame[16..24], state) {
+                return Err(unavailable());
+            }
+            let pages = be32(&frame[4..]);
+            if pages != 0 {
+                length = image_length(pages, size, limit)?;
+                committed = index + 1;
+            }
+        }
+    }
+
+    // Both allocations follow the image bound. At 512-byte pages, the offset index is at most 512 KiB.
+    let count = length / size;
+    let mut offsets = Vec::new();
+    offsets
+        .try_reserve_exact(count)
+        .map_err(|_| unavailable())?;
+    offsets.resize(count, 0u32);
+    let mut live_pages = count;
+    if committed != 0 {
+        for (index, frame) in wal[HEADER..]
+            .chunks_exact(frame_size)
+            .take(committed)
+            .enumerate()
+            .rev()
+        {
+            let committed_pages = be32(&frame[4..]) as usize;
+            if committed_pages != 0 {
+                live_pages = live_pages.min(committed_pages);
+            }
+            let page = be32(frame) as usize;
+            if page <= live_pages && offsets[page - 1] == 0 {
+                offsets[page - 1] = u32::try_from(HEADER + index * frame_size + FRAME_HEADER)
+                    .map_err(|_| unavailable())?;
+            }
+        }
+    }
+    let mut image = Vec::new();
+    image.try_reserve_exact(length).map_err(|_| unavailable())?;
+    for (index, offset) in offsets.into_iter().enumerate() {
+        // A past truncation removes old pages even when a later transaction grows the database again.
+        let page = match offset {
+            0 if index < live_pages => main.get(index * size..(index + 1) * size),
+            0 => None,
+            offset => wal.get(offset as usize..offset as usize + size),
+        }
+        .ok_or_else(unavailable)?;
+        image.extend_from_slice(page);
+    }
+    if page_size(&image)? != size || image[18..20] != [2, 2] {
+        return Err(unavailable());
+    }
+    // SQLite uses a valid header count instead of the file length. Do not let it hide committed pages.
+    let header_pages = be32(&image[28..]);
+    if header_pages != 0
+        && image[24..28] == image[92..96]
+        && image_length(header_pages, size, limit)? != length
+    {
+        return Err(unavailable());
+    }
+    // Only the private image changes. Its complete committed pages need no journal or shared memory.
+    image[18..20].copy_from_slice(&[1, 1]);
+    Ok(Cow::Owned(image))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checksum_matches_known_words_in_both_orders_and_wraps() {
+        for big_endian in [false, true] {
+            let bytes = (1u32..=6)
+                .flat_map(|word| {
+                    if big_endian {
+                        word.to_be_bytes()
+                    } else {
+                        word.to_le_bytes()
+                    }
+                })
+                .collect::<Vec<_>>();
+            let mut state = [0, 0];
+            checksum(&bytes, big_endian, &mut state);
+            assert_eq!(state, [26, 46]);
+            let mut state = [0, 0];
+            checksum(&[255; 8], big_endian, &mut state);
+            assert_eq!(state, [u32::MAX, u32::MAX - 1]);
+        }
+    }
+
+    fn source() -> (
+        ccusage_test_support::Fixture,
+        sqlite::Connection,
+        Vec<u8>,
+        Vec<u8>,
+    ) {
+        let fixture = ccusage_test_support::Fixture::new();
+        let db = sqlite::open(fixture.path("source.db")).unwrap();
+        db.execute(
+            "PRAGMA journal_mode=WAL; CREATE TABLE observation(value INTEGER); \
+            INSERT INTO observation VALUES (7)",
+        )
+        .unwrap();
+        let main = std::fs::read(fixture.path("source.db")).unwrap();
+        let wal = std::fs::read(fixture.path("source.db-wal")).unwrap();
+        (fixture, db, main, wal)
+    }
+
+    fn resign(wal: &mut [u8], big_endian: bool) {
+        let magic: u32 = if big_endian { 0x377f0683 } else { 0x377f0682 };
+        wal[..4].copy_from_slice(&magic.to_be_bytes());
+        let mut state = [0, 0];
+        checksum(&wal[..24], big_endian, &mut state);
+        wal[24..28].copy_from_slice(&state[0].to_be_bytes());
+        wal[28..32].copy_from_slice(&state[1].to_be_bytes());
+        let size = be32(&wal[8..]) as usize;
+        for frame in wal[HEADER..].chunks_exact_mut(size + FRAME_HEADER) {
+            checksum(&frame[..8], big_endian, &mut state);
+            checksum(&frame[FRAME_HEADER..], big_endian, &mut state);
+            frame[16..20].copy_from_slice(&state[0].to_be_bytes());
+            frame[20..24].copy_from_slice(&state[1].to_be_bytes());
+        }
+    }
+
+    #[test]
+    fn accepts_big_endian_wal_checksums() {
+        let (_fixture, _db, main, mut wal) = source();
+        resign(&mut wal, true);
+        let image = snapshot(&main, Some(&wal), MAX_IMAGE_BYTES as u64).unwrap();
+        crate::sqlite_snapshot::with_connection(&image, |db| {
+            let mut query = db.prepare("SELECT value FROM observation").unwrap();
+            assert_eq!(query.next().unwrap(), sqlite::State::Row);
+            assert_eq!(query.read::<i64, _>(0).unwrap(), 7);
+            Ok(())
+        })
+        .unwrap();
+    }
+
+    #[test]
+    fn refuses_valid_checksums_with_invalid_page_numbers_sizes_or_missing_pages() {
+        let (_fixture, _db, main, wal) = source();
+        let size = page_size(&main).unwrap();
+        let last = wal.len() - (size + FRAME_HEADER);
+        for (offset, value) in [
+            (HEADER, 0),
+            (HEADER, u32::MAX),
+            (last + 4, u32::MAX),
+            (last + 4, be32(&wal[last + 4..]) + 1),
+        ] {
+            let mut bad = wal.clone();
+            bad[offset..offset + 4].copy_from_slice(&value.to_be_bytes());
+            resign(&mut bad, false);
+            assert!(snapshot(&main, Some(&bad), MAX_IMAGE_BYTES as u64).is_err());
+        }
+        assert!(snapshot(&main, Some(&wal), (size - 1) as u64).is_err());
+    }
+}
