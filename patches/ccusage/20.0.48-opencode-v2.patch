+fn valid_id(value: &str, prefix: &str) -> bool {
+    value.len() > prefix.len()
+        && value.len() <= 4096
+        && value.starts_with(prefix)
+        && !value.chars().any(char::is_whitespace)
+}
+
+fn validate_v2(value: &Value, role: &str) -> Result<()> {
+    let fields: &[&str] = match role {
+        "assistant" => &[
+            "agent", "model", "content", "snapshot", "finish", "cost", "tokens", "error",
+        ],
+        "user" => &["text", "files", "agents"],
+        "system" => &["text"],
+        _ => return Err(unavailable()),
+    };
+    let object = value.as_object().ok_or_else(unavailable)?;
+    if object.keys().any(|key| {
+        !["id", "sessionID", "type", "role", "time", "metadata"].contains(&key.as_str())
+            && !fields.contains(&key.as_str())
+    }) {
+        return Err(unavailable());
+    }
+    if let Some(metadata) = object.get("metadata") {
+        metadata.as_object().ok_or_else(unavailable)?;
+    }
+    let time = value["time"].as_object().ok_or_else(unavailable)?;
+    if time
+        .keys()
+        .any(|key| key != "created" && !(role == "assistant" && key == "completed"))
+    {
+        return Err(unavailable());
+    }
+    if let Some(completed) = time.get("completed") {
+        completed
+            .as_i64()
+            .filter(|end| *end >= time["created"].as_i64().unwrap_or(i64::MAX))
+            .ok_or_else(unavailable)?;
+    }
+    if role != "assistant" {
+        value["text"].as_str().ok_or_else(unavailable)?;
+        return Ok(());
+    }
+    value["agent"].as_str().ok_or_else(unavailable)?;
+    value["content"].as_array().ok_or_else(unavailable)?;
+    if let Some(finish) = object.get("finish") {
+        finish.as_str().ok_or_else(unavailable)?;
+    }
+    let model = value["model"].as_object().ok_or_else(unavailable)?;
+    if model
+        .keys()
+        .any(|key| !["id", "providerID", "variant"].contains(&key.as_str()))
+    {
+        return Err(unavailable());
+    }
+    identifier(model.get("id"))?;
+    identifier(model.get("providerID"))?;
+    if let Some(variant) = model.get("variant") {
+        variant.as_str().ok_or_else(unavailable)?;
+    }
+    let tokens = value["tokens"].as_object().ok_or_else(unavailable)?;
+    if tokens.len() != 4 {
+        return Err(unavailable());
+    }
+    for field in ["input", "output", "reasoning"] {
+        tokens
+            .get(field)
+            .and_then(Value::as_u64)
+            .ok_or_else(unavailable)?;
+    }
+    let cache = tokens
+        .get("cache")
+        .and_then(Value::as_object)
+        .ok_or_else(unavailable)?;
+    if cache.len() != 2 {
+        return Err(unavailable());
+    }
+    for field in ["read", "write"] {
+        cache
+            .get(field)
+            .and_then(Value::as_u64)
+            .ok_or_else(unavailable)?;
     }
     Ok(())
