-        parent_id: &str,
-        fork_id: &str,
-        boundary_type: &str,
-        boundary_message_id: &str,
-    ) {
-        // Parent history: two assistant turns, then the boundary assistant
-        // turn, then a later assistant turn the fork never copies.
-        for (id, seq, input) in [
-            ("parent-msg-1", 0, 100),
-            ("parent-msg-2", 1, 200),
-            (boundary_message_id, 2, 300),
-            ("parent-msg-4", 3, 400),
-        ] {
-            insert_db_session_message(
-                db_path,
-                id,
-                parent_id,
-                "assistant",
