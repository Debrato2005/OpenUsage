+++ b/rust/adapters/opencode/src/v2_tests.rs
@@ -0,0 +1,280 @@
+#![cfg(target_os = "linux")]
+use crate::{
+    cli::{AgentReportKind, CostMode, SharedArgs},
+    loader::load_paths,
+};
+use ccusage_test_support::Fixture;
+use serde_json::{Value, json};
+use std::path::PathBuf;
+
+pub(crate) const TIME: i64 = 1767312000000;
+
+pub(crate) fn initialize(db: &sqlite::Connection) {
+    for (_, ddl, _) in crate::v2_schema::TABLES {
+        db.execute(*ddl).unwrap();
+    }
+    db.execute("INSERT INTO session(id,project_id,slug,directory,title,version,time_created,time_updated) VALUES('ses_record','project','slug','/synthetic','Synthetic','1.19.5',1767312000000,1767312000000)").unwrap();
+}
+
+pub(crate) fn insert(db: &sqlite::Connection, id: &str, kind: &str, seq: i64, data: &Value) {
+    let mut statement = db.prepare("INSERT INTO session_message(id,session_id,type,seq,time_created,time_updated,data) VALUES(?1,'ses_record',?2,?3,1767312000000,1767312000000,?4)").unwrap();
+    statement.bind((1, id)).unwrap();
+    statement.bind((2, kind)).unwrap();
+    statement.bind((3, seq)).unwrap();
+    statement.bind((4, data.to_string().as_str())).unwrap();
+    statement.next().unwrap();
+}
+
+pub(crate) fn payload(input: u64) -> Value {
+    json!({"agent":"build","model":{"id":"model","providerID":"provider"},"content":[],"finish":"stop","cost":0,
+        "time":{"created":TIME,"completed":TIME+1},"tokens":{"input":input,"output":5,"reasoning":0,"cache":{"read":0,"write":0}}})
+}
+
+fn fixture() -> Fixture {
+    let result = Fixture::new();
+    let db = sqlite::open(result.path("opencode.db")).unwrap();
+    initialize(&db);
+    insert(&db, "msg_record", "assistant", 1, &payload(10));
+    result
+}
+
+fn load(paths: &[PathBuf], kind: AgentReportKind) -> crate::Result<Vec<crate::LinkedEntry>> {
+    load_paths(
+        paths,
+        &SharedArgs {
+            mode: CostMode::Display,
+            offline: true,
+            ..SharedArgs::default()
+        },
+        kind,
+    )
+}
+
+#[test]
+fn accepts_only_complete_v2_usage_and_copies_in_both_reports() {
+    let first = fixture();
+    let second = fixture();
+    for kind in [AgentReportKind::Daily, AgentReportKind::Session] {
+        let rows = load(&[first.root().to_owned(), second.root().to_owned()], kind).unwrap();
+        assert_eq!(rows.len(), 1);
+        assert_eq!(crate::total_usage_tokens(rows[0].0.data.message.usage), 15);
+    }
+}
+
+#[test]
+fn distinct_ids_with_equal_usage_remain_distinct() {
+    let first = fixture();
+    let db = sqlite::open(first.path("opencode.db")).unwrap();
+    insert(&db, "msg_second", "assistant", 2, &payload(10));
+    let rows = load(&[first.root().to_owned()], AgentReportKind::Daily).unwrap();
+    assert_eq!(rows.len(), 2);
+}
+
+#[test]
+fn rejects_every_unsupported_peer_before_any_report_in_either_order() {
+    for mutation in [
+        "INSERT INTO message(id,session_id,time_created,time_updated,data) VALUES('msg_legacy','ses_record',0,0,'{}')",
+        "INSERT INTO part(id,message_id,session_id,time_created,time_updated,data) VALUES('prt_legacy','msg_absent','ses_record',0,0,'{}')",
+        "UPDATE session SET tokens_input=1",
+        "UPDATE session SET tokens_output=-1",
+        "UPDATE session SET tokens_reasoning=1.5",
+        "UPDATE session SET tokens_cache_read='invalid'",
+        "UPDATE session SET tokens_cache_write=1",
+        "UPDATE session SET cost=0.1",
+        "ALTER TABLE session ADD fork_session_id TEXT",
+        "ALTER TABLE session_message ADD original_id TEXT",
+        "CREATE TABLE session_v2(id TEXT)",
+        "DROP TABLE message",
+        "DROP TABLE part",
+        "UPDATE session_message SET session_id='ses_absent'",
+        "UPDATE session_message SET id=''",
+        "UPDATE session_message SET id='legacy_id'",
+        "UPDATE session_message SET seq=-1",
+        "UPDATE session_message SET seq=1.5",
+        "UPDATE session_message SET time_created=1767312000001",
+        "UPDATE session SET id='ses_other'",
+    ] {
+        let good = fixture();
+        let bad = fixture();
+        sqlite::open(bad.path("opencode.db"))
+            .unwrap()
+            .execute(mutation)
+            .unwrap();
+        for paths in [
+            vec![bad.root().to_owned()],
+            vec![good.root().to_owned(), bad.root().to_owned()],
+            vec![bad.root().to_owned(), good.root().to_owned()],
+        ] {
+            for kind in [AgentReportKind::Daily, AgentReportKind::Session] {
+                assert_eq!(
+                    load(&paths, kind).unwrap_err().to_string(),
+                    "OpenCode source capture is unavailable",
+                    "{mutation}"
+                );
+            }
+        }
+    }
+    for value in ["{}", "", "{\"tokens\":{\"total\":0}}"] {
+        let good = fixture();
+        let bad = Fixture::new();
+        let _ = bad.write_file("storage/message/legacy.json", value);
+        for paths in [
+            [good.root().to_owned(), bad.root().to_owned()],
+            [bad.root().to_owned(), good.root().to_owned()],
+        ] {
+            assert!(load(&paths, AgentReportKind::Session).is_err());
+        }
+    }
+}
+
+#[test]
+fn rejects_duplicate_positions_and_conflicting_ids_across_roots() {
+    for mutation in [
+        "UPDATE session_message SET seq=2",
+        "UPDATE session_message SET id='msg_other'",
+    ] {
+        let a = fixture();
+        let b = fixture();
+        sqlite::open(b.path("opencode.db"))
+            .unwrap()
+            .execute(mutation)
+            .unwrap();
+        for paths in [
+            [a.root().to_owned(), b.root().to_owned()],
+            [b.root().to_owned(), a.root().to_owned()],
+        ] {
+            assert!(load(&paths, AgentReportKind::Session).is_err());
+        }
+    }
+    let one = fixture();
+    insert(
+        &sqlite::open(one.path("opencode.db")).unwrap(),
+        "msg_other",
+        "assistant",
+        1,
+        &payload(10),
+    );
+    assert!(load(&[one.root().to_owned()], AgentReportKind::Session).is_err());
+}
+
+#[test]
+fn refuses_ddl_with_same_names_but_different_column_metadata() {
+    for (from, to) in [
+        ("`seq` integer NOT NULL", "`seq` text NOT NULL"),
+        ("`seq` integer NOT NULL,", ""),
+        ("`id` text PRIMARY KEY", "`id` text"),
+        ("`data` text NOT NULL", "`data` text"),
+    ] {
+        let fixture = Fixture::new();
+        let db = sqlite::open(fixture.path("opencode.db")).unwrap();
+        for (name, ddl, _) in crate::v2_schema::TABLES {
+            db.execute(if *name == "session_message" {
+                ddl.replace(from, to)
+            } else {
+                ddl.to_string()
+            })
+            .unwrap();
+        }
+        assert!(load(&[fixture.root().to_owned()], AgentReportKind::Daily).is_err());
+    }
+}
+
+#[test]
+fn ignores_no_usage_and_preserves_explicit_zero() {
+    let empty = Fixture::new();
+    let db = sqlite::open(empty.path("opencode.db")).unwrap();
+    initialize(&db);
+    assert!(
+        load(&[empty.root().to_owned()], AgentReportKind::Session)
+            .unwrap()
+            .is_empty()
+    );
+    let mut zero = payload(0);
+    zero["tokens"]["output"] = 0.into();
+    insert(&db, "msg_zero", "assistant", 1, &zero);
+    assert_eq!(
+        load(&[empty.root().to_owned()], AgentReportKind::Session)
+            .unwrap()
+            .len(),
+        1
+    );
+}
+
+#[test]
+fn checks_overflow_after_deduplication() {
+    let a = fixture();
+    let db = sqlite::open(a.path("opencode.db")).unwrap();
+    let mut large = payload(u64::MAX);
+    large["tokens"]["output"] = 0.into();
+    db.execute("DELETE FROM session_message").unwrap();
+    insert(&db, "msg_max", "assistant", 1, &large);
+    assert_eq!(
+        load(
+            &[a.root().to_owned(), a.root().to_owned()],
+            AgentReportKind::Session
+        )
+        .unwrap()
+        .len(),
+        1
+    );
+    insert(&db, "msg_extra", "assistant", 2, &payload(1));
+    assert!(load(&[a.root().to_owned()], AgentReportKind::Session).is_err());
+}
+
+#[test]
+fn validates_before_date_filtering() {
+    let one = fixture();
+    sqlite::open(one.path("opencode.db"))
+        .unwrap()
+        .execute("UPDATE session SET tokens_input=1")
+        .unwrap();
+    assert!(
+        load_paths(
+            &[one.root().to_owned()],
+            &SharedArgs {
+                mode: CostMode::Display,
+                offline: true,
+                since: Some("2030-01-01".into()),
+                ..SharedArgs::default()
+            },
+            AgentReportKind::Daily
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn rejects_legacy_payloads_even_inside_current_v2_tables() {
+    for field in ["input", "output", "reasoning"] {
+        let mut value = payload(10);
+        value["tokens"].as_object_mut().unwrap().remove(field);
+        value["tokens"]["total"] = 15.into();
+        let one = fixture();
+        let db = sqlite::open(one.path("opencode.db")).unwrap();
+        db.execute("DELETE FROM session_message").unwrap();
+        insert(&db, "msg_record", "assistant", 1, &value);
+        assert!(load(&[one.root().to_owned()], AgentReportKind::Daily).is_err());
+    }
+    for field in [
+        "modelID",
+        "providerID",
+        "parentID",
+        "path",
+        "mode",
+        "role",
+        "id",
+        "sessionID",
+        "type",
+    ] {
+        let mut value = payload(10);
+        value[field] = "assistant".into();
+        let one = fixture();
+        let db = sqlite::open(one.path("opencode.db")).unwrap();
+        db.execute("DELETE FROM session_message").unwrap();
+        insert(&db, "msg_record", "assistant", 1, &value);
+        assert!(
+            load(&[one.root().to_owned()], AgentReportKind::Daily).is_err(),
+            "{field}"
+        );
+    }
+}
