+#[test]
+fn refuses_metadata_with_missing_or_malformed_required_fields() {
+    use serde_json::json;
+    for (kind, value) in metadata_messages() {
+        for field in value.as_object().unwrap().keys() {
+            for replacement in [None, Some(json!(null)), Some(json!(false)), Some(json!([]))] {
+                let mut invalid = value.clone();
+                if let Some(replacement) = replacement {
+                    invalid[field] = replacement;
+                } else {
+                    invalid.as_object_mut().unwrap().remove(field);
+                }
+                let fixture = v2_record(kind, &invalid);
+                assert!(
+                    load(&[fixture.root().to_owned()]).is_err(),
+                    "{kind}: {field}"
+                );
+            }
+        }
+        for (field, malformed) in [
+            ("metadata", json!([])),
+            ("time", json!({})),
+            ("time", json!({"created": "1767312000000"})),
+            ("time", json!({"created": -1})),
+            ("time", json!({"created": 1767312000001i64})),
+            ("unknown", json!(null)),
+        ] {
+            let mut invalid = value.clone();
+            invalid[field] = malformed;
+            let fixture = v2_record(kind, &invalid);
+            assert!(
+                load(&[fixture.root().to_owned()]).is_err(),
+                "{kind}: {field}"
+            );
+        }
+    }
+    for model in [
+        json!({}),
+        json!({"id": "model"}),
+        json!({"providerID": "provider"}),
+        json!({"id": "model", "providerID": false}),
+        json!({"id": "model", "providerID": "provider", "variant": false}),
+    ] {
+        let fixture = v2_record(
