+fn has_usage_fields(value: &Value, allow_metadata: bool) -> bool {
+    match value {
+        Value::Object(object) => object.iter().any(|(key, value)| {
+            !(allow_metadata && key == "metadata" && value.is_object())
+                && (matches!(
+                    key.as_str(),
+                    "tokens"
+                        | "usage"
+                        | "tokenUsage"
+                        | "token_usage"
+                        | "totalTokens"
+                        | "inputTokens"
+                        | "outputTokens"
+                        | "reasoningTokens"
+                        | "cacheReadTokens"
+                        | "cacheCreationTokens"
+                ) || has_usage_fields(value, false))
+        }),
+        Value::Array(values) => values.iter().any(|value| has_usage_fields(value, false)),
+        _ => false,
+    }
+}
+
+pub(crate) fn validate_metadata(value: &Value) -> Result<bool> {
+    let object = value.as_object().ok_or_else(unavailable)?;
+    let Some(kind) = object
+        .get("role")
+        .or_else(|| object.get("type"))
+        .and_then(Value::as_str)
+    else {
+        return Ok(false);
+    };
+    let fields: &[&str] = match kind {
+        "agent-switched" => &["agent"],
+        "model-switched" => &["model"],
+        "synthetic" => &["text"],
+        "shell" => &["callID", "command", "output"],
+        "compaction" => &["reason", "summary", "recent"],
+        _ => return Ok(false),
+    };
+    if has_usage_fields(value, true)
+        || object.keys().any(|key| {
+            !["id", "sessionID", "role", "type", "time", "metadata"].contains(&key.as_str())
+                && !fields.contains(&key.as_str())
+        })
+        || object
+            .get("type")
+            .is_some_and(|value| value.as_str() != Some(kind))
+        || !identifier(object.get("id"))?.starts_with("msg_")
+        || !identifier(object.get("sessionID"))?.starts_with("ses")
+    {
+        return Err(unavailable());
+    }
+    if let Some(metadata) = object.get("metadata") {
+        metadata.as_object().ok_or_else(unavailable)?;
+    }
+    let time = object
+        .get("time")
+        .and_then(Value::as_object)
+        .ok_or_else(unavailable)?;
+    if time
+        .keys()
+        .any(|key| key != "created" && !(kind == "shell" && key == "completed"))
+    {
+        return Err(unavailable());
+    }
+    let created = time
+        .get("created")
+        .and_then(Value::as_i64)
+        .filter(|time| *time >= 0)
+        .ok_or_else(unavailable)?;
+    if let Some(completed) = time.get("completed") {
+        completed
+            .as_i64()
+            .filter(|time| *time >= created)
+            .ok_or_else(unavailable)?;
+    }
+    for field in fields {
+        if *field == "model" {
+            let model = object
+                .get(*field)
+                .and_then(Value::as_object)
+                .ok_or_else(unavailable)?;
+            if model
+                .keys()
+                .any(|key| !["id", "providerID", "variant"].contains(&key.as_str()))
+            {
+                return Err(unavailable());
+            }
+            identifier(model.get("id"))?;
+            identifier(model.get("providerID"))?;
+            if let Some(variant) = model.get("variant") {
+                variant.as_str().ok_or_else(unavailable)?;
+            }
+        } else {
+            object
+                .get(*field)
+                .and_then(Value::as_str)
+                .ok_or_else(unavailable)?;
+        }
+    }
+    if kind == "compaction" && !matches!(object["reason"].as_str(), Some("auto" | "manual")) {
+        return Err(unavailable());
+    }
+    Ok(true)
+}
