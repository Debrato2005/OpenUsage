+use super::*;
+use ccusage_test_support::{EnvVarsGuard, Fixture};
+use serde_json::{Value, json};
+
+fn event(id: &str) -> Value {
+    json!({"id":id,"timestamp":"2026-01-02T03:04:05.000Z",
+        "model":"claude-sonnet-4-20250514", "tokens":{"input":120,"output":30,"total":162},
+        "toMessageId":1,"credits":1.25})
+}
+
+fn ledger(id: &str, events: Vec<Value>) -> Value {
+    json!({"id":id,"usageLedger":{"events":events}, "messages":[{
+        "role":"assistant", "messageId":1,
+        "usage":{"cacheCreationInputTokens":5,"cacheReadInputTokens":7}
+    }]})
+}
+
+fn scan(snapshots: &[Value], single_thread: bool) -> Result<Vec<LoadedEntry>> {
+    scan_roots(snapshots, single_thread, false)
+}
+
+fn scan_roots(
+    snapshots: &[Value],
+    single_thread: bool,
+    separate_roots: bool,
+) -> Result<Vec<LoadedEntry>> {
+    let texts = snapshots.iter().map(Value::to_string).collect::<Vec<_>>();
+    scan_texts(&texts, single_thread, separate_roots)
+}
+
+fn scan_texts(
+    texts: &[String],
+    single_thread: bool,
+    separate_roots: bool,
+) -> Result<Vec<LoadedEntry>> {
+    let fixture = Fixture::new();
+    let mut roots = std::collections::BTreeSet::new();
+    let mut sources = Vec::new();
+    let home = fixture.create_dir_all("home");
+    for (index, text) in texts.iter().enumerate() {
+        let root = if separate_roots { index } else { 0 };
+        let source = fixture.create_dir_all(format!("source-{root}"));
+        roots.insert(source.display().to_string());
+        let file = fixture.write_file(format!("source-{root}/threads/{index}.json"), text);
+        sources.push((file, text.clone()));
+    }
+    let _env = EnvVarsGuard::set_many([
+        (
+            "AMP_DATA_DIR",
+            Some(roots.into_iter().collect::<Vec<_>>().join(",").into()),
+        ),
+        ("HOME", Some(home.into_os_string())),
+    ]);
+    let result = load_entries(
+        &SharedArgs {
+            json: true,
+            single_thread,
+            offline: true,
+            timezone: Some("UTC".into()),
+            mode: crate::cli::CostMode::Calculate,
+            ..SharedArgs::default()
+        },
+        &PricingMap::default(),
+    );
+    for (path, expected) in sources {
+        assert_eq!(std::fs::read_to_string(path).unwrap(), expected);
+    }
+    assert_eq!(std::fs::read_dir(fixture.path("home")).unwrap().count(), 0);
+    result
+}
+
+fn total(entries: &[LoadedEntry]) -> u64 {
+    entries
+        .iter()
+        .map(|entry| {
+            let usage = entry.data.message.usage;
+            usage.input_tokens
+                + usage.output_tokens
+                + usage.cache_creation_input_tokens
+                + usage.cache_read_input_tokens
+                + entry.extra_total_tokens
+        })
+        .sum()
+}
+
