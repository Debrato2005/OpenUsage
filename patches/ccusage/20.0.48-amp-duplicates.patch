diff --git a/rust/adapters/amp/src/parser/dedup.rs b/rust/adapters/amp/src/parser/dedup.rs
new file mode 100644
index 0000000..527b9f3
--- /dev/null
+++ b/rust/adapters/amp/src/parser/dedup.rs
@@ -0,0 +1,203 @@
+use std::collections::{BTreeMap, BTreeSet, btree_map::Entry};
+
+use super::{AmpLedgerEvent, AmpMessage, AmpThread, AmpUsageLedger, Value};
+use crate::{Result, cli_error, non_empty_json_string};
+
+#[derive(Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum SourceId {
+    Number(i64),
+    Text(String),
+}
+
+fn message_id(value: Option<&Value>) -> Option<SourceId> {
+    let value = value?;
+    value.as_i64().map(SourceId::Number).or_else(|| {
+        value
+            .as_str()
+            .filter(|text| !text.is_empty())
+            .map(|text| SourceId::Text(text.into()))
+    })
+}
+
+#[derive(Default)]
+struct Records<T> {
+    known: BTreeMap<SourceId, T>,
+    anonymous: Vec<T>,
+}
+
+impl<T> Records<T> {
+    fn insert(
+        &mut self,
+        id: Option<SourceId>,
+        value: T,
+        equal: impl FnOnce(&T, &T) -> bool,
+    ) -> Result<()> {
+        let Some(id) = id else {
+            self.anonymous.push(value);
+            return Ok(());
+        };
+        match self.known.entry(id) {
+            Entry::Vacant(entry) => {
+                entry.insert(value);
+            }
+            Entry::Occupied(entry) if !equal(entry.get(), &value) => {
+                return Err(cli_error("conflicting Amp usage for one source identity"));
+            }
+            Entry::Occupied(_) => {}
+        }
+        Ok(())
+    }
+
+    fn finish(self) -> Vec<T> {
+        self.known.into_values().chain(self.anonymous).collect()
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Ledger,
+    Messages,
+}
+
+#[derive(PartialEq)]
+struct CacheAttachment {
+    write: Option<Value>,
+    read: Option<Value>,
+}
+
+struct Group {
+    kind: Kind,
+    seen: bool,
+    cache_joins: BTreeMap<i64, Option<CacheAttachment>>,
+    events: Records<AmpLedgerEvent>,
+    messages: Records<AmpMessage>,
+}
+
+fn cache(message: &AmpMessage) -> (Option<&Value>, Option<&Value>) {
+    let usage = message.usage.as_ref();
+    (
+        usage.and_then(|value| value.get("cacheCreationInputTokens")),
+        usage.and_then(|value| value.get("cacheReadInputTokens")),
+    )
+}
+
+impl Group {
+    fn insert(&mut self, thread: AmpThread) -> Result<()> {
+        let events = thread.usage_ledger.and_then(|ledger| ledger.events);
+        let kind = if events.is_some() {
+            Kind::Ledger
+        } else {
+            Kind::Messages
+        };
+        if self.kind != kind {
+            return Err(cli_error("Amp thread mixes ledger and message snapshots"));
+        }
+        match kind {
+            Kind::Ledger => {
+                let mut local_cache = Records::<AmpMessage>::default();
+                for message in thread.messages {
+                    if message.role.as_ref().and_then(Value::as_str) == Some("assistant")
+                        && let Some(id) = message.message_id.as_ref().and_then(Value::as_i64)
+                    {
+                        local_cache.insert(Some(SourceId::Number(id)), message, |a, b| {
+                            cache(a) == cache(b)
+                        })?;
+                    }
+                }
+                let mut referenced = BTreeSet::new();
+                for event in events.into_iter().flatten() {
+                    if let Some(id) = event.to_message_id.as_ref().and_then(Value::as_i64) {
+                        let attached =
+                            local_cache.known.get(&SourceId::Number(id)).map(|message| {
+                                let (write, read) = cache(message);
+                                CacheAttachment {
+                                    write: write.cloned(),
+                                    read: read.cloned(),
+                                }
+                            });
+                        match self.cache_joins.entry(id) {
+                            Entry::Vacant(entry) => {
+                                entry.insert(attached);
+                            }
+                            Entry::Occupied(entry) if entry.get() != &attached => {
+                                return Err(cli_error(
+                                    "conflicting Amp cache attachment across snapshots",
+                                ));
+                            }
+                            Entry::Occupied(_) => {}
+                        }
+                        referenced.insert(id);
+                    }
+                    let id = non_empty_json_string(event.id.as_ref()).map(SourceId::Text);
+                    self.events.insert(id, event, PartialEq::eq)?;
+                }
+                for id in referenced {
+                    if let Some(message) = local_cache.known.remove(&SourceId::Number(id)) {
+                        self.messages
+                            .insert(Some(SourceId::Number(id)), message, |a, b| {
+                                cache(a) == cache(b)
+                            })?;
+                    }
+                }
+            }
+            Kind::Messages => {
+                for message in thread.messages {
+                    if message.role.as_ref().and_then(Value::as_str) == Some("assistant")
+                        && message.usage.is_some()
+                    {
+                        self.messages.insert(
+                            message_id(message.message_id.as_ref()),
+                            message,
+                            PartialEq::eq,
+                        )?;
+                    }
+                }
+            }
+        }
+        // A typed ID proves a merge. Counters, time, and file order do not.
+        if self.seen && (!self.events.anonymous.is_empty() || !self.messages.anonymous.is_empty()) {
+            return Err(cli_error(
+                "Amp snapshots without stable usage IDs cannot be merged",
+            ));
+        }
+        self.seen = true;
+        Ok(())
+    }
+}
+
+pub(super) fn merge(snapshots: Vec<AmpThread>) -> Result<Vec<AmpThread>> {
+    let mut groups = BTreeMap::new();
+    for thread in snapshots {
+        let Some(id) = thread.id.as_ref() else {
+            continue;
+        };
+        let kind = if thread
+            .usage_ledger
+            .as_ref()
+            .and_then(|ledger| ledger.events.as_ref())
+            .is_some()
+        {
+            Kind::Ledger
+        } else {
+            Kind::Messages
+        };
+        let group = groups.entry(id.clone()).or_insert_with(|| Group {
+            kind,
+            seen: false,
+            cache_joins: BTreeMap::new(),
+            events: Records::default(),
+            messages: Records::default(),
+        });
+        group.insert(thread)?;
+    }
+    Ok(groups
+        .into_iter()
+        .map(|(id, group)| AmpThread {
+            id: Some(id),
+            messages: group.messages.finish(),
+            usage_ledger: (group.kind == Kind::Ledger).then(|| AmpUsageLedger {
+                events: Some(group.events.finish()),
+            }),
+        })
+        .collect())
+}
