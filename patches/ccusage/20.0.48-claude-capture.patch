 use ccusage_core::fast::{LinePrefilter, byte_lines};
+
+/// Reject invalid JSONL while preserving the adapter's typed schema rules.
+/// Blank lines carry no record. Ignored values need no numeric conversion.
+pub fn validate_record(line: &[u8]) -> ccusage_core::Result<()> {
+    if line.iter().all(u8::is_ascii_whitespace) {
+        return Ok(());
+    }
+    let text = std::str::from_utf8(line)
+        .map_err(|_| ccusage_core::cli_error("Incomplete scan: invalid JSONL record"))?;
+    serde_json::from_str::<IgnoredAny>(text)
+        .map_err(|_| ccusage_core::cli_error("Incomplete scan: invalid JSONL record"))?;
+    Ok(())
+}
 
