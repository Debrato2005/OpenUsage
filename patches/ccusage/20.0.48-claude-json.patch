diff --git a/rust/adapters/claude/src/json_tests.rs b/rust/adapters/claude/src/json_tests.rs
new file mode 100644
--- /dev/null
+++ b/rust/adapters/claude/src/json_tests.rs
@@ -0,0 +1,208 @@
+use ccusage_test_support::{EnvVarGuard, Fixture};
+
+use crate::{
+    cli::{CostMode, SharedArgs},
+    load_daily_summaries, load_entries,
+};
+
+const FIRST: &str = r#"{"timestamp":"2026-01-02T10:00:00.000Z","sessionId":"session-a","requestId":"request-a","message":{"id":"message-a","model":"claude-sonnet-4-20250514","usage":{"input_tokens":11,"output_tokens":3,"cache_creation_input_tokens":7,"cache_read_input_tokens":13}}}"#;
+const SECOND: &str = r#"{"timestamp":"2026-01-02T10:00:00.000Z","sessionId":"session-a","requestId":"request-b","message":{"id":"message-b","model":"claude-sonnet-4-20250514","usage":{"input_tokens":17,"output_tokens":5,"cache_creation_input_tokens":11,"cache_read_input_tokens":19}}}"#;
+
+fn report_args() -> SharedArgs {
+    SharedArgs {
+        json: true,
+        offline: true,
+        mode: CostMode::Display,
+        timezone: Some("UTC".to_string()),
+        single_thread: true,
+        ..SharedArgs::default()
+    }
+}
+
+fn assert_independent_counts() {
+    let shared = report_args();
+    let entries = load_entries(&shared, None).unwrap();
+    let mut counts = entries
+        .iter()
+        .map(|entry| {
+            let usage = entry.data.message.usage;
+            (
+                usage.input_tokens,
+                usage.output_tokens,
+                usage.cache_creation_token_count(),
+                usage.cache_read_input_tokens,
+            )
+        })
+        .collect::<Vec<_>>();
+    counts.sort_unstable();
+    assert_eq!(counts, [(11, 3, 7, 13), (17, 5, 11, 19)]);
+
+    let daily = load_daily_summaries(&shared, None, false).unwrap();
+    assert_eq!(daily.len(), 1);
+    assert_eq!(daily[0].date.as_deref(), Some("2026-01-02"));
+    assert_eq!(daily[0].input_tokens, 28);
+    assert_eq!(daily[0].output_tokens, 8);
+    assert_eq!(daily[0].cache_creation_tokens, 18);
+    assert_eq!(daily[0].cache_read_tokens, 32);
+    assert_eq!(daily[0].total_tokens(), 86);
+}
+
+#[test]
+fn json_whitespace_preserves_counts_and_copies() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    for separator in [":", ": ", " : ", "\t:\t", "\r:\r"] {
+        let first = FIRST.replace("\":", &format!("\"{separator}"));
+        let second = SECOND.replace("\":", &format!("\"{separator}"));
+        let _path = fixture.write_file(
+            "projects/project-a/session-a.jsonl",
+            format!(" {first}\r\n\t{second}\r\n{first}\r\n"),
+        );
+        assert_independent_counts();
+        assert_independent_counts();
+    }
+}
+
+#[test]
+fn json_ignored_metadata_preserves_session_counts_and_daily_scope() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let deep_metadata = format!("{}0{}", "[".repeat(140), "]".repeat(140));
+    let shared = report_args();
+    let mut observations = Vec::new();
+    for metadata in ["1e400", deep_metadata.as_str()] {
+        let record = format!(
+            "{},\"unrelated\":{metadata}}}",
+            FIRST.strip_suffix('}').unwrap()
+        );
+        let _path = fixture.write_file("projects/project-a/session-a.jsonl", &record);
+        let entries = load_entries(&shared, None).unwrap();
+        let counts = entries
+            .iter()
+            .map(|entry| {
+                let usage = entry.data.message.usage;
+                (
+                    usage.input_tokens,
+                    usage.output_tokens,
+                    usage.cache_creation_token_count(),
+                    usage.cache_read_input_tokens,
+                )
+            })
+            .collect::<Vec<_>>();
+        let daily_count = load_daily_summaries(&shared, None, false).unwrap().len();
+        observations.push((counts, daily_count));
+
+        let null_record = format!(
+            "{},\"parentUuid\":null}}",
+            record.strip_suffix('}').unwrap()
+        );
+        let _path = fixture.write_file("projects/project-a/session-a.jsonl", null_record);
+        assert!(load_entries(&shared, None).unwrap().is_empty());
+        assert!(
+            load_daily_summaries(&shared, None, false)
+                .unwrap()
+                .is_empty()
+        );
+    }
+    assert_eq!(
+        observations,
+        [(vec![(11, 3, 7, 13)], 0), (vec![(11, 3, 7, 13)], 0)]
+    );
+}
+
+#[test]
+fn json_usage_array_is_not_an_object() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let _path = fixture.write_file(
+        "projects/project-a/session-a.jsonl",
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":[11,3,7,13,"standard",{}]}}"#,
+    );
+    let shared = report_args();
+    let entry_count = load_entries(&shared, None).unwrap().len();
+    let daily_count = load_daily_summaries(&shared, None, false).unwrap().len();
+    assert_eq!((entry_count, daily_count), (0, 0));
+}
+
+#[test]
+fn json_escaped_keys_preserve_counts_and_copies() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let records = format!("{FIRST}\n{SECOND}\n{FIRST}\n")
+        .replace("timestamp", r"time\u0073tamp")
+        .replace("sessionId", r"session\u0049d")
+        .replace("requestId", r"request\u0049d")
+        .replace(r#""message":"#, r#""mess\u0061ge":"#)
+        .replace(r#""usage":"#, r#""us\u0061ge":"#)
+        .replace("input_tokens", r"input_\u0074okens")
+        .replace("output_tokens", r"output_\u0074okens");
+    let _path = fixture.write_file("projects/project-a/session-a.jsonl", records);
+    assert_independent_counts();
+    assert_independent_counts();
+}
+
+#[test]
+fn json_usage_arrays_cannot_use_other_path_objects() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    for record in [
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":[11,3,7,13,"standard",{}]},"data":{"message":{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":99,"output_tokens":1}}}}}"#,
+        r#"{"message":{"usage":{"input_tokens":99,"output_tokens":1}},"data":{"message":{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":[11,3,7,13,"standard",{}]}}}}"#,
+    ] {
+        let _path = fixture.write_file("projects/project-a/session-a.jsonl", record);
+        let shared = report_args();
+        let entry_count = load_entries(&shared, None).unwrap().len();
+        let daily_count = load_daily_summaries(&shared, None, false).unwrap().len();
+        assert_eq!((entry_count, daily_count), (0, 0));
+    }
+}
+
+#[test]
+fn json_agent_progress_keeps_its_daily_only_counts() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let _path = fixture.write_file(
+        "projects/project-a/session-a.jsonl",
+        r#"{"sessionId":"session-a","data" : {"mess\u0061ge":{"timestamp":"2026-01-02T10:00:00.000Z","message":{"us\u0061ge" : {"input_tokens":11,"output_tokens":3,"cache_creation_input_tokens":7,"cache_read_input_tokens":13}}}}}"#,
+    );
+    let shared = report_args();
+    assert!(load_entries(&shared, None).unwrap().is_empty());
+    let daily = load_daily_summaries(&shared, None, false).unwrap();
+    assert_eq!(daily.len(), 1);
+    assert_eq!(daily[0].total_tokens(), 34);
+}
+
+#[test]
+fn json_prompt_text_and_unrelated_usage_do_not_add_counts() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let prompt = r#"{"timestamp":"2026-01-02T10:00:00.000Z","type":"user","message":{"content":"Example: \"usage\":{\"input_tokens\":999,\"output_tokens\":999}"},"usage":{"input_tokens":999,"output_tokens":999},"metadata":{"message":{"usage":{"input_tokens":999,"output_tokens":999}}}}"#;
+    let _path = fixture.write_file(
+        "projects/project-a/session-a.jsonl",
+        format!("{FIRST}\n{prompt}\n{SECOND}\n"),
+    );
+    assert_independent_counts();
+}
+
+#[test]
+fn json_invalid_records_stay_skipped_beside_valid_records() {
+    let fixture = Fixture::new();
+    let _env = EnvVarGuard::set("CLAUDE_CONFIG_DIR", fixture.root());
+    let invalid = [
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":-1,"output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":1.5,"output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":"99","output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":true,"output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":99,"input_\u0074okens":99,"output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"model":null,"usage":{"input_tokens":99,"output_tokens":3}}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":null}}"#,
+        r#"{"timestamp":"2026-01-02T10:00:00.000Z","message":{"usage":{"input_tokens":99,"output_tokens":3}}"#,
+    ];
+    for record in invalid {
+        let _path = fixture.write_file(
+            "projects/project-a/session-a.jsonl",
+            format!("{FIRST}\n{record}\n{SECOND}\n"),
+        );
+        assert_independent_counts();
+    }
+}
