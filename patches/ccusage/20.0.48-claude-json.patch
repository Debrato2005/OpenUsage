+// Serde structs also accept positional arrays. Usage must remain a JSON object
+// at the path that the typed parser selected.
+fn usage_is_object(line: &[u8], path: &[&str]) -> bool {
+    UsageObjectPath(path)
+        .deserialize(&mut serde_json::Deserializer::from_slice(line))
+        .unwrap_or(false)
+}
+
+struct UsageObjectPath<'a>(&'a [&'a str]);
+
+impl<'de> DeserializeSeed<'de> for UsageObjectPath<'_> {
+    type Value = bool;
+
+    fn deserialize<D>(self, deserializer: D) -> std::result::Result<Self::Value, D::Error>
+    where
+        D: serde::Deserializer<'de>,
+    {
+        deserializer.deserialize_map(self)
+    }
+}
+
+impl<'de> Visitor<'de> for UsageObjectPath<'_> {
+    type Value = bool;
+
+    fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("a JSON object at the selected usage path")
+    }
+
+    fn visit_map<A>(self, mut object: A) -> std::result::Result<Self::Value, A::Error>
+    where
+        A: MapAccess<'de>,
+    {
+        let mut found = self.0.is_empty();
+        while let Some(field) = object.next_key::<String>()? {
+            if let Some((next, rest)) = self.0.split_first()
+                && field == *next
+            {
+                found = object.next_value_seed(UsageObjectPath(rest))?;
+            } else {
+                object.next_value::<IgnoredAny>()?;
+            }
+        }
+        Ok(found)
+    }
+}
+
 /// A JSON value parser that preserves typed Serde's rejection of duplicate members.
 /// Parsing through `serde_json::Value` normally keeps only the final duplicate, which could
 /// make a malformed transcript valid before the in-memory typed deserialization runs.
