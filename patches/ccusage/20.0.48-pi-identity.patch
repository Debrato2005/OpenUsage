index 0000000..f86742e
--- /dev/null
+++ b/rust/adapters/pi/src/identity.rs
@@ -0,0 +1,165 @@
+use std::collections::{BTreeMap, HashSet};
+
+use serde_json::Value;
+
+use crate::Result;
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct Header {
+    pub id: String,
+    pub version: u64,
+    pub timestamp: String,
+    pub cwd: Option<String>,
+    pub parent_session: Option<String>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct Record {
+    pub parent: Option<String>,
+    // Forks preserve source records but can change parentId after removing labels.
+    // Keep the source fields, including absent metrics. Never print this value.
+    pub source: Value,
+}
+
+pub(crate) struct Source {
+    pub header: Header,
+    pub records: BTreeMap<String, Record>,
+}
+
+pub(crate) fn unavailable() -> crate::CliError {
+    crate::cli_error("Pi source identity is unsupported, incomplete, or conflicting")
+}
+
+fn text(value: Option<&Value>) -> Result<String> {
+    value
+        .and_then(Value::as_str)
+        .filter(|s| !s.trim().is_empty())
+        .map(str::to_owned)
+        .ok_or_else(unavailable)
+}
+
+fn optional_text(value: Option<&Value>) -> Result<Option<String>> {
+    value.map(|value| text(Some(value))).transpose()
+}
+
+fn timestamp(value: Option<&Value>) -> Result<String> {
+    let value = text(value)?;
+    crate::parse_ts_timestamp(&value).ok_or_else(unavailable)?;
+    Ok(value)
+}
+
+pub(crate) fn parse(content: &[u8]) -> Result<Source> {
+    let mut lines = content
+        .split(|byte| *byte == b'\n')
+        .filter(|line| !line.iter().all(u8::is_ascii_whitespace));
+    let header: Value =
+        serde_json::from_slice(lines.next().ok_or_else(unavailable)?).map_err(|_| unavailable())?;
+    if header.get("type").and_then(Value::as_str) != Some("session") {
+        return Err(unavailable());
+    }
+    let version = header
+        .get("version")
+        .and_then(Value::as_u64)
+        .ok_or_else(unavailable)?;
+    if !matches!(version, 2 | 3) {
+        return Err(unavailable());
+    }
+    let header = Header {
+        id: text(header.get("id"))?,
+        version,
+        timestamp: timestamp(header.get("timestamp"))?,
+        cwd: optional_text(header.get("cwd"))?,
+        parent_session: optional_text(header.get("parentSession"))?,
+    };
+    let mut records = BTreeMap::new();
+    for line in lines {
+        let mut value: Value = serde_json::from_slice(line).map_err(|_| unavailable())?;
+        let kind = text(value.get("type"))?;
+        if kind == "session" {
+            return Err(unavailable());
+        }
+        let id = text(value.get("id"))?;
+        timestamp(value.get("timestamp"))?;
+        let parent = match value.get("parentId") {
+            Some(Value::Null) => None,
+            Some(value) => Some(text(Some(value))?),
+            None => return Err(unavailable()),
+        };
+        validate_usage(&value, &kind)?;
+        value
+            .as_object_mut()
+            .ok_or_else(unavailable)?
+            .remove("parentId");
+        let record = Record {
+            parent,
+            source: value,
+        };
+        if let Some(previous) = records.get(&id) {
+            if previous != &record {
+                return Err(unavailable());
+            }
+        } else {
+            records.insert(id, record);
+        }
+    }
+    validate_links(&records)?;
+    Ok(Source { header, records })
+}
+
+fn validate_usage(value: &Value, kind: &str) -> Result<()> {
+    let usage = if kind == "message" {
+        let message = value.get("message").ok_or_else(unavailable)?;
+        if message.get("role").and_then(Value::as_str) != Some("assistant") {
+            return Ok(());
+        }
+        Some(message.get("usage").ok_or_else(unavailable)?)
+    } else {
+        value.get("usage")
+    };
+    let Some(usage) = usage else {
+        return Ok(());
+    };
+    if !matches!(kind, "message" | "usage" | "compaction" | "branch_summary") || !usage.is_object()
+    {
+        return Err(unavailable());
+    }
+    let mut sum = 0u64;
+    let mut reported = false;
+    for field in ["input", "output", "cacheRead", "cacheWrite"] {
+        if let Some(count) = usage.get(field) {
+            reported = true;
+            sum = sum
+                .checked_add(count.as_u64().ok_or_else(unavailable)?)
+                .ok_or_else(unavailable)?;
+        }
+    }
+    if let Some(total) = usage.get("totalTokens") {
+        reported = true;
+        if total.as_u64().ok_or_else(unavailable)? < sum {
+            return Err(unavailable());
+        }
+    }
+    if !reported {
+        return Err(unavailable());
+    }
+    Ok(())
+}
+
+fn validate_links(records: &BTreeMap<String, Record>) -> Result<()> {
+    let mut validated = HashSet::new();
+    for start in records.keys() {
+        let mut path = HashSet::new();
+        let mut current = Some(start.as_str());
+        while let Some(id) = current {
+            if validated.contains(id) {
+                break;
+            }
+            if !path.insert(id) {
+                return Err(unavailable());
+            }
+            current = records.get(id).ok_or_else(unavailable)?.parent.as_deref();
+        }
+        validated.extend(path);
+    }
+    Ok(())
+}
