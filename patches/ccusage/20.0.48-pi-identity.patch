@@ -0,0 +1,534 @@
+use crate::{
+    LoadedEntry, Result,
+    cli::{CostMode, SharedArgs},
+    loader,
+};
+use ccusage_test_support::Fixture;
+use serde_json::{Value, json};
+use std::path::{Path, PathBuf};
+
+fn header(id: &str, parent: Option<&Path>) -> Value {
+    let mut record = json!({"type":"session","version":3,"id":id,
+        "timestamp":"2026-05-28T00:00:00.000Z","cwd":"/synthetic/project"});
+    if let Some(parent) = parent {
+        record["parentSession"] = json!(parent.to_string_lossy());
+        record["timestamp"] = json!("2026-05-28T21:00:00.000Z");
+    }
+    record
+}
+
+fn event(id: &str, parent: Option<&str>, total: u64) -> Value {
+    json!({"type":"message","id":id,"parentId":parent,
+        "timestamp":"2026-05-28T20:26:40.000Z",
+        "message":{"role":"assistant","model":"gpt-5","provider":"openai",
+            "usage":{"input":total.saturating_sub(5),"output":total.min(5),
+                "cacheRead":0,"cacheWrite":0,"totalTokens":total}}})
+}
+
+fn write(fixture: &Fixture, path: &str, header: Value, events: &[Value]) -> PathBuf {
+    let content = std::iter::once(header)
+        .chain(events.iter().cloned())
+        .map(|record| record.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    fixture.write_file(path, content)
+}
+
+fn load(roots: &[PathBuf]) -> Result<Vec<LoadedEntry>> {
+    let paths = roots
+        .iter()
+        .map(|p| p.to_string_lossy())
+        .collect::<Vec<_>>()
+        .join(",");
+    loader::load_entries(
+        &SharedArgs {
+            mode: CostMode::Calculate,
+            offline: true,
+            json: true,
+            ..SharedArgs::default()
+        },
+        Some(&paths),
+        None,
+    )
+}
+
+#[test]
+fn copies_keep_session_identity_when_paths_change() {
+    let fixture = Fixture::new();
+    let source = write(
+        &fixture,
+        "first/sessions/project-a/root.jsonl",
+        header("source-session", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let other = fixture.create_dir_all("second/sessions/project-b");
+    std::fs::copy(source, other.join("renamed.jsonl")).unwrap();
+    let entries = load(&[
+        fixture.path("first/sessions"),
+        fixture.path("second/sessions"),
+    ])
+    .unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].session_id.as_ref(), "source-session");
+    assert_eq!(entries[0].project_path.as_ref(), "/synthetic/project");
+}
+
+#[test]
+fn distinct_entries_with_equal_usage_are_both_retained() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/project-a/root.jsonl",
+        header("source-session", None),
+        &[
+            event("aaaaaaaa", None, 120),
+            event("bbbbbbbb", Some("aaaaaaaa"), 120),
+        ],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 2);
+}
+
+#[test]
+fn independent_sessions_keep_coincident_short_ids_separate() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/project-a/first.jsonl",
+        header("first-session", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    write(
+        &fixture,
+        "sessions/project-a/second.jsonl",
+        header("second-session", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 2);
+}
+
+#[test]
+fn conflicting_usage_in_one_session_fails() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/project-a/root.jsonl",
+        header("source-session", None),
+        &[event("aaaaaaaa", None, 120), event("aaaaaaaa", None, 150)],
+    );
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn fork_of_an_inactive_branch_counts_its_copied_entries_once() {
+    let fixture = Fixture::new();
+    let events = [
+        event("aaaaaaaa", None, 120),
+        event("bbbbbbbb", Some("aaaaaaaa"), 17),
+        event("cccccccc", Some("aaaaaaaa"), 23),
+    ];
+    let parent = write(
+        &fixture,
+        "sessions/project-a/parent.jsonl",
+        header("parent", None),
+        &events,
+    );
+    write(
+        &fixture,
+        "sessions/project-a/child.jsonl",
+        header("child", Some(&parent)),
+        &events[..2],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 3);
+}
+
+#[test]
+fn full_branched_clone_counts_all_copied_entries_once() {
+    let fixture = Fixture::new();
+    let events = [
+        event("aaaaaaaa", None, 120),
+        event("bbbbbbbb", Some("aaaaaaaa"), 17),
+        event("cccccccc", Some("aaaaaaaa"), 23),
+    ];
+    let parent = write(
+        &fixture,
+        "sessions/project-a/parent.jsonl",
+        header("parent", None),
+        &events,
+    );
+    write(
+        &fixture,
+        "sessions/project-a/child.jsonl",
+        header("child", Some(&parent)),
+        &events,
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 3);
+}
+
+#[test]
+fn parent_link_does_not_merge_distinct_entry_ids() {
+    let fixture = Fixture::new();
+    let parent = write(
+        &fixture,
+        "sessions/project-a/parent.jsonl",
+        header("parent", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let mut child_header = header("child", Some(&parent));
+    child_header["timestamp"] = json!("2026-05-28T20:26:40.000Z");
+    write(
+        &fixture,
+        "sessions/project-a/child.jsonl",
+        child_header,
+        &[event("bbbbbbbb", None, 120)],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 2);
+}
+
+#[test]
+fn conflicting_usage_on_a_parent_link_fails() {
+    let fixture = Fixture::new();
+    let parent = write(
+        &fixture,
+        "sessions/project-a/parent.jsonl",
+        header("parent", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    write(
+        &fixture,
+        "sessions/project-a/child.jsonl",
+        header("child", Some(&parent)),
+        &[event("aaaaaaaa", None, 150)],
+    );
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn missing_or_invalid_identity_is_unavailable() {
+    for variant in [
+        "version-one",
+        "future-version",
+        "headerless",
+        "entry-id",
+        "parent-id",
+        "dangling",
+        "cycle",
+        "missing-parent",
+        "self-parent",
+        "malformed-parent",
+    ] {
+        let fixture = Fixture::new();
+        let mut head = header("root", None);
+        let mut row = event("aaaaaaaa", None, 120);
+        match variant {
+            "version-one" => head["version"] = json!(1),
+            "future-version" => head["version"] = json!(4),
+            "headerless" => head = row.clone(),
+            "entry-id" => {
+                row.as_object_mut().unwrap().remove("id");
+            }
+            "parent-id" => {
+                row.as_object_mut().unwrap().remove("parentId");
+            }
+            "dangling" => row["parentId"] = json!("absent"),
+            "cycle" => row["parentId"] = json!("aaaaaaaa"),
+            "missing-parent" => head["parentSession"] = json!(fixture.path("outside.jsonl")),
+            "self-parent" => head["parentSession"] = json!(fixture.path("sessions/root.jsonl")),
+            "malformed-parent" => head["parentSession"] = json!(42),
+            _ => unreachable!(),
+        }
+        write(&fixture, "sessions/root.jsonl", head, &[row]);
+        assert!(load(&[fixture.path("sessions")]).is_err(), "{variant}");
+    }
+}
+
+#[test]
+fn conflicts_include_fields_that_do_not_change_the_reported_total() {
+    for field in [
+        "provider",
+        "model",
+        "cost",
+        "missing-category",
+        "parent",
+        "zero",
+    ] {
+        let fixture = Fixture::new();
+        let first = event("aaaaaaaa", None, 120);
+        let mut changed = first.clone();
+        match field {
+            "provider" => changed["message"]["provider"] = json!("another-provider"),
+            "model" => changed["message"]["model"] = json!("another-model"),
+            "cost" => changed["message"]["usage"]["cost"] = json!({"total":0}),
+            "missing-category" => {
+                changed["message"]["usage"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("cacheRead");
+            }
+            "parent" => changed["parentId"] = json!("aaaaaaaa"),
+            "zero" => changed = event("aaaaaaaa", None, 0),
+            _ => unreachable!(),
+        }
+        write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[first, changed],
+        );
+        assert!(load(&[fixture.path("sessions")]).is_err(), "{field}");
+    }
+}
+
+#[test]
+fn root_order_and_growing_copies_do_not_change_totals_or_attribution() {
+    let fixture = Fixture::new();
+    let first = event("aaaaaaaa", None, 120);
+    let later = event("bbbbbbbb", Some("aaaaaaaa"), 17);
+    let parent = write(
+        &fixture,
+        "first/sessions/a/root.jsonl",
+        header("parent", None),
+        std::slice::from_ref(&first),
+    );
+    write(
+        &fixture,
+        "second/sessions/b/renamed.jsonl",
+        header("parent", None),
+        &[first.clone(), later.clone()],
+    );
+    write(
+        &fixture,
+        "third/sessions/c/child.jsonl",
+        header("child", Some(&parent)),
+        &[first, later],
+    );
+    let roots = [
+        fixture.path("first/sessions"),
+        fixture.path("second/sessions"),
+        fixture.path("third/sessions"),
+    ];
+    let expected = load(&roots).unwrap();
+    let actual = load(&roots.into_iter().rev().collect::<Vec<_>>()).unwrap();
+    assert_eq!(expected.len(), 2);
+    assert_eq!(actual.len(), 2);
+    for (a, b) in expected.iter().zip(actual.iter()) {
+        assert_eq!(a.session_id, b.session_id);
+        assert_eq!(a.data.message.id, b.data.message.id);
+        assert_eq!(a.session_id.as_ref(), "parent");
+    }
+}
+
+#[test]
+fn nested_forks_keep_each_new_call_in_its_source_session() {
+    let fixture = Fixture::new();
+    let mut rows = vec![event("aaaaaaaa", None, 120)];
+    let root = write(&fixture, "sessions/root.jsonl", header("root", None), &rows);
+    rows.push(event("bbbbbbbb", Some("aaaaaaaa"), 17));
+    let child = write(
+        &fixture,
+        "sessions/child.jsonl",
+        header("child", Some(&root)),
+        &rows,
+    );
+    rows.push(event("cccccccc", Some("bbbbbbbb"), 23));
+    write(
+        &fixture,
+        "sessions/grandchild.jsonl",
+        header("grandchild", Some(&child)),
+        &rows,
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    assert_eq!(entries.len(), 3);
+    for (id, source) in [
+        ("aaaaaaaa", "root"),
+        ("bbbbbbbb", "child"),
+        ("cccccccc", "grandchild"),
+    ] {
+        assert_eq!(
+            entries
+                .iter()
+                .find(|e| e.data.message.id.as_deref() == Some(id))
+                .unwrap()
+                .session_id
+                .as_ref(),
+            source
+        );
+    }
+}
+
+#[test]
+fn sibling_new_calls_with_the_same_short_id_remain_separate() {
+    let fixture = Fixture::new();
+    let root = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    for name in ["first", "second"] {
+        write(
+            &fixture,
+            &format!("sessions/{name}.jsonl"),
+            header(name, Some(&root)),
+            &[event("bbbbbbbb", None, 17)],
+        );
+    }
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 3);
+}
+
+#[test]
+fn fork_can_remove_labels_and_change_entry_parent_links() {
+    let fixture = Fixture::new();
+    let first = event("aaaaaaaa", None, 120);
+    let label = json!({"type":"label","id":"label","parentId":"aaaaaaaa","timestamp":"2026-05-28T20:26:40.000Z","targetId":"aaaaaaaa","label":"synthetic"});
+    let last = event("bbbbbbbb", Some("label"), 17);
+    let root = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[first.clone(), label, last],
+    );
+    write(
+        &fixture,
+        "sessions/child.jsonl",
+        header("child", Some(&root)),
+        &[first, event("bbbbbbbb", Some("aaaaaaaa"), 17)],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 2);
+}
+
+#[test]
+fn copied_session_headers_must_agree() {
+    for field in ["cwd", "timestamp", "version"] {
+        let fixture = Fixture::new();
+        let rows = [event("aaaaaaaa", None, 120)];
+        let mut changed = header("root", None);
