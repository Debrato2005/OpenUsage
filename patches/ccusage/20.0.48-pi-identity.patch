+#[test]
+fn replayed_records_count_once_and_missing_project_stays_unknown() {
+    let fixture = Fixture::new();
+    let mut head = header("root", None);
+    head.as_object_mut().unwrap().remove("cwd");
+    let row = event("aaaaaaaa", None, 120);
+    write(
+        &fixture,
+        "sessions/suggested-project/root.jsonl",
+        head,
+        &[row.clone(), row],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].project_path.as_ref(), "unknown");
+}
