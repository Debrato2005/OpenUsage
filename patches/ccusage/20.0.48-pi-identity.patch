+
+#[test]
+fn incomplete_records_do_not_return_a_partial_success() {
+    for suffix in ["{", "{\"type\":\"message\",\"id\":\"private-marker\"}"] {
+        let fixture = Fixture::new();
+        let file = write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120)],
+        );
+        let mut bytes = std::fs::read(&file).unwrap();
+        bytes.extend_from_slice(format!("\n{suffix}").as_bytes());
+        std::fs::write(&file, bytes).unwrap();
+        let error = load(&[fixture.path("sessions")]).err().unwrap().to_string();
+        assert!(!error.contains("private-marker"));
+        assert!(!error.contains(file.to_str().unwrap()));
+    }
+}
+
+#[test]
+fn only_derived_artifacts_are_excluded() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let _ = fixture.write_file(
+        "sessions/subagent-artifacts/transcript.jsonl",
+        "not a source session",
+    );
+    write(
+        &fixture,
+        "sessions/run-1/child.jsonl",
+        header("child", None),
+        &[event("bbbbbbbb", None, 17)],
+    );
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 2);
+}
+
+#[test]
+fn named_stores_use_the_same_copy_rules_and_keep_their_model_scope() {
+    let fixture = Fixture::new();
+    let rows = [event("aaaaaaaa", None, 120)];
+    write(&fixture, "first/root.jsonl", header("root", None), &rows);
+    write(&fixture, "second/copy.jsonl", header("root", None), &rows);
+    for name in ["store-a", "store-b"] {
+        for single_thread in [false, true] {
+            let entries = loader::load_entries_for_store_paths(
+                &SharedArgs {
+                    mode: CostMode::Calculate,
+                    offline: true,
+                    json: true,
+                    single_thread,
+                    ..SharedArgs::default()
+                },
+                vec![fixture.path("first"), fixture.path("second")],
+                name,
+                None,
+            )
+            .unwrap();
+            assert_eq!(entries.len(), 1);
+            assert_eq!(
+                entries[0].model.as_deref(),
+                Some(format!("[{name}] gpt-5").as_str())
+            );
+        }
+    }
+}
