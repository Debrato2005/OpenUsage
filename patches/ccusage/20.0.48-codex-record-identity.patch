diff --git a/rust/adapters/codex/src/paginated.rs b/rust/adapters/codex/src/paginated.rs
new file mode 100644
--- /dev/null
+++ b/rust/adapters/codex/src/paginated.rs
@@ -0,0 +1,526 @@
+//! The tested 0.163.0 paginated format uses emitted identity, never replay timing.
+use crate::{CodexServiceTier, CodexTokenUsageEvent, Result, cli_error};
+use ring::digest::{SHA256, digest};
+use serde_json::Value;
+use std::{
+    collections::BTreeMap,
+    io::{BufRead, Read},
+    path::PathBuf,
+};
+
+const MAX_RECORDS: usize = 100_000;
+const MAX_LINE: usize = 1 << 20;
+const MAX_EXACT: u64 = (1_u64 << 53) - 1;
+
+pub(super) fn unavailable() -> crate::CliError {
+    cli_error(
+        "Codex paginated capture is unavailable: incomplete, conflicting, unsupported, or over limit",
+    )
+}
+
+fn text<'a>(value: &'a Value, key: &str) -> Result<&'a str> {
+    value[key]
+        .as_str()
+        .filter(|v| !v.is_empty() && v.len() <= 1024)
+        .ok_or_else(unavailable)
+}
+fn count(value: &Value, key: &str) -> Result<u64> {
+    value[key]
+        .as_u64()
+        .filter(|v| *v <= MAX_EXACT)
+        .ok_or_else(unavailable)
+}
+
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+struct Usage([u64; 6]);
+impl Usage {
+    fn parse(value: &Value) -> Result<Self> {
+        let result = Self([
+            count(value, "input_tokens")?,
+            count(value, "cached_input_tokens")?,
+            count(value, "cache_write_input_tokens")?,
+            count(value, "output_tokens")?,
+            count(value, "reasoning_output_tokens")?,
+            count(value, "total_tokens")?,
+        ]);
+        let [input, cached, write, output, reasoning, total] = result.0;
+        if cached.checked_add(write).is_none_or(|v| v > input)
+            || reasoning > output
+            || input.checked_add(output) != Some(total)
+        {
+            return Err(unavailable());
+        }
+        Ok(result)
+    }
+    fn add(self, other: Self) -> Result<Self> {
+        let mut sum = self;
+        for (target, value) in sum.0.iter_mut().zip(other.0) {
+            *target = target
+                .checked_add(value)
+                .filter(|v| *v <= MAX_EXACT)
+                .ok_or_else(unavailable)?;
+        }
+        Ok(sum)
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+struct Base {
+    thread: String,
+    end: u64,
+    bytes: u64,
+}
+#[derive(Clone, PartialEq, Eq)]
+struct Meta {
+    thread: String,
+    session: String,
+    start: u64,
+    base: Option<Base>,
+}
+#[derive(Clone)]
+struct Record {
+    ordinal: u64,
+    turn: String,
+    usage: Usage,
+    turn_usage: Usage,
+    thread_usage: Usage,
+    event: CodexTokenUsageEvent,
+}
+struct Thread {
+    meta: Meta,
+    rows: BTreeMap<u64, Vec<u8>>,
+    boundaries: BTreeMap<u64, Vec<u64>>,
+    records: BTreeMap<u64, Record>,
+    counters: BTreeMap<u64, Option<(Usage, Usage)>>,
+}
+
+fn probe_files(roots: &[PathBuf]) -> Result<Vec<PathBuf>> {
+    if roots.len() > 64 {
+        return Err(unavailable());
+    }
+    let mut files = Vec::new();
+    let mut entries = 0_usize;
+    for root in roots {
+        if !root.exists() {
+            continue;
+        }
+        let mut pending = vec![(root.clone(), 0)];
+        while let Some((directory, depth)) = pending.pop() {
+            if depth > 64 {
+                return Err(unavailable());
+            }
+            #[cfg(target_os = "linux")]
+            let _guard = {
+                use rustix::fs::{CWD, Mode, OFlags, ResolveFlags, openat2};
+                openat2(
+                    CWD,
+                    &directory,
+                    OFlags::RDONLY | OFlags::DIRECTORY | OFlags::CLOEXEC,
+                    Mode::empty(),
+                    ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+                )
+                .map_err(|_| unavailable())?
+            };
+            for entry in std::fs::read_dir(&directory).map_err(|_| unavailable())? {
+                entries += 1;
+                if entries > 32768 {
+                    return Err(unavailable());
+                }
+                let entry = entry.map_err(|_| unavailable())?;
+                let kind = entry.file_type().map_err(|_| unavailable())?;
+                if kind.is_dir() {
+                    pending.push((entry.path(), depth + 1));
+                } else if kind.is_file() && super::reader::is_rollout_file(&entry.path()) {
+                    files.push(entry.path());
+                    if files.len() > 8192 {
+                        return Err(unavailable());
+                    }
+                } else if !kind.is_file() {
+                    return Err(unavailable());
+                }
+            }
+        }
+    }
+    files.sort();
+    Ok(files)
+}
+
+fn probe_reader(path: &std::path::Path) -> Result<Box<dyn BufRead>> {
+    #[cfg(target_os = "linux")]
+    {
+        use rustix::fs::{CWD, Mode, OFlags, ResolveFlags, openat2};
+        let fd = openat2(
+            CWD,
+            path,
+            OFlags::RDONLY | OFlags::CLOEXEC | OFlags::NONBLOCK,
+            Mode::empty(),
+            ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())?;
+        let file = std::fs::File::from(fd);
+        if !file.metadata().map_err(|_| unavailable())?.is_file() {
+            return Err(unavailable());
+        }
+        if path.extension().is_some_and(|ext| ext == "zst") {
+            let decoder = zstd::stream::read::Decoder::new(file).map_err(|_| unavailable())?;
+            Ok(Box::new(std::io::BufReader::new(decoder)))
+        } else {
+            Ok(Box::new(std::io::BufReader::new(file)))
+        }
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        super::reader::open_rollout_reader(path)
+            .map(|(reader, _)| reader)
+            .map_err(|_| unavailable())
+    }
+}
+
+// Probe only selects the parser. The qualified path captures all selected files again.
+// A recognized marker can never fall back to the legacy parser.
+pub(super) fn load(roots: &[PathBuf]) -> Result<Option<Vec<CodexTokenUsageEvent>>> {
+    let mut recognized = false;
+    let mut scanned = 0_u64;
+    for path in probe_files(roots)? {
+        let Ok(mut reader) = probe_reader(&path) else {
+            continue;
+        };
+        loop {
+            let mut line = Vec::new();
+            let Ok(length) = reader
+                .by_ref()
+                .take(MAX_LINE as u64 + 1)
+                .read_until(b'\n', &mut line)
+            else {
+                break;
+            };
+            if length == 0 {
+                break;
+            }
+            scanned = scanned.checked_add(length as u64).ok_or_else(unavailable)?;
+            if length > MAX_LINE || scanned > 64 << 20 {
+                return Err(unavailable());
+            }
+            if let Ok(row) = serde_json::from_slice::<Value>(&line) {
+                recognized |= row.get("ordinal").is_some()
+                    || row["payload"]["history_mode"] == "paginated"
+                    || row["payload"].get("history_base").is_some()
+                    || (row["type"] == "token_usage_record"
+                        && row["payload"].get("thread_id").is_some());
+            } else {
+                recognized |= line.windows(11).any(|v| v == b"\"paginated\"")
+                    || line.windows(9).any(|v| v == b"\"ordinal\"");
+            }
+            if recognized {
+                break;
+            }
+        }
+        if recognized {
+            break;
+        }
+    }
+    if !recognized {
+        return Ok(None);
+    }
+    let mut threads: BTreeMap<String, Thread> = BTreeMap::new();
+    let mut records = 0;
+    super::record_files::read(roots, |_, _, bytes| {
+        if bytes.is_empty() {
+            return Ok(());
+        }
+        parse_file(bytes, &mut threads, &mut records)
+    })?;
+    let mut sessions = BTreeMap::new();
+    for thread in threads.values() {
+        if sessions
+            .insert(&thread.meta.session, &thread.meta.thread)
+            .is_some()
+        {
+            return Err(unavailable());
+        }
+    }
+    let mut events = Vec::new();
+    let mut identities = BTreeMap::new();
+    let mut total = Usage::default();
+    for thread in threads.values() {
+        let mut cumulative = inherited(thread, &threads, &mut Vec::new())?;
+        let baseline = cumulative;
+        for (ordinal, counter) in &thread.counters {
+            let Some((last, total)) = counter else {
+                continue;
+            };
+            let prior = thread
+                .records
+                .range(..*ordinal)
+                .next_back()
+                .map(|(_, record)| record);
+            if *total != prior.map_or(baseline, |record| record.thread_usage)
+                || last
+                    .0
+                    .into_iter()
+                    .zip(total.0)
+                    .any(|(last, total)| last > total)
+                || prior.is_some_and(|record| *last != record.usage)
+            {
+                return Err(unavailable());
+            }
+        }
+        let mut turns: BTreeMap<&str, Usage> = BTreeMap::new();
+        for record in thread.records.values() {
+            cumulative = cumulative.add(record.usage)?;
+            let turn = turns.entry(&record.turn).or_default();
+            *turn = turn.add(record.usage)?;
+            if cumulative != record.thread_usage || *turn != record.turn_usage {
+                return Err(unavailable());
+            }
+            let id = record.event.response_id.as_ref().ok_or_else(unavailable)?;
+            if identities.insert(id, &record.event).is_some() {
+                return Err(unavailable());
+            }
+            total = total.add(record.usage)?;
+            events.push(record.event.clone());
+        }
+    }
+    Ok(Some(events))
+}
+
+fn inherited(
+    thread: &Thread,
+    threads: &BTreeMap<String, Thread>,
+    visiting: &mut Vec<String>,
+) -> Result<Usage> {
+    if visiting.contains(&thread.meta.thread) || visiting.len() > 64 {
+        return Err(unavailable());
+    }
+    visiting.push(thread.meta.thread.clone());
+    let result = if let Some(base) = &thread.meta.base {
+        let parent = threads.get(&base.thread).ok_or_else(unavailable)?;
+        if base.end <= parent.meta.start
+            || !parent
+                .boundaries
+                .get(&base.end)
+                .is_some_and(|bytes| bytes.contains(&base.bytes))
+        {
+            return Err(unavailable());
+        }
+        let mut usage = inherited(parent, threads, visiting)?;
+        for record in parent
+            .records
+            .values()
+            .filter(|record| record.ordinal < base.end)
+        {
+            usage = usage.add(record.usage)?;
+        }
+        usage
+    } else {
+        Usage::default()
+    };
+    visiting.pop();
+    Ok(result)
+}
+
+fn metadata(row: &Value) -> Result<Meta> {
+    let value = &row["payload"];
+    if row["type"] != "session_meta"
+        || value["history_mode"] != "paginated"
+        || value["cli_version"] != "0.163.0"
+    {
+        return Err(unavailable());
+    }
+    let thread = text(value, "id")?.to_owned();
+    let session = text(value, "session_id")?.to_owned();
+    let start = count(row, "ordinal")?;
+    let base = if !value["history_base"].is_null() {
+        let base = &value["history_base"];
+        let parent = text(base, "thread_id")?;
+        let end = count(base, "end_ordinal_exclusive")?;
+        let bytes = count(base, "end_byte_offset")?;
+        if parent == thread
+            || value["forked_from_id"] != parent
+            || count(value, "forked_from_ordinal_exclusive")? != end
+            || start != end
+            || bytes == 0
+        {
+            return Err(unavailable());
+        }
+        Some(Base {
+            thread: parent.to_owned(),
+            end,
+            bytes,
+        })
+    } else {
+        if start != 0
+            || !value["forked_from_id"].is_null()
+            || !value["forked_from_ordinal_exclusive"].is_null()
+        {
+            return Err(unavailable());
+        }
+        None
+    };
+    Ok(Meta {
+        thread,
+        session,
+        start,
+        base,
+    })
+}
+
+fn parse_file(
+    bytes: &[u8],
+    threads: &mut BTreeMap<String, Thread>,
+    records: &mut usize,
+) -> Result<()> {
+    if !bytes.ends_with(b"\n") {
+        return Err(unavailable());
+    }
+    let mut lines = bytes.split_inclusive(|byte| *byte == b'\n');
+    let first = lines.next().ok_or_else(unavailable)?;
+    if first.len() > MAX_LINE {
+        return Err(unavailable());
+    }
+    let meta = metadata(&super::record_json::parse(first)?)?;
+    let thread = threads
+        .entry(meta.thread.clone())
+        .or_insert_with(|| Thread {
+            meta: meta.clone(),
+            rows: BTreeMap::new(),
+            boundaries: BTreeMap::new(),
+            records: BTreeMap::new(),
+            counters: BTreeMap::new(),
+        });
+    if thread.meta != meta {
+        return Err(unavailable());
+    }
+    let mut next = meta.start;
+    let mut offset = 0_u64;
+    let mut local = BTreeMap::new();
+    let mut contexts: BTreeMap<String, (String, Option<String>)> = BTreeMap::new();
+    let mut tier = None;
+    for line in std::iter::once(first).chain(lines) {
+        *records += 1;
+        if *records > MAX_RECORDS || line.len() > MAX_LINE {
+            return Err(unavailable());
+        }
+        let row = super::record_json::parse(line)?;
+        let ordinal = count(&row, "ordinal")?;
+        let encoded = serde_json::to_vec(&row).map_err(|_| unavailable())?;
+        let hash = digest(&SHA256, &encoded).as_ref().to_vec();
+        offset += line.len() as u64;
+        if let Some(prior) = local.get(&ordinal) {
+            if prior != &hash {
+                return Err(unavailable());
+            }
+            continue;
+        }
+        if ordinal != next {
+            return Err(unavailable());
+        }
+        next = next.checked_add(1).ok_or_else(unavailable)?;
+        local.insert(ordinal, hash.clone());
+        if thread
+            .rows
+            .get(&ordinal)
+            .is_some_and(|prior| prior != &hash)
+        {
+            return Err(unavailable());
+        }
+        thread.rows.insert(ordinal, hash);
+        thread.boundaries.entry(next).or_default().push(offset);
+        let timestamp = text(&row, "timestamp")?;
+        if crate::parse_ts_timestamp(timestamp).is_none() {
+            return Err(unavailable());
+        }
+        let payload = &row["payload"];
+        match text(&row, "type")? {
+            "session_meta" if ordinal == meta.start => {}
+            "turn_context" => {
+                let turn = text(payload, "turn_id")?.to_owned();
+                let root = text(payload, "root_turn_id")?.to_owned();
+                let model = if payload["model"].is_null() {
+                    None
+                } else {
+                    Some(text(payload, "model")?.to_owned())
+                };
+                let context = (root, model);
+                if contexts.get(&turn).is_some_and(|prior| prior != &context) {
+                    return Err(unavailable());
+                }
+                contexts.insert(turn, context);
+            }
+            "token_usage_record" => {
+                if payload["thread_id"] != meta.thread || payload["session_id"] != meta.session {
+                    return Err(unavailable());
+                }
+                let turn = text(payload, "turn_id")?;
+                let root = text(payload, "root_turn_id")?;
+                let response = text(payload, "response_id")?;
+                let (context_root, model) = contexts.get(turn).ok_or_else(unavailable)?;
+                if context_root != root || root != turn {
+                    return Err(unavailable());
+                }
+                let usage = Usage::parse(&payload["usage"])?;
+                let [input, cached, write, output, reasoning, total] = usage.0;
+                let record = Record {
+                    ordinal,
+                    turn: turn.to_owned(),
+                    usage,
+                    turn_usage: Usage::parse(&payload["turn_token_usage"])?,
+                    thread_usage: Usage::parse(&payload["thread_token_usage"])?,
+                    event: CodexTokenUsageEvent {
+                        session_id: meta.session.clone(),
+                        response_id: Some(format!(
+                            "codex-record:{}",
+                            serde_json::to_string(&[&meta.thread, response])
+                                .map_err(|_| unavailable())?
+                        )),
+                        timestamp: timestamp.to_owned(),
+                        model: model.clone(),
+                        input_tokens: input,
+                        cached_input_tokens: cached,
+                        cache_creation_tokens: write,
+                        output_tokens: output,
+                        reasoning_output_tokens: reasoning,
+                        total_tokens: total,
+                        is_fallback_model: false,
+                        service_tier: tier,
+                    },
+                };
+                thread.records.insert(ordinal, record);
+            }
+            "event_msg" => match text(payload, "type")? {
+                "thread_settings_applied" => {
+                    tier = match payload["thread_settings"]["service_tier"].as_str() {
+                        Some("default" | "standard") => Some(CodexServiceTier::Standard),
+                        Some("priority" | "fast") => Some(CodexServiceTier::Fast),
+                        Some("flex") => Some(CodexServiceTier::Flex),
+                        Some("ultrafast") => Some(CodexServiceTier::Ultrafast),
+                        None => tier,
+                        _ => return Err(unavailable()),
+                    };
+                }
+                "token_count" => {
+                    let info = &payload["info"];
+                    let counter = if info.is_null() {
+                        None
+                    } else {
+                        Some((
+                            Usage::parse(&info["last_token_usage"])?,
+                            Usage::parse(&info["total_token_usage"])?,
+                        ))
+                    };
+                    thread.counters.insert(ordinal, counter);
+                }
+                "task_started" | "task_complete" => {
+                    if text(payload, "turn_id")? != text(payload, "root_turn_id")? {
+                        return Err(unavailable());
+                    }
+                }
+                "item_completed" => {}
+                _ => return Err(unavailable()),
+            },
+            "response_item" if payload["type"] == "message" => {}
+            "world_state" => {}
+            _ => return Err(unavailable()),
+        }
+    }
+    Ok(())
+}
