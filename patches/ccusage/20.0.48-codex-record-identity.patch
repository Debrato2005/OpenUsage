--- /dev/null
+++ b/rust/adapters/codex/src/record_files.rs
@@ -0,0 +1,356 @@
+use std::path::PathBuf;
+
+use crate::Result;
+
+pub(crate) const MAX_ROOTS: usize = 64;
+
+pub(crate) fn read(
+    paths: &[PathBuf],
+    visit: impl FnMut(&std::path::Path, &std::path::Path, &[u8]) -> Result<()>,
+) -> Result<()> {
+    if paths.is_empty() {
+        return Ok(());
+    }
+    #[cfg(target_os = "linux")]
+    {
+        linux::read_with(paths, linux::Limits::default(), |_| {}, visit)
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = visit;
+        Err(super::paginated::unavailable())
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) mod linux {
+    use super::super::paginated::unavailable;
+    use crate::Result;
+    use ring::digest::{self, SHA256};
+    use rustix::{
+        fd::OwnedFd,
+        fs::{self, AtFlags, CWD, Dir, FileType, Mode, OFlags, ResolveFlags, Stat},
+    };
+    use std::{
+        collections::BTreeMap,
+        ffi::OsStr,
+        fs::File,
+        io::Read,
+        os::unix::ffi::OsStrExt,
+        path::{Path, PathBuf},
+    };
+
+    #[derive(Clone, Copy)]
+    pub(crate) struct Limits {
+        pub roots: usize,
+        pub entries: usize,
+        pub files: usize,
+        pub depth: usize,
+        pub file_bytes: u64,
+        pub total_bytes: u64,
+    }
+
+    impl Default for Limits {
+        fn default() -> Self {
+            Self {
+                roots: super::MAX_ROOTS,
+                entries: 32768,
+                files: 8192,
+                depth: 64,
+                file_bytes: 32 << 20,
+                total_bytes: 64 << 20,
+            }
+        }
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub(crate) enum Stage {
+        Discovered,
+        Read(usize),
+        BeforeVerify,
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    struct Stamp {
+        device: u64,
+        inode: u64,
+        mode: u32,
+        size: i64,
+        modified: (i128, i128),
+        changed: (i128, i128),
+    }
+
+    impl From<Stat> for Stamp {
+        fn from(stat: Stat) -> Self {
+            Self {
+                device: stat.st_dev,
+                inode: stat.st_ino,
+                mode: stat.st_mode,
+                size: stat.st_size,
+                modified: (stat.st_mtime.into(), stat.st_mtime_nsec.into()),
+                changed: (stat.st_ctime.into(), stat.st_ctime_nsec.into()),
+            }
+        }
+    }
+
+    struct Root {
+        path: PathBuf,
+        fd: OwnedFd,
+        stamp: Stamp,
+    }
+    type Manifest = BTreeMap<(usize, PathBuf), Stamp>;
+
+    fn root(path: &Path) -> Result<Root> {
+        let fd = fs::openat2(
+            CWD,
+            path,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::CLOEXEC,
+            Mode::empty(),
+            ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())?;
+        let stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+        Ok(Root {
+            path: path.to_owned(),
+            fd,
+            stamp,
+        })
+    }
+
+    fn open(root: &Root, path: &Path, flags: OFlags) -> Result<OwnedFd> {
+        let path = if path.as_os_str().is_empty() {
+            Path::new(".")
+        } else {
+            path
+        };
+        fs::openat2(
+            &root.fd,
+            path,
+            flags | OFlags::CLOEXEC | OFlags::NONBLOCK,
+            Mode::empty(),
+            ResolveFlags::BENEATH | ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())
+    }
+
+    fn manifest(roots: &[Root], limits: Limits) -> Result<Manifest> {
+        let mut result = BTreeMap::new();
+        let mut entries = 0usize;
+        let mut files = 0usize;
+        let mut bytes = 0u64;
+        for (index, root) in roots.iter().enumerate() {
+            let mut pending = vec![(PathBuf::new(), 0usize)];
+            while let Some((path, depth)) = pending.pop() {
+                if depth > limits.depth {
+                    return Err(unavailable());
+                }
+                let fd = open(root, &path, OFlags::RDONLY | OFlags::DIRECTORY)?;
+                let before: Stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+                result.insert((index, path.clone()), before.clone());
+                let directory = Dir::read_from(&fd).map_err(|_| unavailable())?;
+                for item in directory {
+                    let item = item.map_err(|_| unavailable())?;
+                    let name = item.file_name().to_bytes();
+                    if name == b"." || name == b".." {
+                        continue;
+                    }
+                    entries = entries.checked_add(1).ok_or_else(unavailable)?;
+                    if entries > limits.entries {
+                        return Err(unavailable());
+                    }
+                    let child = path.join(OsStr::from_bytes(name));
+                    let stat = fs::statat(&fd, item.file_name(), AtFlags::SYMLINK_NOFOLLOW)
+                        .map_err(|_| unavailable())?;
+                    match FileType::from_raw_mode(stat.st_mode) {
+                        FileType::Directory => pending.push((child, depth + 1)),
+                        FileType::RegularFile => {
+                            if child.extension().is_some_and(|ext| ext == "zst") {
+                                return Err(unavailable());
+                            }
+                            if child.extension().is_none_or(|ext| ext != "jsonl") {
+                                continue;
+                            }
+                            files = files.checked_add(1).ok_or_else(unavailable)?;
+                            let size = u64::try_from(stat.st_size).map_err(|_| unavailable())?;
+                            bytes = bytes.checked_add(size).ok_or_else(unavailable)?;
+                            if files > limits.files
+                                || size > limits.file_bytes
+                                || bytes > limits.total_bytes
+                            {
+                                return Err(unavailable());
+                            }
+                            result.insert((index, child), stat.into());
+                        }
+                        _ => return Err(unavailable()),
+                    }
+                }
+                if Stamp::from(fs::fstat(&fd).map_err(|_| unavailable())?) != before {
+                    return Err(unavailable());
+                }
+            }
+        }
+        Ok(result)
+    }
+
+    fn read_file(
+        root: &Root,
+        path: &Path,
+        expected: &Stamp,
+        content: &mut Vec<u8>,
+        after_read: impl FnOnce(),
+    ) -> Result<()> {
+        let mut file = File::from(open(root, path, OFlags::RDONLY)?);
+        if Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected {
+            return Err(unavailable());
+        }
+        content.clear();
+        content
+            .try_reserve_exact(expected.size as usize + 1)
+            .map_err(|_| unavailable())?;
+        (&mut file)
+            .take(expected.size as u64 + 1)
+            .read_to_end(content)
+            .map_err(|_| unavailable())?;
+        after_read();
+        if content.len() as u64 != expected.size as u64
+            || Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected
+        {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn read_with(
+        paths: &[PathBuf],
+        limits: Limits,
+        mut hook: impl FnMut(Stage),
+        mut visit: impl FnMut(&Path, &Path, &[u8]) -> Result<()>,
+    ) -> Result<()> {
+        if paths.len() > limits.roots {
+            return Err(unavailable());
+        }
+        let roots = paths
+            .iter()
+            .map(|path| root(path))
+            .collect::<Result<Vec<_>>>()?;
+        let before = manifest(&roots, limits)?;
+        hook(Stage::Discovered);
+        let files = before
+            .iter()
+            .filter(|(_, stamp)| FileType::from_raw_mode(stamp.mode) == FileType::RegularFile);
+        let mut digests = Vec::new();
+        let mut content = Vec::new();
+        for ((index, path), stamp) in files.clone() {
+            let selected = &roots[*index];
+            read_file(selected, path, stamp, &mut content, || {
+                hook(Stage::Read(digests.len()));
+            })?;
+            digests.push(digest::digest(&SHA256, &content));
+            visit(&selected.path.join(path), &selected.path, &content)?;
+        }
+
+        hook(Stage::BeforeVerify);
+        verify_roots(&roots)?;
+        // A same-size rewrite can escape a coarse timestamp. Recheck bytes before publication.
+        for (((index, path), stamp), expected_digest) in files.zip(digests) {
+            read_file(&roots[*index], path, stamp, &mut content, || {})?;
+            if digest::digest(&SHA256, &content).as_ref() != expected_digest.as_ref() {
+                return Err(unavailable());
+            }
+        }
+        if manifest(&roots, limits)? != before {
+            return Err(unavailable());
+        }
+        verify_roots(&roots)
+    }
+
+    fn verify_roots(roots: &[Root]) -> Result<()> {
+        for selected in roots {
+            if root(&selected.path)?.stamp != selected.stamp {
+                return Err(unavailable());
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::linux::{Limits, Stage, read_with};
+    use ccusage_test_support::Fixture;
+
+    #[test]
+    fn changed_selected_sources_never_publish_a_capture() {
+        for mutation in ["append", "rewrite", "replace", "remove", "new-peer"] {
+            let fixture = Fixture::new();
+            let root = fixture.create_dir_all("sessions");
+            let file = fixture.write_file("sessions/source.jsonl", "original\n");
+            let result = read_with(
+                std::slice::from_ref(&root),
+                Limits::default(),
+                |stage| {
+                    if stage != Stage::BeforeVerify {
+                        return;
+                    }
+                    match mutation {
+                        "append" => std::fs::write(&file, "original\nappended\n").unwrap(),
+                        "rewrite" => std::fs::write(&file, "modified\n").unwrap(),
+                        "replace" => {
+                            std::fs::remove_file(&file).unwrap();
+                            std::fs::write(&file, "original\n").unwrap();
+                        }
+                        "remove" => std::fs::remove_file(&file).unwrap(),
+                        "new-peer" => std::fs::write(root.join("peer.jsonl"), "new\n").unwrap(),
+                        _ => unreachable!(),
+                    }
+                },
+                |_, _, _| Ok(()),
+            );
+            assert!(result.is_err(), "{mutation}");
+        }
+    }
+
+    #[test]
+    fn capture_limits_are_joint_and_inclusive() {
+        let fixture = Fixture::new();
+        let root = fixture.create_dir_all("sessions");
+        let _ = fixture.write_file("sessions/a.jsonl", "1234");
+        let _ = fixture.write_file("sessions/b.jsonl", "1234");
+        let limits = Limits {
+            file_bytes: 4,
+            total_bytes: 8,
+            files: 2,
+            ..Limits::default()
+        };
+        assert!(
+            read_with(
+                std::slice::from_ref(&root),
+                limits,
+                |_| {},
+                |_, _, _| Ok(())
+            )
+            .is_ok()
+        );
+        for limits in [
+            Limits {
+                total_bytes: 7,
+                ..limits
+            },
+            Limits {
+                file_bytes: 3,
+                ..limits
+            },
+            Limits { files: 1, ..limits },
+        ] {
+            assert!(
+                read_with(
+                    std::slice::from_ref(&root),
+                    limits,
+                    |_| {},
+                    |_, _, _| Ok(())
+                )
+                .is_err()
+            );
+        }
+    }
+}
