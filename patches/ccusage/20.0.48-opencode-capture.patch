+fn is_source(path: &std::path::Path) -> bool {
+    if path.components().count() == 1 {
+        return path
+            .file_name()
+            .is_some_and(|name| database_name(name.as_encoded_bytes()));
+    }
+    path.starts_with("storage/message") && path.extension().is_some_and(|ext| ext == "json")
