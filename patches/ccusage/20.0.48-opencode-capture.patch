+#![cfg(target_os = "linux")]
+use crate::{
+    cli::{AgentReportKind, CostMode, SharedArgs},
+    loader::load_paths,
+};
+use ccusage_test_support::Fixture;
+use std::{fs, os::unix::fs::symlink, path::PathBuf};
+
+const MESSAGE: &str = r#"{"id":"message","sessionID":"session","modelID":"model","providerID":"provider","tokens":{"input":10,"output":5,"cache":{"read":0,"write":0},"total":15}}"#;
+
+fn load(paths: &[PathBuf]) -> crate::Result<Vec<crate::LinkedEntry>> {
+    load_paths(
+        paths,
+        &SharedArgs {
+            mode: CostMode::Display,
+            offline: true,
+            ..SharedArgs::default()
+        },
+        AgentReportKind::Session,
+    )
+}
+
+#[test]
+fn refuses_bad_peers_without_partial_results_or_source_details() {
+    for peer in [b"{".as_slice(), b"\xff", b"{\"id\":1,\"id\":2}", b"[]"] {
+        let fixture = Fixture::new();
+        let _ = fixture.write_file("storage/message/good.json", MESSAGE);
+        fs::write(fixture.path("storage/message/private-peer.json"), peer).unwrap();
+        let error = load(&[fixture.root().to_owned()]).unwrap_err().to_string();
+        assert_eq!(error, "OpenCode source capture is unavailable");
+    }
+}
+
+#[test]
+fn compares_source_identity_before_dedup_in_either_order() {
+    let first = Fixture::new();
+    let second = Fixture::new();
+    let _ = first.write_file("storage/message/one.json", MESSAGE);
+    let _ = second.write_file("storage/message/two.json", MESSAGE);
+    assert_eq!(
+        load(&[first.root().to_owned(), second.root().to_owned()])
+            .unwrap()
+            .len(),
+        1
+    );
+    let _ = second.write_file(
+        "storage/message/two.json",
+        MESSAGE.replace("\"input\":10", "\"input\":9"),
+    );
+    for paths in [
+        [first.root().to_owned(), second.root().to_owned()],
+        [second.root().to_owned(), first.root().to_owned()],
+    ] {
+        assert!(load(&paths).is_err());
+    }
+}
+
+#[test]
+fn validates_present_counts_and_does_not_guess_missing_buckets() {
+    for tokens in [
+        r#"{"input":10}"#,
+        r#"{"input":-1,"total":15}"#,
+        r#"{"input":1.5,"total":15}"#,
+        r#"{"input":"10","total":15}"#,
+        r#"{"input":null,"total":15}"#,
+        r#"{"input":16,"total":15}"#,
+        r#"{"cache":{"read":true},"total":15}"#,
+        r#"{"input":18446744073709551615,"output":1,"total":18446744073709551615}"#,
+    ] {
+        let fixture = Fixture::new();
+        let mut value: serde_json::Value = serde_json::from_str(MESSAGE).unwrap();
+        value["tokens"] = serde_json::from_str(tokens).unwrap();
+        let _ = fixture.write_file("storage/message/one.json", value.to_string());
+        assert!(load(&[fixture.root().to_owned()]).is_err(), "{tokens}");
+    }
+    let fixture = Fixture::new();
+    let _ = fixture.write_file("storage/message/one.json", r#"{"id":"one","sessionID":"session","modelID":"model","providerID":"provider","tokens":{"total":15}}"#);
+    let entries = load(&[fixture.root().to_owned()]).unwrap();
+    assert_eq!(entries[0].0.data.message.usage.output_tokens, 0);
+    assert_eq!(entries[0].0.extra_total_tokens, 15);
+}
+
+#[test]
+fn rejects_links_and_special_files_without_reading_them() {
+    for target in [
+        "storage",
+        "storage/message",
+        "storage/message/one.json",
+        "opencode.db",
+    ] {
+        let fixture = Fixture::new();
+        let outside = Fixture::new();
+        let _ = outside.write_file("marker", MESSAGE);
+        let path = fixture.path(target);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        symlink(outside.root(), path).unwrap();
+        assert!(load(&[fixture.root().to_owned()]).is_err());
+    }
+    let fixture = Fixture::new();
+    let directory = fixture.create_dir_all("storage/message");
+    rustix::fs::mkfifoat(
+        rustix::fs::CWD,
+        directory.join("pipe.json"),
+        rustix::fs::Mode::RUSR,
+    )
+    .unwrap();
+    assert!(load(&[fixture.root().to_owned()]).is_err());
+}
+
+#[test]
+fn rejects_committed_wal_and_checkpointed_wal_mode() {
+    let fixture = Fixture::new();
+    let db = sqlite::open(fixture.path("opencode.db")).unwrap();
+    db.execute(
+        "PRAGMA journal_mode=WAL; CREATE TABLE message(id TEXT, session_id TEXT, data TEXT)",
+    )
+    .unwrap();
+    let mut insert = db
+        .prepare("INSERT INTO message VALUES ('message','session',?1)")
+        .unwrap();
+    insert.bind((1, MESSAGE)).unwrap();
+    insert.next().unwrap();
+    assert!(fixture.path("opencode.db-wal").metadata().unwrap().len() > 0);
+    assert!(load(&[fixture.root().to_owned()]).is_err());
+    drop(insert);
+    drop(db);
+    assert!(!fixture.path("opencode.db-wal").exists());
+    assert!(load(&[fixture.root().to_owned()]).is_err());
+}
+
+#[test]
+fn rejects_every_journal_peer_even_when_empty() {
+    for suffix in ["-wal", "-shm", "-journal"] {
+        let fixture = Fixture::new();
+        let _ = fixture.write_file("storage/message/good.json", MESSAGE);
+        let _ = fixture.write_file(format!("opencode-beta.db{suffix}"), "");
+        assert!(load(&[fixture.root().to_owned()]).is_err());
+    }
+}
+
+#[test]
+fn rejects_file_and_root_replacements_and_changed_bytes() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    for change in 0..4 {
+        let fixture = Fixture::new();
+        let _ = fixture.write_file("root/storage/message/one.json", MESSAGE);
+        let selected = fixture.path("root");
+        let source = selected.join("storage/message/one.json");
+        let result = read_with(
+            std::slice::from_ref(&selected),
+            Limits::default(),
+            |stage| {
+                if stage != Stage::BeforeVerify {
+                    return;
+                }
+                match change {
+                    0 => {
+                        fs::write(&source, MESSAGE.replace("\"input\":10", "\"input\":11"))
+                            .unwrap();
+                    }
+                    1 => {
+                        fs::rename(&source, source.with_extension("old")).unwrap();
+                        fs::write(&source, MESSAGE).unwrap();
+                    }
+                    2 => {
+                        fs::rename(&selected, fixture.path("old-root")).unwrap();
+                        fs::create_dir(&selected).unwrap();
+                    }
+                    _ => {
+                        fs::write(selected.join("storage/message/new.json"), MESSAGE).unwrap();
+                    }
+                }
+            },
+            |_, _, _| Ok(()),
+        );
+        assert!(result.is_err());
+    }
+}
+
+#[test]
+fn checks_discovery_limits_jointly_across_roots() {
+    use crate::files::linux::{Limits, read_with};
+    let first = Fixture::new();
+    let second = Fixture::new();
+    for fixture in [&first, &second] {
+        let _ = fixture.write_file("storage/message/one.json", MESSAGE);
+    }
+    let paths = [first.root().to_owned(), second.root().to_owned()];
+    for limits in [
+        Limits {
+            roots: 1,
+            ..Limits::default()
+        },
+        Limits {
+            entries: 5,
+            ..Limits::default()
+        },
+        Limits {
+            files: 1,
+            ..Limits::default()
+        },
+        Limits {
+            depth: 1,
+            ..Limits::default()
+        },
+        Limits {
+            file_bytes: 1,
+            ..Limits::default()
+        },
+        Limits {
+            total_bytes: MESSAGE.len() as u64,
+            ..Limits::default()
+        },
+    ] {
+        assert!(read_with(&paths, limits, |_| {}, |_, _, _| Ok(())).is_err());
+    }
+}
+
+#[test]
+fn rejects_missing_roots_and_keeps_explicit_empty_roots() {
+    let fixture = Fixture::new();
+    assert!(load(&[fixture.path("missing")]).is_err());
+    assert!(load(&[fixture.root().to_owned()]).unwrap().is_empty());
+}
+
+#[test]
+fn rejects_invalid_sqlite_text_and_count_types() {
+    for sql in [
+        "CREATE TABLE session_v2 (id TEXT, tokens_input, tokens_output, tokens_cache_read, tokens_cache_write); INSERT INTO session_v2 VALUES ('session', '10', 5, 0, 0)",
+        "CREATE TABLE session_v2 (id TEXT, tokens_input, tokens_output, tokens_cache_read, tokens_cache_write); INSERT INTO session_v2 VALUES ('session', 10.5, 5, 0, 0)",
+    ] {
+        let fixture = Fixture::new();
+        sqlite::open(fixture.path("opencode.db"))
+            .unwrap()
+            .execute(sql)
+            .unwrap();
+        assert!(load(&[fixture.root().to_owned()]).is_err());
+    }
+}
+
+#[test]
+fn checks_overflow_after_covered_aggregates_are_removed() {
+    let fixture = Fixture::new();
+    let _ = fixture.write_file(
+        "storage/message/one.json",
+        r#"{"id":"one","sessionID":"session","tokens":{"total":18446744073709551615}}"#,
+    );
+    sqlite::open(fixture.path("opencode.db")).unwrap().execute("CREATE TABLE session_v2 (id TEXT, tokens_input, tokens_output, tokens_cache_read, tokens_cache_write); INSERT INTO session_v2 VALUES ('session', 1, 0, 0, 0)").unwrap();
+    let entries = load(&[fixture.root().to_owned()]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].0.extra_total_tokens, u64::MAX);
+    let _ = fixture.write_file(
+        "storage/message/two.json",
+        MESSAGE.replace("\"message\"", "\"another\""),
+    );
+    assert!(load(&[fixture.root().to_owned()]).is_err());
+}
