@@ -0,0 +1,492 @@
+fn parse_session_model(value: Option<&str>) -> Option<(String, String)> {
+    let value = value?.trim();
+    if value.is_empty() {
+        return None;
+    }
+    if let Ok(json) = serde_json::from_str::<serde_json::Value>(value) {
+        if let Some(model) = json
+            .as_str()
+            .map(str::trim)
+            .filter(|model| !model.is_empty())
+        {
+            return Some((model.to_string(), "unknown".to_string()));
+        }
+        if let Some(object) = json.as_object() {
+            let model = object
+                .get("id")
+                .and_then(serde_json::Value::as_str)
+                .or_else(|| object.get("modelID").and_then(serde_json::Value::as_str))
+                .map(str::trim)
+                .filter(|model| !model.is_empty())?;
+            let provider = object
+                .get("providerID")
+                .and_then(serde_json::Value::as_str)
+                .or_else(|| object.get("provider").and_then(serde_json::Value::as_str))
+                .map(str::trim)
+                .filter(|provider| !provider.is_empty())
+                .unwrap_or("unknown");
+            return Some((model.to_string(), provider.to_string()));
+        }
+    }
+    Some((value.to_string(), "unknown".to_string()))
+}
+
+use crate::{
+    Result,
+    loader::Context,
+    parser::{OpenCodeSessionAggregate, session_value_to_entry},
+    records::{Kind, MAX_RECORD_BYTES, identifier, validate},
+    unavailable,
+};
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, HashSet},
+    sync::Arc,
+};
+
+#[cfg(target_os = "linux")]
+pub(crate) fn read(bytes: &[u8], context: &mut Context<'_>) -> Result<()> {
+    // Never omit committed WAL pages. WAL databases and all journal peers are refused.
+    if bytes.len() < 100 || &bytes[..16] != b"SQLite format 3\0" || bytes[18..20] != [1, 1] {
+        return Err(unavailable());
+    }
+    super::sqlite_snapshot::with_connection(bytes, |db| {
+        for (kind, limit) in [
+            (sqlite3_sys::SQLITE_LIMIT_LENGTH, MAX_RECORD_BYTES as i32),
+            (sqlite3_sys::SQLITE_LIMIT_COLUMN, 256),
+            (sqlite3_sys::SQLITE_LIMIT_EXPR_DEPTH, 100),
+            (sqlite3_sys::SQLITE_LIMIT_VDBE_OP, 100_000),
+        ] {
+            // SAFETY: db remains live, and these documented limits take bounded nonnegative integers.
+            if unsafe { sqlite3_sys::sqlite3_limit(db.as_raw(), kind, limit) } < 0 {
+                return Err(unavailable());
+            }
+        }
+        db.execute("PRAGMA temp_store=MEMORY; PRAGMA cache_size=-8192; PRAGMA mmap_size=0; PRAGMA trusted_schema=OFF; PRAGMA query_only=ON; BEGIN")
+        .map_err(|_| unavailable())?;
+        read_connection(db, context)?;
+        db.execute("COMMIT").map_err(|_| unavailable())
+    })
+}
+
+#[cfg(not(target_os = "linux"))]
+pub(crate) fn read(_: &[u8], _: &mut Context<'_>) -> Result<()> {
+    Err(unavailable())
+}
+
+fn text(statement: &sqlite::Statement<'_>, index: usize) -> Result<String> {
+    if statement.column_type(index).map_err(|_| unavailable())? != sqlite::Type::String {
+        return Err(unavailable());
+    }
+    let bytes = statement
+        .read::<Vec<u8>, _>(index)
+        .map_err(|_| unavailable())?;
+    if bytes.len() > MAX_RECORD_BYTES {
+        return Err(unavailable());
+    }
+    String::from_utf8(bytes).map_err(|_| unavailable())
+}
+
+fn integer(statement: &sqlite::Statement<'_>, index: usize) -> Result<i64> {
+    if statement.column_type(index).map_err(|_| unavailable())? != sqlite::Type::Integer {
+        return Err(unavailable());
+    }
+    statement.read(index).map_err(|_| unavailable())
+}
+
+fn optional_integer(statement: &sqlite::Statement<'_>, index: usize) -> Result<Option<i64>> {
+    if statement.column_type(index).map_err(|_| unavailable())? == sqlite::Type::Null {
+        Ok(None)
+    } else {
+        integer(statement, index).map(Some)
+    }
+}
+
+fn optional_text(statement: &sqlite::Statement<'_>, index: usize) -> Result<Option<String>> {
+    if statement.column_type(index).map_err(|_| unavailable())? == sqlite::Type::Null {
+        Ok(None)
+    } else {
+        text(statement, index).map(Some)
+    }
+}
+
+fn prepare<'a>(db: &'a sqlite::Connection, sql: &str) -> Result<sqlite::Statement<'a>> {
+    db.prepare(sql).map_err(|_| unavailable())
+}
+
+fn next(statement: &mut sqlite::Statement<'_>) -> Result<bool> {
+    statement
+        .next()
+        .map(|state| state == sqlite::State::Row)
+        .map_err(|_| unavailable())
+}
+
+fn columns(db: &sqlite::Connection, table: &str) -> Result<HashSet<String>> {
+    let statement = prepare(db, &format!("SELECT * FROM {table} LIMIT 0"))?;
+    if statement.column_count() > 256 {
+        return Err(unavailable());
+    }
+    (0..statement.column_count())
+        .map(|index| {
+            statement
+                .column_name(index)
+                .map(str::to_owned)
+                .map_err(|_| unavailable())
+        })
+        .collect()
+}
+
+struct Row {
+    id: String,
+    session: String,
+    seq: Option<i64>,
+    value: Value,
+    native: Option<Arc<str>>,
+}
+
+fn read_connection(db: &sqlite::Connection, context: &mut Context<'_>) -> Result<()> {
+    let mut schema = prepare(db, "SELECT name, type, sql FROM sqlite_master LIMIT 1025")?;
+    let mut tables = HashSet::new();
+    let mut schema_count = 0;
+    while next(&mut schema)? {
+        schema_count += 1;
+        if schema_count > 1024 {
+            return Err(unavailable());
+        }
+        let name = text(&schema, 0)?;
+        if ["message", "session_message", "session", "session_v2"].contains(&name.as_str()) {
+            if text(&schema, 1)? != "table"
+                || !text(&schema, 2)?
+                    .to_ascii_uppercase()
+                    .starts_with("CREATE TABLE")
+            {
+                return Err(unavailable());
+            }
+            let mut info = prepare(db, &format!("PRAGMA table_xinfo({name})"))?;
+            let mut column_count = 0;
+            while next(&mut info)? {
+                column_count += 1;
+                if column_count > 256 || integer(&info, 6)? != 0 {
+                    return Err(unavailable());
+                }
+            }
+            tables.insert(name);
+        }
+    }
+    if !tables.contains("message")
+        && !tables.contains("session_message")
+        && !tables.contains("session_v2")
+    {
+        return Err(unavailable());
+    }
+    if tables.contains("message") {
+        let mut statement = prepare(db, "SELECT id, session_id, data FROM message LIMIT 100001")?;
+        while next(&mut statement)? {
+            context.records.count()?;
+            let id = text(&statement, 0)?;
+            let session = text(&statement, 1)?;
+            let mut value = super::strict_json::parse(text(&statement, 2)?.as_bytes())?;
+            let object = value.as_object_mut().ok_or_else(unavailable)?;
+            for (key, column) in [("id", id), ("sessionID", session)] {
+                if object
+                    .get(key)
+                    .is_some_and(|value| value.as_str() != Some(&column))
+                {
+                    return Err(unavailable());
+                }
+                object.insert(key.into(), Value::String(column));
+            }
+            context.message(value, None, false)?;
+        }
+    }
+    let mut rows = Vec::new();
+    if tables.contains("session_message") {
+        let cols = columns(db, "session_message")?;
+        let time = if cols.contains("time_created") {
+            "time_created"
+        } else {
+            "NULL"
+        };
+        let seq = if cols.contains("seq") { "seq" } else { "NULL" };
+        let mut statement = prepare(
+            db,
+            &format!(
+                "SELECT id, session_id, type, data, {time}, {seq} FROM session_message LIMIT 100001"
+            ),
+        )?;
+        while next(&mut statement)? {
+            context.records.count()?;
+            let id = text(&statement, 0)?;
+            let session = text(&statement, 1)?;
+            let role = text(&statement, 2)?;
+            let data = text(&statement, 3)?;
+            let created = optional_integer(&statement, 4)?;
+            let seq = optional_integer(&statement, 5)?;
+            let mut value = super::strict_json::parse(data.as_bytes())?;
+            let object = value.as_object_mut().ok_or_else(unavailable)?;
+            object.insert("id".into(), id.clone().into());
+            object.insert("sessionID".into(), session.clone().into());
+            object.insert("role".into(), role.into());
+            if let Some(model) = object.remove("model") {
+                let model = model.as_object().ok_or_else(unavailable)?;
+                for (source, destination) in [
+                    ("id", "modelID"),
+                    ("modelID", "modelID"),
+                    ("providerID", "providerID"),
+                ] {
+                    if let Some(field) = model.get(source) {
+                        identifier(Some(field))?;
+                        if object
+                            .get(destination)
+                            .is_some_and(|previous| previous != field)
+                        {
+                            return Err(unavailable());
+                        }
+                        object.insert(destination.into(), field.clone());
+                    }
+                }
+            }
+            if !object.contains_key("time")
+                && let Some(created) = created
+            {
+                object.insert("time".into(), json!({"created": created}));
+            }
+            validate(&value)?;
+            let native = if value["providerID"] == "claude-agent" {
+                super::parser::native_session_id(&data)
+            } else {
+                None
+            };
+            rows.push(Row {
+                id,
+                session,
+                seq,
+                value,
+                native,
+            });
+        }
+    }
+    let inherited = fork_copies(db, &tables, &rows, context)?;
+    for (index, row) in rows.into_iter().enumerate() {
+        context.message(row.value, row.native, inherited.contains(&index))?;
+    }
+    for table in ["session_v2", "session"] {
+        if tables.contains(table) {
+            aggregates(db, table, context)?;
+        }
+    }
+    Ok(())
+}
+
+fn fork_copies(
+    db: &sqlite::Connection,
+    tables: &HashSet<String>,
+    rows: &[Row],
+    context: &mut Context<'_>,
+) -> Result<HashSet<usize>> {
+    let mut inherited = HashSet::new();
+    if !tables.contains("session_v2") {
+        return Ok(inherited);
+    }
+    let cols = columns(db, "session_v2")?;
+    if !cols.contains("fork_session_id") && !cols.contains("fork_boundary") {
+        return Ok(inherited);
+    }
+    if !cols.contains("fork_session_id") || !cols.contains("fork_boundary") {
+        return Err(unavailable());
+    }
+    let mut ids = BTreeMap::new();
+    let mut seqs = BTreeMap::new();
+    for (index, row) in rows.iter().enumerate() {
+        if ids
+            .insert((row.session.as_str(), row.id.as_str()), index)
+            .is_some()
+        {
+            return Err(unavailable());
+        }
+        if let Some(seq) = row.seq
+            && (seq < 0 || seqs.insert((row.session.as_str(), seq), index).is_some())
+        {
+            return Err(unavailable());
+        }
+    }
+    let mut forks = BTreeMap::new();
+    let mut statement = prepare(
+        db,
+        "SELECT id, fork_session_id, fork_boundary FROM session_v2 LIMIT 100001",
+    )?;
+    while next(&mut statement)? {
+        context.records.count()?;
+        let id = text(&statement, 0)?;
+        let parent = optional_text(&statement, 1)?;
+        let boundary = optional_text(&statement, 2)?;
+        let (parent, boundary) = match (parent, boundary) {
+            (None, None) => continue,
+            (Some(parent), Some(boundary)) => (parent, boundary),
+            _ => return Err(unavailable()),
+        };
+        identifier(Some(&Value::String(id.clone())))?;
+        identifier(Some(&Value::String(parent.clone())))?;
+        let boundary = super::strict_json::parse(boundary.as_bytes())?;
+        context.records.insert(
+            &json!({"id": id, "sessionID": id, "parent": parent, "boundary": boundary}),
+            None,
+            Kind::Fork,
+        )?;
+        let boundary_id = identifier(boundary.get("messageID"))?;
+        let row = rows
+            .get(
+                *ids.get(&(parent.as_str(), boundary_id))
+                    .ok_or_else(unavailable)?,
+            )
+            .ok_or_else(unavailable)?;
+        let seq = row.seq.ok_or_else(unavailable)?;
+        let cutoff = match boundary.get("type").and_then(Value::as_str) {
+            Some("through") => Some(seq),
+            Some("before") => seqs
+                .range((parent.as_str(), i64::MIN)..(parent.as_str(), seq))
+                .next_back()
+                .map(|((_, seq), _)| *seq),
+            _ => return Err(unavailable()),
+        };
+        if forks.insert(id, (parent, cutoff)).is_some() {
+            return Err(unavailable());
+        }
+    }
+    // Resolve chains before suppression. A cycle or excessive chain is not source identity.
+    for id in forks.keys() {
+        let mut seen = HashSet::new();
+        let mut current = id;
+        while let Some((parent, _)) = forks.get(current) {
+            if !seen.insert(current) || seen.len() > 64 {
+                return Err(unavailable());
+            }
+            current = parent;
+        }
+    }
+    for (index, row) in rows.iter().enumerate() {
+        let Some((parent, cutoff)) = forks.get(&row.session) else {
+            continue;
+        };
+        let seq = row.seq.ok_or_else(unavailable)?;
+        if cutoff.is_some_and(|cutoff| seq <= cutoff) {
+            let parent = &rows[*seqs.get(&(parent.as_str(), seq)).ok_or_else(unavailable)?];
+            let mut copy = row.value.clone();
+            let mut original = parent.value.clone();
+            for value in [&mut copy, &mut original] {
+                let object = value.as_object_mut().ok_or_else(unavailable)?;
+                object.remove("id");
+                object.remove("sessionID");
+            }
+            if copy != original {
+                return Err(unavailable());
+            }
+            inherited.insert(index);
+        }
+    }
+    Ok(inherited)
+}
+
+fn aggregates(db: &sqlite::Connection, table: &str, context: &mut Context<'_>) -> Result<()> {
+    let cols = columns(db, table)?;
+    let required = [
+        "tokens_input",
+        "tokens_output",
+        "tokens_cache_read",
+        "tokens_cache_write",
+    ];
+    if !required.iter().any(|column| cols.contains(*column)) {
+        return Ok(());
+    }
+    if !required.iter().all(|column| cols.contains(*column)) {
+        return Err(unavailable());
+    }
+    let reasoning = if cols.contains("tokens_reasoning") {
+        "tokens_reasoning"
+    } else {
+        "0"
+    };
+    let model = if cols.contains("model") {
+        "model"
+    } else {
+        "NULL"
+    };
+    let time = if cols.contains("time_created") {
+        "time_created"
+    } else {
+        "NULL"
+    };
+    let cost = if cols.contains("cost") {
+        "cost"
+    } else {
+        "NULL"
+    };
+    let mut statement = prepare(
+        db,
+        &format!(
+            "SELECT id, {time}, {cost}, tokens_input, tokens_output, tokens_cache_read, tokens_cache_write, {reasoning}, {model} FROM {table} LIMIT 100001"
+        ),
+    )?;
+    while next(&mut statement)? {
+        context.records.count()?;
+        let id = text(&statement, 0)?;
+        identifier(Some(&Value::String(id.clone())))?;
+        let counts = (3..8)
+            .map(|index| optional_integer(&statement, index))
+            .collect::<Result<Vec<_>>>()?;
+        // A metadata-only session row does not claim any token observation.
+        if counts[..4].iter().all(Option::is_none) && counts[4].is_none_or(|count| count == 0) {
+            continue;
+        }
+        let counts = counts
+            .into_iter()
+            .map(|count| {
+                count
+                    .and_then(|count| u64::try_from(count).ok())
+                    .ok_or_else(unavailable)
+            })
+            .collect::<Result<Vec<_>>>()?;
+        let total = counts.iter().try_fold(0u64, |sum, count| {
+            sum.checked_add(*count).ok_or_else(unavailable)
+        })?;
+        let created = optional_integer(&statement, 1)?.unwrap_or(0);
+        if created < 0 {
+            return Err(unavailable());
+        }
+        let cost = match statement.column_type(2).map_err(|_| unavailable())? {
+            sqlite::Type::Null => None,
+            sqlite::Type::Integer | sqlite::Type::Float => {
+                Some(statement.read::<f64, _>(2).map_err(|_| unavailable())?)
+                    .filter(|cost| cost.is_finite() && *cost >= 0.0)
+                    .ok_or_else(unavailable)
+                    .map(Some)?
+            }
+            _ => return Err(unavailable()),
+        };
+        let raw_model = optional_text(&statement, 8)?;
+        let (model, provider) = parse_session_model(raw_model.as_deref())
+            .unwrap_or_else(|| ("unknown".into(), "unknown".into()));
+        let canonical = json!({"id": id, "sessionID": id, "time": created, "cost": cost, "model": raw_model,
+            "tokens": counts, "total": total});
+        let entry = session_value_to_entry(
+            OpenCodeSessionAggregate {
+                session_id: id,
+                created,
+                model,
+                provider,
+                input_tokens: counts[0],
+                output_tokens: counts[1],
+                cache_read_tokens: counts[2],
+                cache_write_tokens: counts[3],
+                reasoning_tokens: counts[4],
+                cost,
+            },
+            context.tz,
+            context.mode,
+            context.pricing,
+        )
+        .map(|entry| (entry, None));
+        context.records.insert(&canonical, entry, Kind::Aggregate)?;
+    }
+    Ok(())
+}
diff --git a/rust/adapters/opencode/src/files.rs b/rust/adapters/opencode/src/files.rs
new file mode 100644
index 0000000..01b3672
--- /dev/null
+++ b/rust/adapters/opencode/src/files.rs
@@ -0,0 +1,298 @@
+use std::path::PathBuf;
+
+use crate::Result;
+
+pub(crate) const MAX_ROOTS: usize = 64;
+pub(crate) const MAX_RECORDS: usize = 100_000;
+
+pub(crate) fn read(
+    paths: &[PathBuf],
+    visit: impl FnMut(&std::path::Path, &std::path::Path, &[u8]) -> Result<()>,
+) -> Result<()> {
+    if paths.is_empty() {
+        return Ok(());
+    }
+    #[cfg(target_os = "linux")]
+    {
+        linux::read_with(paths, linux::Limits::default(), |_| {}, visit)
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = visit;
+        Err(super::unavailable())
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) mod linux {
+    use super::super::unavailable;
+    use crate::Result;
+    use rustix::{
+        fd::OwnedFd,
+        fs::{self, AtFlags, CWD, Dir, FileType, Mode, OFlags, ResolveFlags, Stat},
+    };
+    use std::{
+        collections::BTreeMap,
+        ffi::OsStr,
+        fs::File,
+        io::Read,
+        os::unix::ffi::OsStrExt,
+        path::{Path, PathBuf},
+    };
+
+    #[derive(Clone, Copy)]
+    pub(crate) struct Limits {
+        pub roots: usize,
+        pub entries: usize,
+        pub files: usize,
+        pub depth: usize,
+        pub file_bytes: u64,
+        pub total_bytes: u64,
+    }
+
+    impl Default for Limits {
+        fn default() -> Self {
+            Self {
+                roots: super::MAX_ROOTS,
+                entries: 32768,
+                files: 8192,
+                depth: 64,
+                file_bytes: 64 << 20,
+                total_bytes: 256 << 20,
+            }
+        }
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub(crate) enum Stage {
+        Discovered,
+        Read(usize),
+        BeforeVerify,
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    struct Stamp {
+        device: u64,
+        inode: u64,
+        mode: u32,
+        size: i64,
+        modified: (i128, i128),
+        changed: (i128, i128),
+    }
+
+    impl From<Stat> for Stamp {
+        fn from(stat: Stat) -> Self {
+            Self {
+                device: stat.st_dev,
+                inode: stat.st_ino,
+                mode: stat.st_mode,
+                size: stat.st_size,
+                modified: (stat.st_mtime.into(), stat.st_mtime_nsec.into()),
+                changed: (stat.st_ctime.into(), stat.st_ctime_nsec.into()),
+            }
+        }
+    }
+
+    struct Root {
+        path: PathBuf,
+        fd: OwnedFd,
+        stamp: Stamp,
+    }
+    type Manifest = BTreeMap<(usize, PathBuf), Stamp>;
+
+    fn root(path: &Path) -> Result<Root> {
+        let fd = fs::openat2(
+            CWD,
+            path,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::CLOEXEC,
+            Mode::empty(),
+            ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())?;
+        let stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+        Ok(Root {
+            path: path.to_owned(),
+            fd,
+            stamp,
+        })
+    }
+
+    fn open(root: &Root, path: &Path, flags: OFlags) -> Result<OwnedFd> {
+        let path = if path.as_os_str().is_empty() {
+            Path::new(".")
+        } else {
+            path
+        };
+        fs::openat2(
+            &root.fd,
+            path,
+            flags | OFlags::CLOEXEC | OFlags::NONBLOCK,
+            Mode::empty(),
+            ResolveFlags::BENEATH | ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())
+    }
+
+    fn manifest(roots: &[Root], limits: Limits) -> Result<Manifest> {
+        let mut result = BTreeMap::new();
+        let mut entries = 0usize;
+        let mut files = 0usize;
+        let mut bytes = 0u64;
+        for (index, root) in roots.iter().enumerate() {
+            let mut pending = vec![(PathBuf::new(), 0usize)];
+            while let Some((path, depth)) = pending.pop() {
+                if depth > limits.depth {
+                    return Err(unavailable());
+                }
+                let fd = open(root, &path, OFlags::RDONLY | OFlags::DIRECTORY)?;
+                let before: Stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+                result.insert((index, path.clone()), before.clone());
+                let directory = Dir::read_from(&fd).map_err(|_| unavailable())?;
+                for item in directory {
+                    let item = item.map_err(|_| unavailable())?;
+                    let name = item.file_name().to_bytes();
+                    if name == b"." || name == b".." {
+                        continue;
+                    }
+                    entries = entries.checked_add(1).ok_or_else(unavailable)?;
+                    if entries > limits.entries {
+                        return Err(unavailable());
+                    }
+                    let child = path.join(OsStr::from_bytes(name));
+                    if path.as_os_str().is_empty() && super::super::database_peer(name) {
+                        return Err(unavailable());
+                    }
+                    let selected = if path.as_os_str().is_empty() {
+                        name == b"storage" || super::super::database_name(name)
+                    } else if path == Path::new("storage") {
+                        name == b"message"
+                    } else {
+                        true
+                    };
+                    if !selected {
+                        continue;
+                    }
+                    let stat = fs::statat(&fd, item.file_name(), AtFlags::SYMLINK_NOFOLLOW)
+                        .map_err(|_| unavailable())?;
+                    match FileType::from_raw_mode(stat.st_mode) {
+                        FileType::Directory => {
+                            if super::super::is_source(&child) {
+                                return Err(unavailable());
+                            }
+                            pending.push((child, depth + 1));
+                        }
+                        FileType::RegularFile => {
+                            if child == Path::new("storage")
+                                || child == Path::new("storage/message")
+                                || stat.st_nlink != 1
+                            {
+                                return Err(unavailable());
+                            }
+                            if !super::super::is_source(&child) {
+                                continue;
+                            }
+                            files = files.checked_add(1).ok_or_else(unavailable)?;
+                            let size = u64::try_from(stat.st_size).map_err(|_| unavailable())?;
+                            bytes = bytes.checked_add(size).ok_or_else(unavailable)?;
+                            if files > limits.files
+                                || size > limits.file_bytes
+                                || (child.extension().is_some_and(|ext| ext == "json")
+                                    && size > 1 << 20)
+                                || bytes > limits.total_bytes
+                            {
+                                return Err(unavailable());
+                            }
+                            result.insert((index, child), stat.into());
+                        }
+                        _ => return Err(unavailable()),
+                    }
+                }
+                if Stamp::from(fs::fstat(&fd).map_err(|_| unavailable())?) != before {
+                    return Err(unavailable());
+                }
+            }
+        }
+        Ok(result)
+    }
+
+    fn read_file(
+        root: &Root,
+        path: &Path,
+        expected: &Stamp,
+        content: &mut Vec<u8>,
+        after_read: impl FnOnce(),
+    ) -> Result<()> {
+        let mut file = File::from(open(root, path, OFlags::RDONLY)?);
+        if Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected {
+            return Err(unavailable());
+        }
+        content.clear();
+        content
+            .try_reserve_exact(expected.size as usize + 1)
+            .map_err(|_| unavailable())?;
+        (&mut file)
+            .take(expected.size as u64 + 1)
+            .read_to_end(content)
+            .map_err(|_| unavailable())?;
+        after_read();
+        if content.len() as u64 != expected.size as u64
+            || Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected
+        {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn read_with(
+        paths: &[PathBuf],
+        limits: Limits,
+        mut hook: impl FnMut(Stage),
+        mut visit: impl FnMut(&Path, &Path, &[u8]) -> Result<()>,
+    ) -> Result<()> {
+        if paths.len() > limits.roots {
+            return Err(unavailable());
+        }
+        let roots = paths
+            .iter()
+            .map(|path| root(path))
+            .collect::<Result<Vec<_>>>()?;
+        let before = manifest(&roots, limits)?;
+        hook(Stage::Discovered);
+        let files = before
+            .iter()
+            .filter(|(_, stamp)| FileType::from_raw_mode(stamp.mode) == FileType::RegularFile);
+        let mut captured = Vec::new();
+        let mut content = Vec::new();
+        for ((index, path), stamp) in files.clone() {
+            let selected = &roots[*index];
+            read_file(selected, path, stamp, &mut content, || {
+                hook(Stage::Read(captured.len()));
+            })?;
+            visit(path, &selected.path, &content)?;
+            captured.push(std::mem::take(&mut content));
+        }
+
+        hook(Stage::BeforeVerify);
+        verify_roots(&roots)?;
+        // A same-size rewrite can escape a coarse timestamp. Recheck bytes before publication.
+        for (((index, path), stamp), expected_bytes) in files.zip(captured) {
+            read_file(&roots[*index], path, stamp, &mut content, || {})?;
+            if content != expected_bytes {
+                return Err(unavailable());
+            }
+        }
+        if manifest(&roots, limits)? != before {
+            return Err(unavailable());
+        }
+        verify_roots(&roots)
+    }
+
+    fn verify_roots(roots: &[Root]) -> Result<()> {
+        for selected in roots {
+            if root(&selected.path)?.stamp != selected.stamp {
+                return Err(unavailable());
+            }
+        }
+        Ok(())
+    }
+}
