diff --git a/rust/adapters/opencode/src/sqlite_snapshot.rs b/rust/adapters/opencode/src/sqlite_snapshot.rs
new file mode 100644
index 0000000..06cf4ab
--- /dev/null
+++ b/rust/adapters/opencode/src/sqlite_snapshot.rs
@@ -0,0 +1,355 @@
+//! A private, immutable SQLite VFS. No callback accesses the operating system.
+use crate::{Result, unavailable};
+use sqlite3_sys as ffi;
+use std::{
+    ffi::{CStr, CString, c_char, c_int, c_void},
+    marker::PhantomData,
+    ptr,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+static NEXT_NAME: AtomicU64 = AtomicU64::new(0);
+const DATABASE: &[u8] = b"captured.db\0";
+
+struct Image {
+    data: *const u8,
+    length: usize,
+}
+
+#[repr(C)]
+struct MemoryFile {
+    base: ffi::sqlite3_file,
+    image: *const Image,
+}
+
+struct Registration<'a> {
+    vfs: Box<ffi::sqlite3_vfs>,
+    _name: CString,
+    _image: Box<Image>,
+    _bytes: PhantomData<&'a [u8]>,
+    registered: bool,
+}
+
+impl Drop for Registration<'_> {
+    fn drop(&mut self) {
+        if self.registered {
+            // SAFETY: this registration owns the stable VFS address. Its connection already closed.
+            // SQLite unregisters even when an earlier operation returned an error.
+            unsafe {
+                ffi::sqlite3_vfs_unregister(&mut *self.vfs);
+            }
+        }
+    }
+}
+
+pub(crate) fn with_connection<T>(
+    bytes: &[u8],
+    visit: impl FnOnce(&sqlite::Connection) -> Result<T>,
+) -> Result<T> {
+    let sequence = NEXT_NAME
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+            value.checked_add(1)
+        })
+        .map_err(|_| unavailable())?;
+    let name = CString::new(format!("opencode-capture-{sequence}")).map_err(|_| unavailable())?;
+    let mut image = Box::new(Image {
+        data: bytes.as_ptr(),
+        length: bytes.len(),
+    });
+    // SAFETY: the C VFS structure consists of integers, raw pointers, and nullable function pointers.
+    let mut vfs: Box<ffi::sqlite3_vfs> = Box::new(unsafe { std::mem::zeroed() });
+    vfs.iVersion = 1;
+    vfs.szOsFile = c_int::try_from(std::mem::size_of::<MemoryFile>()).map_err(|_| unavailable())?;
+    vfs.mxPathname = 64;
+    vfs.zName = name.as_ptr();
+    vfs.pAppData = (&mut *image as *mut Image).cast();
+    vfs.xOpen = Some(open);
+    vfs.xDelete = Some(delete);
+    vfs.xAccess = Some(access);
+    vfs.xFullPathname = Some(full_path);
+    vfs.xRandomness = Some(randomness);
+    vfs.xSleep = Some(sleep);
+    vfs.xCurrentTime = Some(current_time);
+    let mut registration = Registration {
+        vfs,
+        _name: name,
+        _image: image,
+        _bytes: PhantomData,
+        registered: false,
+    };
+    // SAFETY: all pointed-to allocations remain stable until after unregister. This is never the default VFS.
+    if unsafe { ffi::sqlite3_vfs_register(&mut *registration.vfs, 0) } != ffi::SQLITE_OK {
+        return Err(unavailable());
+    }
+    registration.registered = true;
+    // The borrowed bytes outlive this function. The connection closes its MemoryFile before unregister,
+    // then registration drops the VFS, its name, and its Image. Error returns use the same drop order.
+    let connection = sqlite::Connection::open_with_flags_and_vfs(
+        "captured.db",
+        sqlite::OpenFlags::new().with_read_only(),
+        Some(registration._name.to_str().map_err(|_| unavailable())?),
+    )
+    .map_err(|_| unavailable())?;
+    let result = visit(&connection);
+    drop(connection);
+    // SAFETY: no connection or MemoryFile can refer to this VFS after the explicit drop above.
+    if unsafe { ffi::sqlite3_vfs_unregister(&mut *registration.vfs) } != ffi::SQLITE_OK {
+        return Err(unavailable());
+    }
+    registration.registered = false;
+    result
+}
+
+// All callbacks receive SQLite-owned pointers under its VFS ABI. They allocate no memory and never panic.
+unsafe extern "C" fn open(
+    vfs: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    file: *mut ffi::sqlite3_file,
+    flags: c_int,
+    out_flags: *mut c_int,
+) -> c_int {
+    if vfs.is_null() || file.is_null() || name.is_null() {
+        return ffi::SQLITE_CANTOPEN;
+    }
+    // SAFETY: SQLite supplies a NUL-terminated name, a live VFS, and szOsFile bytes aligned for a file.
+    unsafe {
+        (*file).pMethods = ptr::null();
+        if flags != ffi::SQLITE_OPEN_MAIN_DB | ffi::SQLITE_OPEN_READONLY
+            || CStr::from_ptr(name).to_bytes_with_nul() != DATABASE
+        {
+            return ffi::SQLITE_CANTOPEN;
+        }
+        ptr::write(
+            file.cast::<MemoryFile>(),
+            MemoryFile {
+                base: ffi::sqlite3_file { pMethods: &METHODS },
+                image: (*vfs).pAppData.cast(),
+            },
+        );
+        if !out_flags.is_null() {
+            *out_flags = ffi::SQLITE_OPEN_READONLY;
+        }
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn close(file: *mut ffi::sqlite3_file) -> c_int {
+    // SAFETY: SQLite closes only a MemoryFile opened by this VFS. The borrowed Image stays with registration.
+    unsafe {
+        (*file).pMethods = ptr::null();
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn read(
+    file: *mut ffi::sqlite3_file,
+    output: *mut c_void,
+    amount: c_int,
+    offset: i64,
+) -> c_int {
+    let (Ok(amount), Ok(offset)) = (usize::try_from(amount), usize::try_from(offset)) else {
+        return ffi::SQLITE_IOERR_READ;
+    };
+    if output.is_null() || file.is_null() {
+        return ffi::SQLITE_IOERR_READ;
+    }
+    // SAFETY: SQLite supplies amount writable bytes. MemoryFile points at the live, immutable capture.
+    unsafe {
+        let image = &*(*file.cast::<MemoryFile>()).image;
+        let available = image.length.saturating_sub(offset).min(amount);
+        ptr::write_bytes(output.cast::<u8>(), 0, amount);
+        if available > 0 {
+            ptr::copy_nonoverlapping(image.data.add(offset), output.cast(), available);
+        }
+        if available == amount {
+            ffi::SQLITE_OK
+        } else {
+            ffi::SQLITE_IOERR_SHORT_READ
+        }
+    }
+}
+unsafe extern "C" fn write(_: *mut ffi::sqlite3_file, _: *const c_void, _: c_int, _: i64) -> c_int {
+    ffi::SQLITE_READONLY
+}
+unsafe extern "C" fn truncate(_: *mut ffi::sqlite3_file, _: i64) -> c_int {
+    ffi::SQLITE_READONLY
+}
+unsafe extern "C" fn sync(_: *mut ffi::sqlite3_file, _: c_int) -> c_int {
+    ffi::SQLITE_READONLY
+}
+unsafe extern "C" fn file_size(file: *mut ffi::sqlite3_file, output: *mut i64) -> c_int {
+    // SAFETY: SQLite supplies a live MemoryFile and writable output. Captures are at most 64 MiB.
+    unsafe {
+        let Ok(length) = i64::try_from((*(*file.cast::<MemoryFile>()).image).length) else {
+            return ffi::SQLITE_IOERR_FSTAT;
+        };
+        *output = length;
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn lock(_: *mut ffi::sqlite3_file, _: c_int) -> c_int {
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn reserved(_: *mut ffi::sqlite3_file, output: *mut c_int) -> c_int {
+    // SAFETY: SQLite supplies writable output. A private immutable image has no writer.
+    unsafe {
+        *output = 0;
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn control(_: *mut ffi::sqlite3_file, _: c_int, _: *mut c_void) -> c_int {
+    ffi::SQLITE_NOTFOUND
+}
+unsafe extern "C" fn sector(_: *mut ffi::sqlite3_file) -> c_int {
+    4096
+}
+unsafe extern "C" fn characteristics(_: *mut ffi::sqlite3_file) -> c_int {
+    ffi::SQLITE_IOCAP_IMMUTABLE
+}
+unsafe extern "C" fn delete(_: *mut ffi::sqlite3_vfs, _: *const c_char, _: c_int) -> c_int {
+    ffi::SQLITE_READONLY
+}
+unsafe extern "C" fn access(
+    _: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    flags: c_int,
+    output: *mut c_int,
+) -> c_int {
+    if name.is_null() || output.is_null() {
+        return ffi::SQLITE_IOERR_ACCESS;
+    }
+    // SAFETY: SQLite supplies a NUL-terminated name and writable output. Sidecars never exist in this VFS.
+    unsafe {
+        *output = c_int::from(
+            flags != ffi::SQLITE_ACCESS_READWRITE
+                && CStr::from_ptr(name).to_bytes_with_nul() == DATABASE,
+        );
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn full_path(
+    _: *mut ffi::sqlite3_vfs,
+    name: *const c_char,
+    size: c_int,
+    output: *mut c_char,
+) -> c_int {
+    if name.is_null() || output.is_null() || size < DATABASE.len() as c_int {
+        return ffi::SQLITE_CANTOPEN;
+    }
+    // SAFETY: SQLite supplies a NUL-terminated name and size writable bytes. Only the private literal is accepted.
+    unsafe {
+        if CStr::from_ptr(name).to_bytes_with_nul() != DATABASE {
+            return ffi::SQLITE_CANTOPEN;
+        }
+        ptr::copy_nonoverlapping(DATABASE.as_ptr().cast::<c_char>(), output, DATABASE.len());
+    }
+    ffi::SQLITE_OK
+}
+unsafe extern "C" fn randomness(_: *mut ffi::sqlite3_vfs, _: c_int, _: *mut c_char) -> c_int {
+    0
+}
+unsafe extern "C" fn sleep(_: *mut ffi::sqlite3_vfs, _: c_int) -> c_int {
+    0
+}
+unsafe extern "C" fn current_time(_: *mut ffi::sqlite3_vfs, _: *mut f64) -> c_int {
+    ffi::SQLITE_ERROR
+}
+
+static METHODS: ffi::sqlite3_io_methods = ffi::sqlite3_io_methods {
+    iVersion: 1,
+    xClose: Some(close),
+    xRead: Some(read),
+    xWrite: Some(write),
+    xTruncate: Some(truncate),
+    xSync: Some(sync),
+    xFileSize: Some(file_size),
+    xLock: Some(lock),
+    xUnlock: Some(lock),
+    xCheckReservedLock: Some(reserved),
+    xFileControl: Some(control),
+    xSectorSize: Some(sector),
+    xDeviceCharacteristics: Some(characteristics),
+    xShmMap: None,
+    xShmLock: None,
+    xShmBarrier: None,
+    xShmUnmap: None,
+    xFetch: None,
+    xUnfetch: None,
+};
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn allows_only_the_captured_read_only_main_image() {
+        let fixture = ccusage_test_support::Fixture::new();
+        let source = fixture.path("source.db");
+        sqlite::open(&source)
+            .unwrap()
+            .execute("CREATE TABLE observation(value INTEGER); INSERT INTO observation VALUES (7)")
+            .unwrap();
+        let bytes = std::fs::read(source).unwrap();
+        let outside = fixture.path("never-created.db");
+        with_connection(&bytes, |db| {
+            let mut statement = db.prepare("SELECT value FROM observation").unwrap();
+            assert_eq!(statement.next().unwrap(), sqlite::State::Row);
+            assert_eq!(statement.read::<i64, _>(0).unwrap(), 7);
+            drop(statement);
+            assert!(db.execute("UPDATE observation SET value = 8").is_err());
+            assert!(db.execute("CREATE TABLE forbidden(value INTEGER)").is_err());
+            let mut attach = db.prepare("ATTACH DATABASE ?1 AS outside").unwrap();
+            attach.bind((1, outside.to_str().unwrap())).unwrap();
+            assert!(attach.next().is_err());
+            Ok(())
+        })
+        .unwrap();
+        assert!(!outside.exists());
+        // The file interface itself rejects temp/sidecar opens, even when SQLite omits query-only PRAGMAs.
+        let mut image = Image {
+            data: bytes.as_ptr(),
+            length: bytes.len(),
+        };
+        // SAFETY: these test structures have the exact C ABI and live for every callback below.
+        let mut vfs: ffi::sqlite3_vfs = unsafe { std::mem::zeroed() };
+        vfs.pAppData = (&mut image as *mut Image).cast();
+        for flags in [
+            ffi::SQLITE_OPEN_TEMP_DB,
+            ffi::SQLITE_OPEN_TEMP_JOURNAL,
+            ffi::SQLITE_OPEN_MAIN_JOURNAL,
+            ffi::SQLITE_OPEN_WAL,
+            ffi::SQLITE_OPEN_MAIN_DB | ffi::SQLITE_OPEN_READWRITE,
+        ] {
+            let mut file = MemoryFile {
+                base: ffi::sqlite3_file {
+                    pMethods: ptr::null(),
+                },
+                image: ptr::null(),
+            };
+            // SAFETY: file is a complete writable MemoryFile and the literal is NUL-terminated.
+            assert_eq!(
+                unsafe {
+                    open(
+                        &mut vfs,
+                        c"captured.db".as_ptr(),
+                        &mut file.base,
+                        flags,
+                        ptr::null_mut(),
+                    )
+                },
+                ffi::SQLITE_CANTOPEN
+            );
+            assert!(file.base.pMethods.is_null());
+        }
+        // SAFETY: delete does not dereference its arguments or access any filesystem.
+        assert_eq!(
+            unsafe { delete(&mut vfs, c"captured.db".as_ptr(), 0) },
+            ffi::SQLITE_READONLY
+        );
+        // A failed visitor closes its connection and unregisters before the next capture starts.
+        assert!(with_connection(&bytes, |_| Err::<(), _>(unavailable())).is_err());
+        with_connection(&bytes, |db| {
+            db.execute("SELECT * FROM observation")
+                .map_err(|_| unavailable())
+        })
+        .unwrap();
+    }
+}
