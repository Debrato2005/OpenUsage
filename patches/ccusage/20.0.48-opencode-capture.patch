diff --git a/rust/adapters/opencode/src/records.rs b/rust/adapters/opencode/src/records.rs
new file mode 100644
index 0000000..6c7b91f
--- /dev/null
+++ b/rust/adapters/opencode/src/records.rs
@@ -0,0 +1,185 @@
+use crate::{Result, loader::LinkedEntry, unavailable};
+use serde_json::Value;
+use std::collections::{BTreeMap, HashSet};
+
+pub(crate) const MAX_RECORD_BYTES: usize = 1 << 20;
+const MAX_INDEX_BYTES: usize = 64 << 20;
+
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum Kind {
+    Message,
+    Aggregate,
+    Fork,
+}
+
+#[derive(Default)]
+pub(crate) struct Records {
+    seen: BTreeMap<(Kind, String), (String, bool)>,
+    pub(crate) messages: Vec<LinkedEntry>,
+    pub(crate) aggregates: Vec<LinkedEntry>,
+    records: usize,
+    bytes: usize,
+}
+
+impl Records {
+    pub(crate) fn count(&mut self) -> Result<()> {
+        self.records = self.records.checked_add(1).ok_or_else(unavailable)?;
+        if self.records > super::files::MAX_RECORDS {
+            return Err(unavailable());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn insert(
+        &mut self,
+        value: &Value,
+        entry: Option<LinkedEntry>,
+        kind: Kind,
+    ) -> Result<()> {
+        let id = identifier(value.get("id"))?.to_owned();
+        identifier(value.get("sessionID"))?;
+        let canonical = serde_json::to_string(value).map_err(|_| unavailable())?;
+        if let Some(previous) = self.seen.get(&(kind, id.clone())) {
+            return if previous == &(canonical, entry.is_some()) {
+                Ok(())
+            } else {
+                Err(unavailable())
+            };
+        }
+        self.bytes = self
+            .bytes
+            .checked_add(canonical.len() + id.len())
+            .ok_or_else(unavailable)?;
+        if self.bytes > MAX_INDEX_BYTES {
+            return Err(unavailable());
+        }
+        self.seen.insert((kind, id), (canonical, entry.is_some()));
+        if let Some(entry) = entry {
+            if kind == Kind::Aggregate {
+                self.aggregates.push(entry);
+            } else {
+                self.messages.push(entry);
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn finish(mut self, allow_aggregates: bool) -> Result<Vec<LinkedEntry>> {
+        if allow_aggregates {
+            let sessions: HashSet<_> = self
+                .messages
+                .iter()
+                .map(|entry| entry.0.session_id.clone())
+                .collect();
+            self.messages.extend(
+                self.aggregates
+                    .into_iter()
+                    .filter(|entry| !sessions.contains(&entry.0.session_id)),
+            );
+        }
+        let mut total = 0u64;
+        for (entry, _) in &self.messages {
+            let usage = &entry.data.message.usage;
+            for count in [
+                usage.input_tokens,
+                usage.output_tokens,
+                usage.cache_read_input_tokens,
+                usage.cache_creation_input_tokens,
+                entry.extra_total_tokens,
+            ] {
+                total = total.checked_add(count).ok_or_else(unavailable)?;
+            }
+        }
+        self.messages.sort_by(|left, right| {
+            (left.0.timestamp, &left.0.data.message.id)
+                .cmp(&(right.0.timestamp, &right.0.data.message.id))
+        });
+        Ok(self.messages)
+    }
+}
+
+pub(crate) fn identifier(value: Option<&Value>) -> Result<&str> {
+    value
+        .and_then(Value::as_str)
+        .filter(|id| !id.trim().is_empty() && id.len() <= 4096)
+        .ok_or_else(unavailable)
+}
+
+pub(crate) fn validate(value: &Value) -> Result<bool> {
+    let object = value.as_object().ok_or_else(unavailable)?;
+    identifier(object.get("id"))?;
+    identifier(object.get("sessionID"))?;
+    for field in ["modelID", "providerID"] {
+        if let Some(value) = object.get(field) {
+            identifier(Some(value))?;
+        }
+    }
+    if let Some(time) = object.get("time") {
+        let time = time.as_object().ok_or_else(unavailable)?;
+        if let Some(created) = time.get("created") {
+            created
+                .as_i64()
+                .filter(|time| *time >= 0)
+                .ok_or_else(unavailable)?;
+        }
+    }
+    if let Some(cost) = object.get("cost") {
+        cost.as_f64()
+            .filter(|cost| cost.is_finite() && *cost >= 0.0)
+            .ok_or_else(unavailable)?;
+    }
+    if let Some(role) = object.get("role") {
+        match role.as_str() {
+            Some("user" | "system" | "tool") if !object.contains_key("tokens") => return Ok(false),
+            Some("assistant" | "user" | "system" | "tool") => {}
+            _ => return Err(unavailable()),
+        }
+    }
+    let tokens = object
+        .get("tokens")
+        .and_then(Value::as_object)
+        .ok_or_else(unavailable)?;
+    let mut known = 0u64;
+    for field in ["input", "output"] {
+        if let Some(value) = tokens.get(field) {
+            known = known
+                .checked_add(value.as_u64().ok_or_else(unavailable)?)
+                .ok_or_else(unavailable)?;
+        }
+    }
+    let cache = tokens
+        .get("cache")
+        .map(|cache| cache.as_object().ok_or_else(unavailable))
+        .transpose()?;
+    if let Some(cache) = cache {
+        for field in ["read", "write"] {
+            if let Some(value) = cache.get(field) {
+                known = known
+                    .checked_add(value.as_u64().ok_or_else(unavailable)?)
+                    .ok_or_else(unavailable)?;
+            }
+        }
+    }
+    let total = tokens
+        .get("total")
+        .map(|value| value.as_u64().ok_or_else(unavailable))
+        .transpose()?;
+    let reasoning = tokens
+        .get("reasoning")
+        .map(|value| value.as_u64().ok_or_else(unavailable))
+        .transpose()?
+        .unwrap_or(0);
+    if total.is_none() {
+        known = known.checked_add(reasoning).ok_or_else(unavailable)?;
+    }
+    let complete = tokens.contains_key("input")
+        && tokens.contains_key("output")
+        && cache.is_some_and(|cache| cache.contains_key("read") && cache.contains_key("write"));
+    if total.is_some_and(|total| total < known) || (!complete && total.is_none()) {
+        return Err(unavailable());
+    }
+    if (!object.contains_key("modelID") || !object.contains_key("providerID")) && total.is_none() {
+        return Err(unavailable());
+    }
+    Ok(true)
+}
