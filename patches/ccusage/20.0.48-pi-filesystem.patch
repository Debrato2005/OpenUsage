index 0000000..04d0391
--- /dev/null
+++ b/rust/adapters/pi/src/files.rs
@@ -0,0 +1,280 @@
+use std::path::PathBuf;
+
+use crate::Result;
+
+pub(crate) const MAX_ROOTS: usize = 64;
+pub(crate) const MAX_RECORDS: usize = 100_000;
+
+pub(crate) struct Snapshot {
+    pub path: PathBuf,
+    pub root: PathBuf,
+    pub content: Vec<u8>,
+}
+
+pub(crate) fn read(paths: &[PathBuf]) -> Result<Vec<Snapshot>> {
+    if paths.is_empty() {
+        return Ok(Vec::new());
+    }
+    #[cfg(target_os = "linux")]
+    {
+        linux::read_with(paths, linux::Limits::default(), |_| {})
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        Err(super::identity::unavailable())
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) mod linux {
+    use super::Snapshot;
+    use crate::Result;
+    use crate::identity::unavailable;
+    use rustix::{
+        fd::OwnedFd,
+        fs::{self, AtFlags, CWD, Dir, FileType, Mode, OFlags, ResolveFlags, Stat},
+    };
+    use std::{
+        collections::BTreeMap,
+        ffi::OsStr,
+        fs::File,
+        io::Read,
+        os::unix::ffi::OsStrExt,
+        path::{Path, PathBuf},
+    };
+
+    #[derive(Clone, Copy)]
+    pub(crate) struct Limits {
+        pub roots: usize,
+        pub entries: usize,
+        pub files: usize,
+        pub depth: usize,
+        pub file_bytes: u64,
+        pub total_bytes: u64,
+    }
+
+    impl Default for Limits {
+        fn default() -> Self {
+            Self {
+                roots: super::MAX_ROOTS,
+                entries: 32768,
+                files: 8192,
+                depth: 64,
+                file_bytes: 32 << 20,
+                total_bytes: 128 << 20,
+            }
+        }
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub(crate) enum Stage {
+        Discovered,
+        Read(usize),
+        BeforeVerify,
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    struct Stamp {
+        device: u64,
+        inode: u64,
+        mode: u32,
+        size: i64,
+        modified: (i128, i128),
+        changed: (i128, i128),
+    }
+
+    impl From<Stat> for Stamp {
+        fn from(stat: Stat) -> Self {
+            Self {
+                device: stat.st_dev,
+                inode: stat.st_ino,
+                mode: stat.st_mode,
+                size: stat.st_size,
+                modified: (stat.st_mtime.into(), stat.st_mtime_nsec.into()),
+                changed: (stat.st_ctime.into(), stat.st_ctime_nsec.into()),
+            }
+        }
+    }
+
+    struct Root {
+        path: PathBuf,
+        fd: OwnedFd,
+        stamp: Stamp,
+    }
+    type Manifest = BTreeMap<(usize, PathBuf), Stamp>;
+
+    fn root(path: &Path) -> Result<Root> {
+        let fd = fs::openat2(
+            CWD,
+            path,
+            OFlags::RDONLY | OFlags::DIRECTORY | OFlags::CLOEXEC,
+            Mode::empty(),
+            ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())?;
+        let stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+        Ok(Root {
+            path: path.to_owned(),
+            fd,
+            stamp,
+        })
+    }
+
+    fn open(root: &Root, path: &Path, flags: OFlags) -> Result<OwnedFd> {
+        let path = if path.as_os_str().is_empty() {
+            Path::new(".")
+        } else {
+            path
+        };
+        fs::openat2(
+            &root.fd,
+            path,
+            flags | OFlags::CLOEXEC | OFlags::NONBLOCK,
+            Mode::empty(),
+            ResolveFlags::BENEATH | ResolveFlags::NO_SYMLINKS | ResolveFlags::NO_MAGICLINKS,
+        )
+        .map_err(|_| unavailable())
+    }
+
+    fn manifest(roots: &[Root], limits: Limits) -> Result<Manifest> {
+        let mut result = BTreeMap::new();
+        let mut entries = 0usize;
+        let mut files = 0usize;
+        let mut bytes = 0u64;
+        for (index, root) in roots.iter().enumerate() {
+            let mut pending = vec![(PathBuf::new(), 0usize)];
+            while let Some((path, depth)) = pending.pop() {
+                if depth > limits.depth {
+                    return Err(unavailable());
+                }
+                let fd = open(root, &path, OFlags::RDONLY | OFlags::DIRECTORY)?;
+                let before: Stamp = fs::fstat(&fd).map_err(|_| unavailable())?.into();
+                result.insert((index, path.clone()), before.clone());
+                let directory = Dir::read_from(&fd).map_err(|_| unavailable())?;
+                for item in directory {
+                    let item = item.map_err(|_| unavailable())?;
+                    let name = item.file_name().to_bytes();
+                    if name == b"." || name == b".." {
+                        continue;
+                    }
+                    entries = entries.checked_add(1).ok_or_else(unavailable)?;
+                    if entries > limits.entries {
+                        return Err(unavailable());
+                    }
+                    // Derived debug transcripts are not primary session sources.
+                    if name == b"subagent-artifacts" {
+                        continue;
+                    }
+                    let child = path.join(OsStr::from_bytes(name));
+                    let stat = fs::statat(&fd, item.file_name(), AtFlags::SYMLINK_NOFOLLOW)
+                        .map_err(|_| unavailable())?;
+                    match FileType::from_raw_mode(stat.st_mode) {
+                        FileType::Directory => pending.push((child, depth + 1)),
+                        FileType::RegularFile => {
+                            if child.extension().is_none_or(|ext| ext != "jsonl") {
+                                continue;
+                            }
+                            files = files.checked_add(1).ok_or_else(unavailable)?;
+                            let size = u64::try_from(stat.st_size).map_err(|_| unavailable())?;
+                            bytes = bytes.checked_add(size).ok_or_else(unavailable)?;
+                            if files > limits.files
+                                || size > limits.file_bytes
+                                || bytes > limits.total_bytes
+                            {
+                                return Err(unavailable());
+                            }
+                            result.insert((index, child), stat.into());
+                        }
+                        _ => return Err(unavailable()),
+                    }
+                }
+                if Stamp::from(fs::fstat(&fd).map_err(|_| unavailable())?) != before {
+                    return Err(unavailable());
+                }
+            }
+        }
+        Ok(result)
+    }
+
+    pub(crate) fn read_with(
+        paths: &[PathBuf],
+        limits: Limits,
+        mut hook: impl FnMut(Stage),
+    ) -> Result<Vec<Snapshot>> {
+        if paths.len() > limits.roots {
+            return Err(unavailable());
+        }
+        let roots = paths
+            .iter()
+            .map(|path| root(path))
+            .collect::<Result<Vec<_>>>()?;
+        let before = manifest(&roots, limits)?;
+        hook(Stage::Discovered);
+        let mut snapshots = Vec::new();
+        for ((index, path), expected) in &before {
+            if FileType::from_raw_mode(expected.mode) != FileType::RegularFile {
+                continue;
+            }
+            let fd = open(&roots[*index], path, OFlags::RDONLY)?;
+            if Stamp::from(fs::fstat(&fd).map_err(|_| unavailable())?) != *expected {
+                return Err(unavailable());
+            }
+            let mut file = File::from(fd);
+            let mut content = Vec::new();
+            (&mut file)
+                .take(limits.file_bytes.saturating_add(1))
+                .read_to_end(&mut content)
+                .map_err(|_| unavailable())?;
+            hook(Stage::Read(snapshots.len()));
+            if content.len() as u64 != expected.size as u64
+                || Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected
+            {
+                return Err(unavailable());
+            }
+            snapshots.push(Snapshot {
+                path: roots[*index].path.join(path),
+                root: roots[*index].path.clone(),
+                content,
+            });
+        }
+        hook(Stage::BeforeVerify);
+        for selected in &roots {
+            if root(&selected.path)?.stamp != selected.stamp {
+                return Err(unavailable());
+            }
+        }
+        // Timestamp resolution can hide a same-size rewrite. Compare bounded
+        // bytes again before the final manifest check, without a retry.
+        for snapshot in &snapshots {
+            let index = roots
+                .iter()
+                .position(|root| root.path == snapshot.root)
+                .ok_or_else(unavailable)?;
+            let path = snapshot
+                .path
+                .strip_prefix(&snapshot.root)
+                .map_err(|_| unavailable())?;
+            let mut file = File::from(open(&roots[index], path, OFlags::RDONLY)?);
+            let expected = before
+                .get(&(index, path.to_owned()))
+                .ok_or_else(unavailable)?;
+            if Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected {
+                return Err(unavailable());
+            }
+            let mut content = Vec::new();
+            (&mut file)
+                .take(limits.file_bytes.saturating_add(1))
+                .read_to_end(&mut content)
+                .map_err(|_| unavailable())?;
+            if content != snapshot.content
+                || Stamp::from(fs::fstat(&file).map_err(|_| unavailable())?) != *expected
+            {
+                return Err(unavailable());
+            }
+        }
+        if manifest(&roots, limits)? != before {
+            return Err(unavailable());
+        }
+        Ok(snapshots)
+    }
+}
