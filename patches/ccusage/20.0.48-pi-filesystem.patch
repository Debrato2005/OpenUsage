+#[test]
+fn record_budget_counts_replays_and_keeps_the_exact_boundary() {
+    let fixture = Fixture::new();
+    let row = event("aaaaaaaa", None, 120);
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[row.clone(), row],
+    );
+    let content = std::fs::read(file).unwrap();
+    assert_eq!(
+        crate::identity::parse_bounded(&content, 2)
+            .unwrap()
+            .record_count,
+        2
+    );
+    assert!(crate::identity::parse_bounded(&content, 1).is_err());
+}
+
+#[test]
+fn token_budget_is_checked_after_copy_suppression() {
+    let fixture = Fixture::new();
+    let rows = [event("aaaaaaaa", None, u64::MAX)];
+    write(&fixture, "first/root.jsonl", header("root", None), &rows);
+    write(
+        &fixture,
+        "second/renamed.jsonl",
+        header("root", None),
+        &rows,
+    );
+    let entries = load(&[fixture.path("first"), fixture.path("second")]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(
+        crate::total_usage_tokens(entries[0].data.message.usage),
+        u64::MAX
+    );
+}
+
+#[test]
+fn excessive_json_nesting_is_unavailable() {
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let content = std::fs::read_to_string(&file).unwrap();
+    let nested = format!("{}0{}", "[".repeat(200), "]".repeat(200));
+    let content = content.replace(
+        "\"provider\":\"openai\"",
+        &format!("\"provider\":\"openai\",\"extra\":{nested}"),
+    );
+    assert!(content.contains(&nested));
+    std::fs::write(&file, content).unwrap();
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
