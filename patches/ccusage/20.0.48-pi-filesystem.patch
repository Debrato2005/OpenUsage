@@ -0,0 +1,379 @@
+use crate::identity_tests::{event, header, load, write};
+use ccusage_test_support::Fixture;
+use std::os::unix::{
+    fs::{PermissionsExt, symlink},
+    net::UnixListener,
+};
+
+#[test]
+fn missing_explicit_root_is_not_an_empty_contribution() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    assert!(load(&[fixture.path("sessions"), fixture.path("missing")]).is_err());
+}
+
+#[test]
+fn unreadable_directory_does_not_create_partial_success() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    write(
+        &fixture,
+        "sessions/blocked/child.jsonl",
+        header("child", None),
+        &[event("bbbbbbbb", None, 17)],
+    );
+    let blocked = fixture.path("sessions/blocked");
+    std::fs::set_permissions(&blocked, std::fs::Permissions::from_mode(0o0)).unwrap();
+    let result = load(&[fixture.path("sessions")]);
+    std::fs::set_permissions(&blocked, std::fs::Permissions::from_mode(0o700)).unwrap();
+    assert!(result.is_err());
+}
+
+#[test]
+fn selected_file_and_directory_links_are_not_silently_omitted() {
+    for directory in [false, true] {
+        let fixture = Fixture::new();
+        write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120)],
+        );
+        let outside = write(
+            &fixture,
+            "outside/child.jsonl",
+            header("child", None),
+            &[event("bbbbbbbb", None, 17)],
+        );
+        symlink(
+            if directory {
+                outside.parent().unwrap()
+            } else {
+                &outside
+            },
+            fixture.path("sessions/link.jsonl"),
+        )
+        .unwrap();
+        assert!(load(&[fixture.path("sessions")]).is_err());
+    }
+}
+
+#[test]
+fn special_source_files_are_not_successfully_ignored() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let _socket = UnixListener::bind(fixture.path("sessions/socket.jsonl")).unwrap();
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn aggregate_token_overflow_is_unavailable_before_reporting() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[
+            event("aaaaaaaa", None, u64::MAX),
+            event("bbbbbbbb", Some("aaaaaaaa"), 1),
+        ],
+    );
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn excessive_directory_nesting_is_unavailable() {
+    let fixture = Fixture::new();
+    let path = format!("sessions/{}root.jsonl", "nested/".repeat(65));
+    write(
+        &fixture,
+        &path,
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn controlled_source_changes_return_no_snapshot() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    for change in [
+        "append",
+        "truncate",
+        "rewrite",
+        "replace-file",
+        "add-file",
+        "delete-file",
+        "replace-root",
+    ] {
+        let fixture = Fixture::new();
+        let file = write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120)],
+        );
+        let folder = fixture.path("sessions");
+        let result = read_with(std::slice::from_ref(&folder), Limits::default(), |stage| {
+            if stage != Stage::BeforeVerify {
+                return;
+            }
+            match change {
+                "append" => {
+                    let mut bytes = std::fs::read(&file).unwrap();
+                    bytes.push(b'\n');
+                    std::fs::write(&file, bytes).unwrap();
+                }
+                "truncate" => std::fs::write(&file, b"").unwrap(),
+                "rewrite" => {
+                    let time = std::fs::metadata(&file).unwrap().modified().unwrap();
+                    let bytes = std::fs::read_to_string(&file)
+                        .unwrap()
+                        .replace("120", "121");
+                    std::fs::write(&file, bytes).unwrap();
+                    std::fs::File::options()
+                        .write(true)
+                        .open(&file)
+                        .unwrap()
+                        .set_times(std::fs::FileTimes::new().set_modified(time))
+                        .unwrap();
+                }
+                "replace-file" => {
+                    std::fs::rename(&file, fixture.path("original.jsonl")).unwrap();
+                    std::fs::copy(fixture.path("original.jsonl"), &file).unwrap();
+                }
+                "add-file" => {
+                    write(
+                        &fixture,
+                        "sessions/new.jsonl",
+                        header("new", None),
+                        &[event("bbbbbbbb", None, 17)],
+                    );
+                }
+                "delete-file" => std::fs::remove_file(&file).unwrap(),
+                "replace-root" => {
+                    std::fs::rename(&folder, fixture.path("moved")).unwrap();
+                    std::fs::create_dir(&folder).unwrap();
+                }
+                _ => unreachable!(),
+            }
+        });
+        assert!(result.is_err(), "{change}");
+    }
+}
+
+#[test]
+fn a_link_inserted_after_discovery_is_rejected_before_a_content_read() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let outside = write(
+        &fixture,
+        "outside/private.jsonl",
+        header("outside", None),
+        &[event("bbbbbbbb", None, 17)],
+    );
+    let mut reads = 0;
+    let result = read_with(
+        &[fixture.path("sessions")],
+        Limits::default(),
+        |stage| match stage {
+            Stage::Discovered => {
+                std::fs::remove_file(&file).unwrap();
+                symlink(&outside, &file).unwrap();
+            }
+            Stage::Read(_) => reads += 1,
+            _ => {}
+        },
+    );
+    assert!(result.is_err());
+    assert_eq!(reads, 0);
+}
+
+#[test]
+fn a_directory_link_inserted_after_discovery_cannot_redirect_reads() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/nested/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    write(
+        &fixture,
+        "outside/root.jsonl",
+        header("outside", None),
+        &[event("bbbbbbbb", None, 17)],
+    );
+    let mut reads = 0;
+    let result = read_with(
+        &[fixture.path("sessions")],
+        Limits::default(),
+        |stage| match stage {
+            Stage::Discovered => {
+                std::fs::rename(fixture.path("sessions/nested"), fixture.path("moved")).unwrap();
+                symlink(fixture.path("outside"), fixture.path("sessions/nested")).unwrap();
+            }
+            Stage::Read(_) => reads += 1,
+            _ => {}
+        },
+    );
+    assert!(result.is_err());
+    assert_eq!(reads, 0);
+}
+
+#[test]
+fn a_change_after_a_content_read_is_unavailable() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let result = read_with(&[fixture.path("sessions")], Limits::default(), |stage| {
+        if stage == Stage::Read(0) {
+            std::fs::write(&file, b"").unwrap();
+        }
+    });
