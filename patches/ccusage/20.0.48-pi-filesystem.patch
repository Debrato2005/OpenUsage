+#[test]
+fn source_limits_accept_the_boundary_and_reject_excess_before_reading() {
+    use crate::files::linux::{Limits, Stage, read_with};
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let size = std::fs::metadata(file).unwrap().len();
+    let boundary = Limits {
+        roots: 1,
+        entries: 1,
+        files: 1,
+        depth: 0,
+        file_bytes: size,
+        total_bytes: size,
+    };
+    assert_eq!(
+        read_with(&[fixture.path("sessions")], boundary, |_| {})
+            .unwrap()
+            .len(),
+        1
+    );
+    for limit in [
+        Limits {
+            roots: 0,
+            ..boundary
+        },
+        Limits {
+            entries: 0,
+            ..boundary
+        },
+        Limits {
+            files: 0,
+            ..boundary
+        },
+        Limits {
+            file_bytes: size - 1,
+            ..boundary
+        },
+        Limits {
+            total_bytes: size - 1,
+            ..boundary
+        },
+    ] {
+        let mut reads = 0;
+        let result = read_with(&[fixture.path("sessions")], limit, |stage| {
+            if matches!(stage, Stage::Read(_)) {
+                reads += 1;
+            }
+        });
+        assert!(result.is_err());
+        assert_eq!(reads, 0);
+    }
+}
