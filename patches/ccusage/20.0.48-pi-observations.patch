+
+#[test]
+fn snapshot_preserves_reported_zero_as_an_observation() {
+    let fixture = Fixture::new();
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 0)],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    let report = snapshot_from_entries(&entries, &SharedArgs::with_defaults()).unwrap();
+    assert_eq!(report["daily"]["daily"].as_array().unwrap().len(), 1);
+    assert_eq!(report["daily"]["daily"][0]["totalTokens"], 0);
+    assert_eq!(report["session"]["sessions"].as_array().unwrap().len(), 1);
+    assert_eq!(report["session"]["sessions"][0]["sessionId"], "root");
+    assert_eq!(report["session"]["sessions"][0]["totalTokens"], 0);
+}
+
+#[test]
+fn absent_required_usage_or_total_cannot_be_a_complete_scan() {
+    for kind in ["message", "usage", "compaction", "branch_summary"] {
+        for missing in ["usage", "totalTokens"] {
+            if missing == "usage" && matches!(kind, "compaction" | "branch_summary") {
+                continue;
+            }
+            let fixture = Fixture::new();
+            let mut row = event("aaaaaaaa", None, 120);
+            row["type"] = json!(kind);
+            if kind != "message" {
+                row["usage"] = row["message"]["usage"].clone();
+                row.as_object_mut().unwrap().remove("message");
+            }
+            let fields = if kind == "message" {
+                &mut row["message"]
+            } else {
+                &mut row
+            };
+            if missing == "usage" {
+                fields.as_object_mut().unwrap().remove("usage");
+            } else {
+                fields["usage"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("totalTokens");
+            }
+            write(
+                &fixture,
+                "sessions/root.jsonl",
+                header("root", None),
+                &[row],
+            );
+            assert!(
+                load(&[fixture.path("sessions")]).is_err(),
+                "{kind}: {missing}"
+            );
+        }
+    }
+}
+
+#[test]
+fn zero_copies_and_forks_keep_one_observation_and_distinct_calls() {
+    let fixture = Fixture::new();
+    let zero = event("aaaaaaaa", None, 0);
+    let parent = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        std::slice::from_ref(&zero),
+    );
+    std::fs::copy(&parent, fixture.path("sessions/copy.jsonl")).unwrap();
+    write(
+        &fixture,
+        "sessions/fork.jsonl",
+        header("fork", Some(&parent)),
+        &[zero],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].session_id.as_ref(), "root");
+    write(
+        &fixture,
+        "sessions/distinct.jsonl",
+        header("distinct", None),
+        &[event("aaaaaaaa", None, 0)],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    assert_eq!(entries.len(), 2);
+    let report = snapshot_from_entries(&entries, &SharedArgs::with_defaults()).unwrap();
+    assert_eq!(report["session"]["sessions"].as_array().unwrap().len(), 2);
+    assert_eq!(report["daily"]["daily"].as_array().unwrap().len(), 1);
+}
