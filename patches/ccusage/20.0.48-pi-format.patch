+use crate::identity_tests::{event, header, load, write};
+use ccusage_test_support::Fixture;
+use serde_json::json;
+
+#[test]
+fn escaped_json_keys_preserve_usage() {
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let source = std::fs::read_to_string(&file)
+        .unwrap()
+        .replace("\"usage\"", "\"\\u0075sage\"");
+    std::fs::write(file, source).unwrap();
+    assert_eq!(load(&[fixture.path("sessions")]).unwrap().len(), 1);
+}
+
+#[test]
+fn unrelated_header_fields_cannot_change_source_identity() {
+    let fixture = Fixture::new();
+    let mut head = header("source-session", None);
+    head["message"] = json!(42);
+    for path in ["first/sessions/root.jsonl", "second/sessions/renamed.jsonl"] {
+        write(
+            &fixture,
+            path,
+            head.clone(),
+            &[event("aaaaaaaa", None, 120)],
+        );
+    }
+    let entries = load(&[
+        fixture.path("first/sessions"),
+        fixture.path("second/sessions"),
+    ])
+    .unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].session_id.as_ref(), "source-session");
+}
+
+#[test]
+fn invalid_present_fields_are_not_missing_measurements() {
+    for field in ["model", "provider", "role", "message", "id"] {
+        let fixture = Fixture::new();
+        let mut row = event("aaaaaaaa", None, 120);
+        match field {
+            "message" => row["message"] = json!(42),
+            "id" => row["id"] = json!(" aaaaaaaa "),
+            _ => row["message"][field] = json!(42),
+        }
+        write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[row],
+        );
+        assert!(load(&[fixture.path("sessions")]).is_err(), "{field}");
+    }
+}
+
+#[test]
+fn duplicate_json_keys_are_ambiguous_even_when_the_last_value_looks_valid() {
+    let fixture = Fixture::new();
+    let file = write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120)],
+    );
+    let source = std::fs::read_to_string(&file)
+        .unwrap()
+        .replace("\"input\":115", "\"input\":0,\"input\":115");
+    assert!(source.contains("\"input\":0,\"input\":115"));
+    std::fs::write(file, source).unwrap();
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
+
+#[test]
+fn an_assistant_total_does_not_identify_its_output_category() {
+    let fixture = Fixture::new();
+    let mut row = event("aaaaaaaa", None, 120);
+    row["message"]["usage"] = json!({"totalTokens":120});
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[row],
+    );
+    let entries = load(&[fixture.path("sessions")]).unwrap();
+    assert_eq!(entries.len(), 1);
+    assert_eq!(crate::total_usage_tokens(entries[0].data.message.usage), 0);
+    assert_eq!(entries[0].extra_total_tokens, 120);
+}
+
+#[test]
+fn duplicate_header_and_nested_keys_are_unavailable() {
+    for (original, replacement) in [
+        ("\"version\":3", "\"version\":2,\"version\":3"),
+        ("\"input\":115", "\"input\":115,\"\\u0069nput\":115"),
+    ] {
+        let fixture = Fixture::new();
+        let file = write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120)],
+        );
+        let source = std::fs::read_to_string(&file)
+            .unwrap()
+            .replace(original, replacement);
+        assert!(source.contains(replacement));
+        std::fs::write(file, source).unwrap();
+        assert!(load(&[fixture.path("sessions")]).is_err());
+    }
+}
+
+#[test]
+fn known_context_records_do_not_change_raw_usage() {
+    for kind in [
+        "context_edit",
+        "model_change",
+        "thinking_level_change",
+        "custom",
+        "custom_message",
+        "label",
+        "session_info",
+    ] {
+        let fixture = Fixture::new();
+        let context = json!({"type":kind,"id":"bbbbbbbb","parentId":"aaaaaaaa",
+            "timestamp":"2026-05-28T20:26:40.000Z", "replacement":null, "targetId":"aaaaaaaa"});
+        write(
+            &fixture,
+            "sessions/root.jsonl",
+            header("root", None),
+            &[event("aaaaaaaa", None, 120), context],
+        );
+        let entries = load(&[fixture.path("sessions")]).unwrap();
+        assert_eq!(entries.len(), 1, "{kind}");
+        assert_eq!(
+            crate::total_usage_tokens(entries[0].data.message.usage),
+            120
+        );
+    }
+}
+
+#[test]
+fn unknown_record_types_do_not_create_successful_partial_reports() {
+    let fixture = Fixture::new();
+    let unknown = json!({"type":"future_record","id":"bbbbbbbb","parentId":"aaaaaaaa",
+        "timestamp":"2026-05-28T20:26:40.000Z"});
+    write(
+        &fixture,
+        "sessions/root.jsonl",
+        header("root", None),
+        &[event("aaaaaaaa", None, 120), unknown],
+    );
+    assert!(load(&[fixture.path("sessions")]).is_err());
+}
