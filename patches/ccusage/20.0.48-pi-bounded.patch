+            r#"{"type":"session","version":3,"id":"s","timestamp":"2026-05-28T00:00:00Z"}"#;
+        let record =
+            r#"{"type":"label","id":"a","parentId":null,"timestamp":"2026-05-28T00:00:00Z"}"#;
+        let file = format!("{header}\n{record}\n{record}\n");
+        let mut budget = Budget {
+            records_left: 2,
+            metadata_left: 23,
+        };
+        assert!(parse(file.as_bytes(), &mut budget, |_, _, _, _| Ok(())).is_ok());
+        assert_eq!(budget.metadata_left, 0);
+        assert_eq!(budget.records_left, 0);
+        let mut budget = Budget {
+            records_left: 2,
+            metadata_left: 22,
+        };
+        assert!(parse(file.as_bytes(), &mut budget, |_, _, _, _| Ok(())).is_err());
+        let mut budget = Budget {
+            records_left: 1,
+            metadata_left: 23,
+        };
+        assert!(parse(file.as_bytes(), &mut budget, |_, _, _, _| Ok(())).is_err());
+    }
+
+    #[test]
+    fn long_nonblank_record_fails_before_parsing() {
+        let mut line = vec![b' '; MAX_LINE_BYTES + 1];
+        line[0] = b'{';
+        line[1] = b'}';
+        assert!(parse_line(&line[..MAX_LINE_BYTES]).is_ok());
+        assert!(parse_line(&line).is_err());
+    }
+}
