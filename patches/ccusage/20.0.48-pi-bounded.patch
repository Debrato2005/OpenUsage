+
+fn update_digest(digest: &mut Context, value: &Value) -> Result<()> {
+    match value {
+        Value::Null => digest.update(b"n"),
+        Value::Bool(false) => digest.update(b"f"),
+        Value::Bool(true) => digest.update(b"t"),
+        Value::String(text) => {
+            digest.update(b"s");
+            digest_text(digest, text);
+        }
+        Value::Number(number) => {
+            if let Some(value) = number.as_u64() {
+                digest.update(b"u");
+                digest.update(&value.to_le_bytes());
+            } else if let Some(value) = number.as_i64() {
+                digest.update(b"i");
+                digest.update(&value.to_le_bytes());
+            } else {
+                digest.update(b"d");
+                let value = number.as_f64().ok_or_else(unavailable)?;
+                // JSON number equality treats both signs of floating-point zero as equal.
+                let bits = if value == 0.0 { 0 } else { value.to_bits() };
+                digest.update(&bits.to_le_bytes());
+            }
+        }
+        Value::Array(items) => {
+            digest.update(b"a");
+            digest.update(&(items.len() as u64).to_le_bytes());
+            for item in items {
+                update_digest(digest, item)?;
+            }
+        }
+        Value::Object(fields) => {
+            digest.update(b"o");
+            digest.update(&(fields.len() as u64).to_le_bytes());
+            for (key, item) in fields {
+                digest_text(digest, key);
+                update_digest(digest, item)?;
+            }
+        }
+    }
+    Ok(())
