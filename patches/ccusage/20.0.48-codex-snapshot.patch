+
+// Snapshot selection must not silently omit an invalid sessions directory.
+pub(super) fn snapshot_usage_paths() -> Result<Vec<PathBuf>> {
+    let homes = codex_home_paths()?;
+    if homes.len() > super::record_files::MAX_ROOTS {
+        return Err(super::paginated::unavailable());
+    }
+    let mut paths = Vec::new();
+    let mut seen = FxHashSet::default();
+    for home in homes {
+        let metadata = fs::symlink_metadata(&home).map_err(|_| super::paginated::unavailable())?;
+        if !metadata.is_dir() {
+            return Err(super::paginated::unavailable());
+        }
+        let mut found = false;
+        for name in ["sessions", "archived_sessions"] {
+            let path = home.join(name);
+            match fs::symlink_metadata(&path) {
+                Ok(metadata) if metadata.is_dir() => {
+                    found = true;
+                    if seen.insert(path.clone()) {
+                        paths.push(path);
+                    }
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                _ => return Err(super::paginated::unavailable()),
+            }
+        }
+        if !found && seen.insert(home.clone()) {
+            paths.push(home);
+        }
+    }
+    Ok(paths)
 }
 
