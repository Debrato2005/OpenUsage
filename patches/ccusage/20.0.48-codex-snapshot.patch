+
+// Build both complete reports from one validated capture.
+fn snapshot_json(
+    events: &[CodexTokenUsageEvent],
+    timezone: Option<&str>,
+    pricing: &PricingMap,
+    speed: CodexSpeedPolicy,
+    mode: CostMode,
+) -> Result<Value> {
+    let daily = aggregate_events(events, AgentReportKind::Daily, timezone)?;
+    let sessions = aggregate_events(events, AgentReportKind::Session, timezone)?;
+    Ok(serde_json::json!({
+        "schemaVersion": 1,
+        "tool": "codex",
+        "daily": report_from_groups(&daily, AgentReportKind::Daily, pricing, speed, mode),
+        "session": report_from_groups(&sessions, AgentReportKind::Session, pricing, speed, mode),
+    }))
 }
 
