+#[test]
+fn codex_snapshot_parses_as_two_complete_json_reports() {
+    let cli = parse(&["ccusage", "codex", "snapshot", "--json", "--offline"]);
+    let Some(Command::Codex(args)) = cli.command else {
+        panic!("Codex snapshot command");
+    };
+    assert_eq!(
+        args.sections,
+        Some(vec![AgentReportKind::Daily, AgentReportKind::Session])
+    );
+    assert!(args.shared.json && args.shared.offline);
+    assert!(args.session_id.is_none());
+}
+
+#[test]
+fn codex_snapshot_rejects_partial_or_modified_reports() {
+    for flags in [
+        vec![],
+        vec!["--json"],
+        vec!["--offline"],
+        vec!["--json", "--offline", "--since", "20261111"],
+        vec!["--json", "--offline", "--until", "20261111"],
+        vec!["--json", "--offline", "--last", "2"],
+        vec!["--json", "--offline", "--jq", ".daily"],
+        vec!["--json", "--offline", "--no-cost"],
+        vec!["--json", "--offline", "--no-offline"],
+        vec!["--json", "--offline", "--id", "thread-a"],
+        vec!["--json", "--offline", "--sections", "daily"],
+    ] {
+        let mut args = vec!["ccusage", "codex", "snapshot"];
+        args.extend(flags);
+        assert!(!parse_error(&args).is_empty());
+    }
+}
