+impl<'a> Frontier<'a> {
+    fn read(shm: &'a [u8], size: usize, limit: usize) -> Result<Self> {
+        // Unix SHM uses 32 KiB regions and two identical native-endian headers.
+        if shm.is_empty() || shm.len() > limit || !shm.len().is_multiple_of(32768) {
+            return Err(unavailable());
+        }
+        let header = &shm[..48];
+        let encoded_size = u16::from_ne_bytes([header[14], header[15]]);
+        let expected_size = if size == 65536 { 1 } else { size as u16 };
