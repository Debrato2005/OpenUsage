+        }
+        let frame = native32(&header[16..]);
+        if native32(&shm[96..]) > frame || native32(&shm[128..]) > frame {
+            return Err(unavailable());
+        }
+        Ok(Self {
+            header,
+            frame: usize::try_from(frame).map_err(|_| unavailable())?,
+            length: image_length(native32(&header[20..]), size, limit)?,
+        })
+    }
