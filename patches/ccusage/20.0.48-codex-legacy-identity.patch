+//! Synthetic legacy observations use recorded thread identity and complete streams.
+use std::{collections::BTreeMap, io::Read, path::PathBuf};
+
+use serde_json::Value;
+
+use crate::{CodexTokenUsageEvent, Result, cli_error};
+
+const MAX_FILE: usize = 32 << 20;
+const MAX_TOTAL: usize = 64 << 20;
+const MAX_LINE: usize = 1 << 20;
+const MAX_RECORDS: usize = 100_000;
+const MAX_EXACT: u64 = (1_u64 << 53) - 1;
+
+fn unavailable() -> crate::CliError {
+    cli_error(
+        "Codex legacy capture is unavailable: incomplete, conflicting, unsupported, or over limit",
+    )
+}
+
+pub(super) fn load(roots: &[PathBuf]) -> Result<Option<Vec<CodexTokenUsageEvent>>> {
+    if roots.len() > super::record_files::MAX_ROOTS {
+        return Err(unavailable());
+    }
+    let mut existing = false;
+    for root in roots {
+        match std::fs::symlink_metadata(root) {
+            Ok(_) => existing = true,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(_) => return Err(unavailable()),
+        }
+    }
+    // Ordinary multi-tool reports allow an absent tool with no observations.
+    // Once any source exists, every selected root enters the checked capture.
+    if !existing {
+        return Ok(None);
+    }
+    let mut threads: BTreeMap<String, (Vec<Vec<u8>>, [u64; 6])> = BTreeMap::new();
+    let mut bytes = 0usize;
+    let mut records = 0usize;
+    super::record_files::read_legacy(roots, |path, _, raw| {
+        let decoded;
+        let content = if path.extension().is_some_and(|extension| extension == "zst") {
+            let mut reader = zstd::stream::read::Decoder::new(raw).map_err(|_| unavailable())?;
+            decoded = {
+                let mut output = Vec::new();
+                reader
+                    .by_ref()
+                    .take(MAX_FILE as u64 + 1)
+                    .read_to_end(&mut output)
+                    .map_err(|_| unavailable())?;
+                output
+            };
+            decoded.as_slice()
+        } else {
+            raw
+        };
+        bytes = bytes.checked_add(content.len()).ok_or_else(unavailable)?;
+        if content.len() > MAX_FILE || bytes > MAX_TOTAL {
+            return Err(unavailable());
+        }
+        let mut rows = Vec::new();
+        for line in content.split(|byte| *byte == b'\n') {
+            if line.iter().all(u8::is_ascii_whitespace) {
+                continue;
+            }
+            records = records.checked_add(1).ok_or_else(unavailable)?;
+            if line.len() > MAX_LINE || records > MAX_RECORDS {
+                return Err(unavailable());
+            }
+            rows.push(super::record_json::parse(line).map_err(|_| unavailable())?);
+        }
+        if rows.is_empty() {
+            return Ok(());
+        }
+        let thread = identity(&rows[0])?.to_owned();
+        let total = validate(&rows)?;
+        let canonical = rows
+            .iter()
+            .map(serde_json::to_vec)
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .map_err(|_| unavailable())?;
+        if let Some(previous) = threads.get_mut(&thread) {
+            if canonical.starts_with(&previous.0) {
+                *previous = (canonical, total);
+            } else if !previous.0.starts_with(&canonical) {
+                return Err(unavailable());
+            }
+        } else {
+            threads.insert(thread, (canonical, total));
+        }
+        Ok(())
+    })
+    .map_err(|_| unavailable())?;
+    if threads.is_empty() {
+        return Ok(None);
+    }
+    let mut events = Vec::new();
+    let mut joint = [0_u64; 6];
+    for (thread, (rows, total)) in threads {
+        for index in 0..6 {
+            joint[index] = joint[index]
+                .checked_add(total[index])
+                .filter(|value| *value <= MAX_EXACT)
+                .ok_or_else(unavailable)?;
+        }
+        events.extend(super::parser::captured_legacy_entries(&thread, &rows)?);
+    }
+    Ok(Some(events))
+}
+
+fn identity(row: &Value) -> Result<&str> {
+    if row["type"] != "session_meta"
+        || !row["payload"].is_object()
+        || row["payload"]
+            .get("history_mode")
+            .is_some_and(|value| value != "legacy")
+    {
+        return Err(unavailable());
+    }
+    row["payload"]["id"]
+        .as_str()
+        .filter(|id| {
+            !id.is_empty()
+                && id.len() <= 1024
+                && id.trim() == *id
+                && !id.chars().any(char::is_control)
+        })
+        .ok_or_else(unavailable)
+}
+
+fn usage(value: &Value) -> Result<[u64; 6]> {
+    if !value.is_object() {
+        return Err(unavailable());
+    }
+    let mut counts = [0; 6];
+    for (index, field) in [
+        "input_tokens",
+        "cached_input_tokens",
+        "cache_write_input_tokens",
+        "output_tokens",
+        "reasoning_output_tokens",
+        "total_tokens",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let raw = if *field == "cache_write_input_tokens" {
+            match (value.get(*field), value.get("cache_creation_input_tokens")) {
+                (Some(_), Some(_)) => return Err(unavailable()),
+                (None, None) => {
+                    counts[index] = 0;
+                    continue;
+                }
+                (Some(value), None) | (None, Some(value)) => value,
+            }
+        } else {
+            value.get(*field).ok_or_else(unavailable)?
+        };
+        counts[index] = raw
+            .as_u64()
+            .filter(|count| *count <= MAX_EXACT)
+            .ok_or_else(unavailable)?;
+    }
+    let [input, cached, write, output, reasoning, total] = counts;
+    if cached.checked_add(write).is_none_or(|value| value > input)
+        || reasoning > output
+        || input.checked_add(output) != Some(total)
+    {
+        return Err(unavailable());
+    }
+    Ok(counts)
+}
+
+fn validate(rows: &[Value]) -> Result<[u64; 6]> {
+    let meta = &rows[0]["payload"];
+    if [
+        "forked_from_id",
+        "forked_from_ordinal_exclusive",
+        "parent_thread_id",
+        "history_base",
+        "subagent_history_start_ordinal",
+    ]
+    .iter()
+    .any(|field| meta.get(*field).is_some_and(|value| !value.is_null()))
+        || meta
+            .get("source")
+            .is_some_and(|source| source == "subagent" || source.get("subagent").is_some())
+    {
+        return Err(unavailable());
+    }
+    let mut previous = [0; 6];
+    for (index, row) in rows.iter().enumerate() {
+        let kind = row["type"].as_str().ok_or_else(unavailable)?;
+        if !row.is_object()
+            || row.get("ordinal").is_some()
+            || (index != 0 && kind == "session_meta")
+            || matches!(
+                kind,
+                "token_usage_record"
+                    | "compacted"
+                    | "inter_agent_communication"
+                    | "inter_agent_communication_metadata"
+                    | "thread_rolled_back"
+            )
+        {
+            return Err(unavailable());
+        }
+        let payload = &row["payload"];
+        if kind == "event_msg"
+            && matches!(
+                payload["type"].as_str(),
+                Some("thread_rolled_back" | "context_compacted")
+            )
+        {
+            return Err(unavailable());
+        }
+        if kind != "event_msg" || payload["type"] != "token_count" {
+            continue;
+        }
+        let info = &payload["info"];
+        if info.is_null() {
+            continue;
+        }
+        if super::parser::codex_value_timestamp(row.get("timestamp")).is_none() {
+            return Err(unavailable());
+        }
+        let total = usage(&info["total_token_usage"])?;
+        let last = usage(&info["last_token_usage"])?;
+        let mut delta = [0; 6];
+        for index in 0..6 {
+            delta[index] = total[index]
+                .checked_sub(previous[index])
+                .ok_or_else(unavailable)?;
+            if last[index] > total[index] {
+                return Err(unavailable());
+            }
+        }
+        if total != previous && delta != last {
+            return Err(unavailable());
+        }
+        previous = total;
+    }
+    Ok(previous)
+}
