+// The legacy capture layer already established stream ownership and counter validity.
+// Parse its immutable rows without the historical replay timing heuristics.
+pub(super) fn captured_legacy_entries(
+    thread_id: &str,
+    rows: &[Vec<u8>],
+) -> Result<Vec<CodexTokenUsageEvent>> {
+    let mut state = CodexSessionUsageState::default();
+    let mut events = Vec::new();
+    for row in rows {
+        let value = serde_json::from_slice::<CodexSessionLogEntry<'_>>(row).map_err(|_| {
+            crate::cli_error("Codex legacy capture is unavailable: unsupported record")
+        })?;
+        visit_codex_session_entry(thread_id, value, &mut state, &mut |event| {
+            if event.model.as_ref().is_some_and(|model| model.len() > 1024) {
+                return Err(crate::cli_error(
+                    "Codex legacy capture is unavailable: model over limit",
+                ));
+            }
+            events.push(event);
+            Ok(())
+        })?;
+    }
+    Ok(events)
 }
 
