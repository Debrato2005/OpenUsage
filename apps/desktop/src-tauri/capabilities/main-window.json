{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The bundled main window can manage encrypted storage, native profiles, themes, and encrypted backups.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-bootstrap",
    "allow-get-display-scale",
    "allow-set-display-scale",
    "allow-load-profile-plan",
    "allow-load-monitoring",
    "allow-start-profile-monitoring",
    "allow-pause-profile-monitoring",
    "allow-setup-workspace",
    "allow-unlock-workspace",
    "allow-set-theme",
    "allow-create-backup",
    "allow-export-saved-readings",
    "allow-export-quota-history",
    "allow-list-profiles",
    "allow-load-alert-history",
    "allow-load-reset-notification-preferences",
    "allow-save-reset-notification-preferences",
    "allow-create-profile",
    "allow-rename-profile",
    "allow-set-profile-archived",
    "allow-list-backups",
    "allow-inspect-backup",
    "allow-prepare-restore-preview",
    "allow-cancel-restore-preview",
    "allow-apply-restore",
    "allow-list-restore-checkpoints",
    "allow-prepare-checkpoint-restore-preview",
    "allow-inspect-provider-executable",
    "allow-prepare-provider-connection",
    "allow-approve-provider-executable",
    "allow-check-profile-connection",
    "allow-cancel-profile-check",
    "allow-begin-profile-login",
    "allow-await-profile-login-prompt",
    "allow-open-profile-login-page",
    "allow-complete-profile-login",
    "allow-cancel-profile-login",
    "allow-discover-provider-executables",
    "allow-load-profile-activity",
    "allow-load-profile-heatmap",
    "allow-load-combined-heatmap",
    "allow-begin-profile-activity-read",
    "allow-begin-profile-activity-reassociation",
    "allow-review-profile-activity-association",
    "allow-complete-profile-activity-read",
    "allow-cancel-profile-activity-read",
    "allow-load-profile-quota",
    "allow-load-profile-quota-history",
    "allow-load-profile-refresh-status",
    "allow-review-profile-quota-association",
    "allow-begin-profile-quota-reassociation",
    "allow-begin-profile-quota-read",
    "allow-complete-profile-quota-read",
    "allow-cancel-profile-quota-read",
    "allow-begin-profile-collection-read",
    "allow-complete-profile-collection-read",
    "allow-cancel-profile-collection-read",
    "allow-review-profile-collection-association",
    "allow-begin-profile-collection-reassociation"
  ]
}
