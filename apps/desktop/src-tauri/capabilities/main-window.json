{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The bundled main window can manage encrypted storage, native profiles, themes, and encrypted backups.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-bootstrap",
    "allow-setup-workspace",
    "allow-unlock-workspace",
    "allow-set-theme",
    "allow-create-backup",
    "allow-list-profiles",
    "allow-create-profile",
    "allow-rename-profile",
    "allow-set-profile-archived",
    "allow-list-backups",
    "allow-inspect-backup",
    "allow-prepare-restore-preview",
    "allow-cancel-restore-preview",
    "allow-apply-restore",
    "allow-list-restore-checkpoints",
    "allow-prepare-checkpoint-restore-preview",
    "allow-inspect-provider-executable",
    "allow-approve-provider-executable",
    "allow-check-profile-connection",
    "allow-cancel-profile-check",
    "allow-begin-profile-login",
    "allow-await-profile-login-prompt",
    "allow-complete-profile-login",
    "allow-cancel-profile-login"
  ]
}
