{
  "name": "openusage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:native": "bun run build && cargo run -p openusage-desktop",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "build:native": "bun run build && cargo build --release -p openusage-desktop",
    "prepare:companion": "python3 scripts/provision-companion.py",
    "typecheck": "tsc --noEmit",
    "test:contract": "node tests/contract/bootstrap.test.mjs",
    "test:renderer": "playwright test",
    "test:native": "node tests/native/smoke.mjs",
    "test:native:storage": "node tests/native/persistence.mjs",
    "test:native:backup": "node tests/native/backup.mjs",
    "check": "bun run build && bun run test:contract && bun run test:renderer"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-activity-calendar": "3.2.1",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "trustedDependencies": []
}
