{
  "name": "openusage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": "22.23.2" },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:contract": "node tests/contract/bootstrap.test.mjs",
    "test:renderer": "playwright test",
    "check": "npm run build && npm run test:contract && npm run test:renderer"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
